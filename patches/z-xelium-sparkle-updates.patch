+void EnsureSparkleInitialized() {
+  static dispatch_once_t token;
+  dispatch_once(&token, ^{
+    NSBundle* hostBundle = [NSBundle mainBundle];
+    SparkleObserver* observer =
+        [[SparkleObserver alloc] initWithProfile:nullptr];
+    SparkleDriver* driver = [[SparkleDriver alloc] initWithObserver:observer];
+
+    VersionUpdaterSparkle::sparkle_observer_ = observer;
+    VersionUpdaterSparkle::sparkle_updater_ = [[SPUUpdater alloc]
+                                              initWithHostBundle:hostBundle
+                                              applicationBundle:hostBundle
+                                              userDriver:driver
+                                              delegate:observer];
+  });
+}
+
+bool AutomaticUpdateChecksEnabled() {
+  NSNumber* value = [[NSUserDefaults standardUserDefaults]
+      objectForKey:@"SUEnableAutomaticChecks"];
+  return value ? [value boolValue] : true;
+}
+
+void SetAutomaticUpdateChecks(bool enabled) {
+  [[NSUserDefaults standardUserDefaults] setBool:enabled
+                                          forKey:@"SUEnableAutomaticChecks"];
+
+  InitializeSparkleFramework();
+  SPUUpdater* updater = VersionUpdaterSparkle::sparkle_updater_;
+  if (updater) {
+    updater.automaticallyChecksForUpdates = enabled;
+  }
+}
