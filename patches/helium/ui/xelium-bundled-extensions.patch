+# Copyright 2026 The Xelium Authors
+# You can use, redistribute, and/or modify this source code under the
+# terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+import("//tools/grit/grit_rule.gni")
+
+# Packs an unpacked extension payload (downloaded into third_party/) into a
+# .pak that is served through ChromeComponentExtensionResourceManager, the same
+# way uBlock Origin is bundled.
+#
+# Invoker variables:
+#   source_dir:  GN path to the extension payload directory.
+#   excludes:    File patterns (relative to source_dir) that must not be
+#                shipped inside the browser.
+template("xelium_extension_resources") {
+  _prefix = target_name
+  _grd = "$target_gen_dir/${_prefix}_resources.grd"
+
+  action("${_prefix}_grd") {
+    script = "generate_grd.py"
+
+    _args = [
+      "--source-dir",
+      rebase_path(invoker.source_dir, root_build_dir),
+      "--out-grd",
+      rebase_path(_grd, root_build_dir),
+      "--root-gen-dir",
+      rebase_path(root_gen_dir, root_build_dir),
+      "--prefix",
+      _prefix,
+      "--resource-path-prefix",
+      _prefix,
+    ]
+    foreach(_exclude, invoker.excludes) {
+      _args += [
+        "--exclude",
+        _exclude,
+      ]
+    }
+
+    args = _args
+    inputs = [ "generate_grd.py" ] + invoker.watched_files
+    outputs = [ _grd ]
+  }
+
+  grit("${_prefix}_pak") {
+    source = _grd
+
+    # Required because the .grd is generated.
+    enable_input_discovery_for_gn_analyze = false
+    use_brotli = true
+
+    output_dir = "$target_gen_dir/resources"
+
+    outputs = [
+      "grit/${_prefix}_resources.h",
+      "grit/${_prefix}_resources_map.cc",
+      "grit/${_prefix}_resources_map.h",
+      "${_prefix}_resources.pak",
+    ]
+
+    deps = [ ":${_prefix}_grd" ]
+  }
+}
+
+xelium_extension_resources("diapeek") {
+  source_dir = "//third_party/diapeek"
+  watched_files = [ "//third_party/diapeek/manifest.json" ]
+
+  excludes = [
+    ".claude/*",
+    ".DS_Store",
+    ".gitattributes",
+    "*.md",
+    "README.chromium",
+    "dist/*",
+  ]
+}
