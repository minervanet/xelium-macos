@@ -0,0 +1,115 @@
+# Copyright 2026 The Xelium Authors
+# You can use, redistribute, and/or modify this source code under the
+# terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+"""Generates a grit .grd file that packs an unpacked extension payload.
+
+Unlike ui/webui/resources/tools/generate_grd.py this script packs every file as
+raw BINDATA, which is what extension runtime assets need (no HTML/JS
+preprocessing).
+"""
+
+import argparse
+import os
+import re
+import sys
+import xml.etree.ElementTree as ET
+
+GRD_BEGIN_TEMPLATE = (
+    '<?xml version="1.0" encoding="UTF-8"?>\n'
+    '<grit latest_public_release="0" current_release="1">\n'
+    '  <outputs>\n'
+    '    <output filename="{out_dir}/{prefix}_resources.h" '
+    'type="rc_header">\n'
+    "      <emit emit_type='prepend'></emit>\n"
+    '    </output>\n'
+    '    <output filename="{out_dir}/{prefix}_resources_map.cc"\n'
+    '            type="resource_file_map_source" />\n'
+    '    <output filename="{out_dir}/{prefix}_resources_map.h"\n'
+    '            type="resource_map_header" />\n'
+    '    <output filename="{prefix}_resources.pak" '
+    'type="data_package" />\n'
+    '  </outputs>\n'
+    '  <release seq="1">\n'
+    '    <includes>\n'
+)
+
+GRD_INCLUDE_TEMPLATE = (
+    '      <include name="{name}" '
+    'file="{file}" resource_path="{path}" '
+    'use_base_dir="false" type="BINDATA" />\n'
+)
+
+GRD_END_TEMPLATE = '    </includes>\n  </release>\n</grit>\n'
+
+
+def collect_files(source_dir, excludes):
+    """Returns the sorted list of extension files relative to `source_dir`."""
+    from fnmatch import fnmatchcase
+
+    files = []
+    for root, dirs, filenames in os.walk(source_dir):
+        dirs.sort()
+        for filename in sorted(filenames):
+            path = os.path.join(root, filename)
+            relative = os.path.relpath(path, source_dir).replace(os.sep, '/')
+            if any(fnmatchcase(relative, pattern) for pattern in excludes):
+                continue
+            files.append(relative)
+    return sorted(files)
+
+
+def resource_name(prefix, filename, used):
+    """Builds a unique IDR_ name for `filename`."""
+    suffix = re.sub(r'[^A-Za-z0-9]', '_', filename).upper()
+    name = 'IDR_%s_%s' % (prefix.upper(), suffix)
+    candidate = name
+    index = 2
+    while candidate in used:
+        candidate = '%s_%d' % (name, index)
+        index += 1
+    used.add(candidate)
+    return candidate
+
+
+def main(argv):
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--source-dir', required=True)
+    parser.add_argument('--out-grd', required=True)
+    parser.add_argument('--root-gen-dir', required=True)
+    parser.add_argument('--prefix', required=True)
+    parser.add_argument('--resource-path-prefix', required=True)
+    parser.add_argument('--output-files-base-dir', default='grit')
+    parser.add_argument('--exclude', action='append', default=[])
+    args = parser.parse_args(argv)
+
+    cwd = os.getcwd()
+    source_dir = os.path.normpath(os.path.join(cwd, args.source_dir))
+    root_gen_dir = args.root_gen_dir.replace('\\', '/')
+    files = collect_files(source_dir, args.exclude)
+
+    grd_path = os.path.normpath(os.path.join(cwd, args.out_grd))
+    os.makedirs(os.path.dirname(grd_path), exist_ok=True)
+
+    used = set()
+    with open(grd_path, 'w', newline='', encoding='utf-8') as grd_file:
+        grd_file.write(
+            GRD_BEGIN_TEMPLATE.format(
+                prefix=args.prefix, out_dir=args.output_files_base_dir))
+        for filename in files:
+            filepath = os.path.join(source_dir, filename)
+            rebased = os.path.relpath(filepath, os.path.join(cwd,
+                                                             root_gen_dir))
+            rebased = rebased.replace('\\', '/')
+            resource_path = args.resource_path_prefix + '/' + filename
+            grd_file.write(
+                GRD_INCLUDE_TEMPLATE.format(
+                    name=resource_name(args.prefix, filename, used),
+                    file='${root_gen_dir}/' + rebased,
+                    path=resource_path))
+        grd_file.write(GRD_END_TEMPLATE)
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main(sys.argv[1:]))
