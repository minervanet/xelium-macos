+void ContentsContainerView::SetVerticalTabStripAttachment(
+    bool leading_attached,
+    bool trailing_attached) {
+  if (leading_vertical_tab_strip_attached_ == leading_attached &&
+      trailing_vertical_tab_strip_attached_ == trailing_attached) {
+    return;
+  }
+  leading_vertical_tab_strip_attached_ = leading_attached;
+  trailing_vertical_tab_strip_attached_ = trailing_attached;
+  if (!should_round_contents_) {
+    return;
+  }
+  UpdateContentsBorder();
+  UpdateBorderRoundedCorners();
+}
+
+void ContentsContainerView::SetTopChromeAttachment(bool top_attached) {
+  if (top_chrome_attached_ == top_attached) {
+    return;
+  }
+  top_chrome_attached_ = top_attached;
+  if (!should_round_contents_) {
+    return;
+  }
+  UpdateContentsBorder();
+  UpdateBorderRoundedCorners();
+}
+
+void ContentsContainerView::UpdateContentsBorder() {
+  if (!should_round_contents_) {
+    SetBorder(nullptr);
+    return;
+  }
+
+  const int frame_thickness = ContentsContainerOutline::GetThickness(false);
+  if (is_in_split_) {
+    SetBorder(views::CreateEmptyBorder(
+        gfx::Insets(kSplitViewContentPadding + frame_thickness)));
+    return;
+  }
+
+  gfx::Insets insets(frame_thickness);
+  if (leading_vertical_tab_strip_attached_) {
+    insets.set_left(0);
+  }
+  if (trailing_vertical_tab_strip_attached_) {
+    insets.set_right(0);
+  }
+  if (top_chrome_attached_) {
+    insets.set_top(0);
+  }
+  SetBorder(views::CreateEmptyBorder(insets));
+}
