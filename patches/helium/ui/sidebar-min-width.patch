+constexpr int kToolbarControlRowSpacing = 4;
+
+struct ToolbarControl {
+  views::View* view;
+  gfx::Size size;
+  gfx::Insets margin;
+};
+
+int ControlWidth(const ToolbarControl& control) {
+  return control.size.width() + control.margin.width();
+}
+
+int ControlHeight(const ToolbarControl& control) {
+  return control.size.height() + control.margin.height();
+}
+
+int ComputeToolbarControlLayout(views::View* container,
+                                views::View* spacer,
+                                int width,
+                                std::vector<gfx::Rect>* bounds) {
+  width = std::max(width, 1);
+  std::vector<ToolbarControl> leading;
+  std::vector<ToolbarControl> trailing;
+  bool after_spacer = false;
+  for (views::View* child : container->children()) {
+    if (child == spacer) {
+      after_spacer = true;
+      continue;
+    }
+    if (!child->GetVisible()) {
+      continue;
+    }
+    const auto* margin = child->GetProperty(views::kMarginsKey);
+    (after_spacer ? trailing : leading)
+        .push_back({child, child->GetPreferredSize(),
+                    margin ? *margin : gfx::Insets()});
+  }
+  if (leading.empty() && trailing.empty()) {
+    return 0;
+  }
+
+  int row_height = GetLayoutConstant(LayoutConstant::kToolbarButtonHeight);
+  for (const auto& control : leading) {
+    row_height = std::max(row_height, ControlHeight(control));
+  }
+  for (const auto& control : trailing) {
+    row_height = std::max(row_height, ControlHeight(control));
+  }
+
+  int leading_width = 0;
+  for (const auto& control : leading) {
+    leading_width += ControlWidth(control);
+  }
+  int trailing_width = 0;
+  for (const auto& control : trailing) {
+    trailing_width += ControlWidth(control);
+  }
+
+  std::vector<gfx::Rect> result;
+  result.reserve(leading.size() + trailing.size());
+  auto append = [&](const ToolbarControl& control, int x, int y) {
+    result.emplace_back(
+        x + control.margin.left(),
+        y + (row_height - ControlHeight(control)) / 2 + control.margin.top(),
+        std::min(control.size.width(),
+                 std::max(0, width - control.margin.width())),
+        control.size.height());
+  };
+
+  int height = row_height;
+  if (leading_width + trailing_width <= width) {
+    int x = 0;
+    for (const auto& control : leading) {
+      append(control, x, 0);
+      x += ControlWidth(control);
+    }
+    int trailing_x = std::max(width - trailing_width, x);
+    for (const auto& control : trailing) {
+      append(control, trailing_x, 0);
+      trailing_x += ControlWidth(control);
+    }
+  } else {
+    int x = 0;
+    int y = 0;
+    auto place = [&](const ToolbarControl& control) {
+      const int child_width = std::min(ControlWidth(control), width);
+      if (x > 0 && x + child_width > width) {
+        x = 0;
+        y += row_height + kToolbarControlRowSpacing;
+      }
+      append(control, x, y);
+      x += child_width;
+    };
+    for (const auto& control : leading) {
+      place(control);
+    }
+    for (const auto& control : trailing) {
+      place(control);
+    }
+    height = y + row_height;
+  }
+
+  if (bounds) {
+    *bounds = std::move(result);
+  }
+  return height;
+}
+
