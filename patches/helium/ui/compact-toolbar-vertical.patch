+#ifndef CHROME_BROWSER_UI_HELIUM_HELIUM_TOOLBAR_LAYOUT_H_
+#define CHROME_BROWSER_UI_HELIUM_HELIUM_TOOLBAR_LAYOUT_H_
+
+#include <atomic>
+
+namespace helium {
+
+// Layout constants are process-wide and cannot reach the Browser, so the
+// Helium layout controller mirrors its vertical-layout state here. This only
+// affects toolbar button metrics; the omnibox always keeps its density.
+namespace internal {
+inline std::atomic<bool>& VerticalToolbarLayoutActive() {
+  static std::atomic<bool> active{false};
+  return active;
+}
+}  // namespace internal
+
+inline bool IsVerticalToolbarLayoutActive() {
+  return internal::VerticalToolbarLayoutActive().load(
+      std::memory_order_relaxed);
+}
+
+inline void SetVerticalToolbarLayoutActive(bool active) {
+  internal::VerticalToolbarLayoutActive().store(active,
+                                                std::memory_order_relaxed);
+}
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_HELIUM_TOOLBAR_LAYOUT_H_
