+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_HELIUM_COMMAND_BAR_VIEW_H_
+#define CHROME_BROWSER_UI_HELIUM_HELIUM_COMMAND_BAR_VIEW_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/functional/callback_forward.h"
+#include "base/memory/raw_ptr.h"
+#include "ui/views/controls/textfield/textfield_controller.h"
+#include "ui/views/widget/widget_delegate.h"
+
+namespace gfx {
+class Rect;
+}
+
+namespace views {
+class Textfield;
+class Widget;
+}  // namespace views
+
+// Floating command bar popup: a single text field with a results list below.
+// Skeleton: the field is live and closable; result rows arrive next.
+class HeliumCommandBarView : public views::WidgetDelegate,
+                             public views::TextfieldController {
+ public:
+  // Creates, shows and focuses the popup parented to |parent|. |on_closed|
+  // runs when the widget begins closing. Returns the owning widget
+  // (deleted on close).
+  static views::Widget* Show(gfx::NativeView parent,
+                               base::OnceClosure on_closed);
+
+  HeliumCommandBarView(const HeliumCommandBarView&) = delete;
+  HeliumCommandBarView& operator=(const HeliumCommandBarView&) = delete;
+  ~HeliumCommandBarView() override;
+
+  void Close();
+
+  // views::TextfieldController:
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string& new_contents) override;
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& event) override;
+
+ private:
+  explicit HeliumCommandBarView(gfx::NativeView parent,
+                                base::OnceClosure on_closed);
+
+  void WindowClosing() override;
+
+  base::OnceClosure on_closed_;
+  raw_ptr<views::Textfield> input_ = nullptr;
+};
+
+#endif  // CHROME_BROWSER_UI_HELIUM_HELIUM_COMMAND_BAR_VIEW_H_

