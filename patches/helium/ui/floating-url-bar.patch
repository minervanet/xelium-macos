+#ifndef CHROME_BROWSER_UI_HELIUM_HELIUM_COMMAND_BAR_VIEW_H_
+#define CHROME_BROWSER_UI_HELIUM_HELIUM_COMMAND_BAR_VIEW_H_
+
+#include <stddef.h>
+
+#include <vector>
+
+#include "base/functional/callback_forward.h"
