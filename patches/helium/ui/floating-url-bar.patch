+// static
+HeliumCommandBarController* HeliumCommandBarController::From(
+    BrowserWindowInterface* browser) {
+  if (!browser) {
+    return nullptr;
+  }
+  return HeliumCommandBarController::Get(browser->GetUnownedUserDataHost());
+}
+
+HeliumCommandBarController::HeliumCommandBarController(
+    BrowserWindowInterface* browser)
+    : browser_(browser),
+      scoped_unowned_user_data_(browser->GetUnownedUserDataHost(), *this) {}
+
+HeliumCommandBarController::~HeliumCommandBarController() {
+  if (focus_manager_) {
+    focus_manager_->RemoveFocusChangeListener(this);
+    focus_manager_->UnregisterAccelerators(this);
+    focus_manager_ = nullptr;
+  }
+}
+
+void HeliumCommandBarController::Toggle(
+    gfx::NativeView parent,
+    const std::u16string& initial_query) {
+  if (IsShowing()) {
+    Hide();
+  } else {
+    Show(parent, initial_query);
+  }
+}
+
+void HeliumCommandBarController::Show(gfx::NativeView parent,
+                                      const std::u16string& initial_query) {
+  if (widget_) {
+    widget_->Activate();
+    return;
+  }
+  HeliumCommandBarView* view = HeliumCommandBarView::Show(
+      parent, initial_query,
+      base::BindOnce(&HeliumCommandBarController::OnWidgetClosed,
+                     weak_factory_.GetWeakPtr()),
+      base::BindRepeating(&HeliumCommandBarController::OnQueryChanged,
+                          weak_factory_.GetWeakPtr()),
+      base::BindRepeating(&HeliumCommandBarController::ActivateItem,
+                          weak_factory_.GetWeakPtr()),
+      base::BindRepeating(&HeliumCommandBarController::OnTabPressed,
+                          weak_factory_.GetWeakPtr()),
+      base::BindRepeating(&HeliumCommandBarController::OnEscapePressed,
+                          weak_factory_.GetWeakPtr()));
+  widget_ = view->GetWidget();
+  view_ = view;
+  // Populate from the initial query (empty for Cmd+T, page URL for Cmd+L).
+  OnQueryChanged(initial_query);
+}
+
+void HeliumCommandBarController::Hide() {
+  if (!widget_) {
+    return;
+  }
+  // Null first: closing runs WindowClosing synchronously, which would
+  // otherwise re-enter and double-close.
+  views::Widget* widget = widget_;
+  widget_ = nullptr;
+  widget->Close();
+}
+
+bool HeliumCommandBarController::IsShowing() const {
+  return widget_ != nullptr;
+}
+
+base::WeakPtr<HeliumCommandBarController>
+HeliumCommandBarController::GetWeakPtr() {
+  return weak_factory_.GetWeakPtr();
+}
+
+void HeliumCommandBarController::RegisterAccelerators(
+    views::FocusManager* focus_manager) {
+  if (!focus_manager || focus_manager == focus_manager_) {
+    return;
+  }
+  focus_manager_ = focus_manager;
+  // Track manager lifetime: it dies before this controller on shutdown.
+  focus_manager_->AddFocusChangeListener(this);
+  for (const ui::KeyboardCode key : {ui::VKEY_T, ui::VKEY_L}) {
+    focus_manager_->RegisterAccelerator(
+        ui::Accelerator(key, ui::EF_PLATFORM_ACCELERATOR),
+        ui::AcceleratorManager::kHighPriority, this);
+  }
+}
+
+void HeliumCommandBarController::OnFocusManagerDestroying(
+    views::FocusManager* focus_manager) {
+  if (focus_manager == focus_manager_) {
+    // Manager is dying; its AcceleratorManager dies with it, so there is
+    // nothing left to unregister from. Just drop the pointer.
+    focus_manager_ = nullptr;
+  }
+}
+
+bool HeliumCommandBarController::AcceleratorPressed(
+    const ui::Accelerator& accelerator) {
+  if ((accelerator.key_code() != ui::VKEY_T &&
+       accelerator.key_code() != ui::VKEY_L) ||
+      accelerator.modifiers() != ui::EF_PLATFORM_ACCELERATOR) {
+    return false;
+  }
+  if (!browser_->GetProfile()->GetPrefs()->GetBoolean(
+          prefs::kHeliumCommandBarEnabled)) {
+    return false;
+  }
+  // Swallow repeats while open; Esc closes.
+  if (IsShowing()) {
+    return true;
+  }
+  TabStripModel* tab_strip = browser_->GetTabStripModel();
+  content::WebContents* contents =
+      tab_strip ? tab_strip->GetActiveWebContents() : nullptr;
+  if (!contents) {
+    return false;
+  }
+  std::u16string initial;
+  if (accelerator.key_code() == ui::VKEY_L) {
+    initial = base::UTF8ToUTF16(contents->GetVisibleURL().spec());
+  }
+  Toggle(contents->GetNativeView(), initial);
+  return true;
+}
+
+bool HeliumCommandBarController::CanHandleAccelerators() const {
+  return true;
+}
+
+void HeliumCommandBarController::OnQueryChanged(const std::u16string& query) {
+  last_query_ = query;
+  CmdBarTrace("query len=" + std::to_string(query.size()));
+  if (query.empty()) {
+    last_history_rows_ = history::QueryResults();
+  }
+  // Paint immediately from the synchronous sources plus the previous
+  // keystroke's history rows re-scored for this query. Without the
+  // carryover, every keystroke flashes twice: once when history rows drop
+  // out, once when the fresh query returns.
+  PushItems(CollectResults(
+      query, last_history_rows_.empty() ? nullptr : &last_history_rows_));
+
+  // History is async. Sequence-guard so a slow query from an older keystroke
+  // can never overwrite newer results.
+  history_tracker_.TryCancelAll();
+  if (query.empty()) {
+    return;
+  }
+  history::HistoryService* history = HistoryServiceFactory::GetForProfile(
+      browser_->GetProfile(), ServiceAccessType::EXPLICIT_ACCESS);
+  if (!history) {
+    return;
+  }
+  const int seq = ++history_seq_;
+  history::QueryOptions options;
+  options.max_count = 30;
+  history->QueryHistory(
+      query, options,
+      base::BindOnce(&HeliumCommandBarController::OnHistoryResults,
+                     weak_factory_.GetWeakPtr(), seq, query),
+      &history_tracker_);
+}
+
+void HeliumCommandBarController::OnHistoryResults(
+    int seq,
+    const std::u16string& query,
+    history::QueryResults results) {
+  if (seq != history_seq_ || query != last_query_ || !view_) {
+    return;
+  }
+  last_history_rows_ = std::move(results);
+  CmdBarTrace("hist rows=" + std::to_string(last_history_rows_.size()));
+  PushItems(CollectResults(query, &last_history_rows_));
+}
+
+void HeliumCommandBarController::PushItems(
+    std::vector<HeliumCommandBarItem> items) {
+  const bool same = SameItems(items_, items);
+  std::string sig = "push n=" + std::to_string(items.size()) +
+                    " same=" + (same ? "1" : "0") + " [";
+  for (const auto& it : items) {
+    sig += ItemSig(it) + " ";
+  }
+  CmdBarTrace(sig + "]");
+  items_ = std::move(items);
+  if (!same) {
+    // Bumped only on real change: in-flight favicon callbacks carry the
+    // sequence they started with, and identical rebuilds must not orphan
+    // icons that are still on their way.
+    ++items_seq_;
+  }
+  scope_hint_index_.reset();
+  for (size_t i = 0; i < items_.size(); ++i) {
+    if (items_[i].type == HeliumCommandBarItem::Type::kSiteSearch) {
+      scope_hint_index_ = i;
+      break;
+    }
+  }
+  if (view_) {
+    if (!same) {
+      view_->SetResults(items_, scope_hint_index_);
+    }
+    if (scope_keyword_.empty()) {
+      view_->ClearScope();
+    } else {
+      view_->SetScope(helium_command_bar_model::SiteScopeName(
+          TemplateURLServiceFactory::GetForProfile(browser_->GetProfile()),
+          scope_keyword_));
+    }
+  }
+  if (!same) {
+    FetchFavicons();
+  }
+}
+
+void HeliumCommandBarController::FetchFavicons() {
+  CmdBarTrace("favicons for n=" + std::to_string(items_.size()));
+  favicon::FaviconService* favicons = FaviconServiceFactory::GetForProfile(
+      browser_->GetProfile(), ServiceAccessType::EXPLICIT_ACCESS);
+  if (!favicons) {
+    return;
+  }
+  const int seq = items_seq_;
+  for (size_t i = 0; i < items_.size(); ++i) {
+    const GURL& page_url = items_[i].url;
+    const GURL& icon_url =
+        items_[i].icon_url.is_valid() ? items_[i].icon_url : page_url;
+    if (!icon_url.SchemeIsHTTPOrHTTPS()) {
+      continue;
+    }
+    const std::string spec = icon_url.spec();
+    auto cached = favicon_cache_.find(spec);
+    if (cached != favicon_cache_.end() && view_) {
+      view_->SetItemImage(i, cached->second);
+      continue;
+    }
+    favicons->GetFaviconImageForPageURL(
+        icon_url,
+        base::BindOnce(&HeliumCommandBarController::OnFavicon,
+                       weak_factory_.GetWeakPtr(), seq, i, spec),
+        &favicon_tracker_);
+  }
+}
+
+void HeliumCommandBarController::OnTabPressed() {
+  if (!view_) {
+    return;
+  }
+  if (scope_hint_index_.has_value()) {
+    ActivateItem(*scope_hint_index_);
+    return;
+  }
+  view_->CompleteSelection();
+}
+
+void HeliumCommandBarController::OnEscapePressed() {
+  if (!scope_keyword_.empty()) {
+    ExitScope();
+    return;
+  }
+  HideSoon();
+}
+
+// Closing the widget synchronously from inside a textfield key handler or
+// a row mouse-press destroys views that are still on the dispatch stack.
+// Activate/Escape arrive from exactly those paths, so they defer the close
+// to the next task instead. Toggle() keeps the synchronous Hide: accelerators
+// dispatch through the FocusManager, which only holds this controller.
+void HeliumCommandBarController::HideSoon() {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&HeliumCommandBarController::Hide,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void HeliumCommandBarController::ExitScope() {
+  scope_keyword_.clear();
+  // Rebuild from the full text; the scope bar hides via PushItems.
+  OnQueryChanged(last_query_);
+}
+
+std::vector<HeliumCommandBarItem> HeliumCommandBarController::CollectResults(
+    const std::u16string& query,
+    const history::QueryResults* history_rows) {
+  using namespace helium_command_bar_model;
+  std::vector<HeliumCommandBarItem> items;
+  if (!scope_keyword_.empty()) {
+    // Scoped: the engine search row (or tabs only), plus matching tabs,
+    // bookmarks and history. Everything else stays out of the way.
+    const std::u16string remainder = ScopeRemainder(query);
+    TemplateURLService* template_urls =
+        TemplateURLServiceFactory::GetForProfile(browser_->GetProfile());
+    // Tabs-only exactly when nothing owns the scope keyword (i.e. the
+    // built-in "tab" scope with no user engine under that name).
+    const bool tabs_only =
+        !EngineOwnsKeyword(template_urls, scope_keyword_);
+    if (!tabs_only) {
+      if (auto row = SiteSearchHintForQuery(template_urls, scope_keyword_,
+                                            remainder)) {
+        items.push_back(std::move(*row));
+      }
+    }
+    auto tabs = TabsForQuery(browser_->GetTabStripModel(), remainder);
+    items.insert(items.end(), std::make_move_iterator(tabs.begin()),
+                 std::make_move_iterator(tabs.end()));
+    if (!tabs_only) {
+      bookmarks::BookmarkModel* bookmarks =
+          BookmarkModelFactory::GetForBrowserContext(browser_->GetProfile());
+      auto bookmark_items = BookmarksForQuery(bookmarks, remainder);
+      items.insert(items.end(),
+                   std::make_move_iterator(bookmark_items.begin()),
+                   std::make_move_iterator(bookmark_items.end()));
+      if (history_rows) {
+        auto history_items = HistoryItemsForRows(*history_rows, remainder);
+        items.insert(items.end(),
+                     std::make_move_iterator(history_items.begin()),
+                     std::make_move_iterator(history_items.end()));
+      }
+    }
+    SortAndCap(items);
+    return items;
+  }
+
+  auto tabs = TabsForQuery(browser_->GetTabStripModel(), query);
+  items.insert(items.end(), std::make_move_iterator(tabs.begin()),
+               std::make_move_iterator(tabs.end()));
+  bookmarks::BookmarkModel* bookmarks =
+      BookmarkModelFactory::GetForBrowserContext(browser_->GetProfile());
+  auto bookmark_items = BookmarksForQuery(bookmarks, query);
+  items.insert(items.end(), std::make_move_iterator(bookmark_items.begin()),
+               std::make_move_iterator(bookmark_items.end()));
+  auto command_items = CommandsForQuery(query);
+  items.insert(items.end(), std::make_move_iterator(command_items.begin()),
+               std::make_move_iterator(command_items.end()));
+  if (history_rows) {
+    auto history_items = HistoryItemsForRows(*history_rows, query);
+    items.insert(items.end(), std::make_move_iterator(history_items.begin()),
+                 std::make_move_iterator(history_items.end()));
+  }
+  if (auto direct = UrlOrSearchForQuery(browser_->GetProfile(), query)) {
+    items.push_back(std::move(*direct));
+  }
+  if (auto split = SplitKeyword(query, /*require_remainder=*/false)) {
+    if (!split->keyword.empty()) {
+      TemplateURLService* template_urls =
+          TemplateURLServiceFactory::GetForProfile(browser_->GetProfile());
+      if (auto hint = SiteSearchHintForQuery(template_urls, split->keyword,
+                                             split->remainder)) {
+        items.push_back(std::move(*hint));
+      } else if (split->keyword == "tab" &&
+                 !EngineOwnsKeyword(template_urls, "tab")) {
+        items.push_back(TabsScopeHint(split->remainder));
+      }
+    }
+  }
+  SortAndCap(items);
+  return items;
+}
+
+std::u16string HeliumCommandBarController::ScopeRemainder(
+    const std::u16string& query) const {
+  auto split = helium_command_bar_model::SplitKeyword(query, false);
+  if (!split || split->keyword != scope_keyword_) {
+    // Scope entered another way, or the prefix was edited away: match on the
+    // whole query rather than going blank.
+    return query;
+  }
+  return split->remainder;
+}
+
+void HeliumCommandBarController::OnFavicon(
+    int seq,
+    size_t index,
+    const std::string& url_spec,
+    const favicon_base::FaviconImageResult& result) {
+  if (result.image.IsEmpty()) {
+    return;
+  }
+  favicon_cache_[url_spec] = result.image;
+  if (seq != items_seq_ || !view_ || index >= items_.size()) {
+    return;
+  }
+  view_->SetItemImage(index, result.image);
+}
+
+void HeliumCommandBarController::ActivateItem(size_t index) {
+  CmdBarTrace("activate i=" + std::to_string(index));
+  if (index >= items_.size()) {
+    return;
+  }
+  const HeliumCommandBarItem item = items_[index];
+  if (item.type == HeliumCommandBarItem::Type::kTab) {
+    TabStripModel* tab_strip = browser_->GetTabStripModel();
+    if (tab_strip && item.tab_index >= 0 &&
+        item.tab_index < tab_strip->count()) {
+      tab_strip->ActivateTabAt(item.tab_index);
+    }
+    HideSoon();
+    return;
+  }
+  GURL url;
+  switch (item.type) {
+    case HeliumCommandBarItem::Type::kTab:
+      break;  // Handled above.
+    case HeliumCommandBarItem::Type::kSiteSearch: {
+      // First activation enters the scope; inside the scope it navigates.
+      const bool already_in_scope =
+          !scope_keyword_.empty() && scope_keyword_ == item.site_keyword;
+      if (!already_in_scope && !item.site_keyword.empty()) {
+        scope_keyword_ = item.site_keyword;
+        if (view_) {
+          view_->SetScope(helium_command_bar_model::SiteScopeName(
+              TemplateURLServiceFactory::GetForProfile(browser_->GetProfile()),
+              scope_keyword_));
+        }
+        OnQueryChanged(last_query_);
+        return;
+      }
+      if (auto search_url = helium_command_bar_model::BuildSiteSearchUrl(
+              TemplateURLServiceFactory::GetForProfile(browser_->GetProfile()),
+              item.site_keyword, ScopeRemainder(last_query_))) {
+        url = *search_url;
+      }
+      break;
+    }
+    case HeliumCommandBarItem::Type::kCommand:
+      switch (item.command) {
+        case HeliumCommandBarItem::Command::kNewTab:
+          url = GURL("chrome://newtab/");
+          break;
+        case HeliumCommandBarItem::Command::kOpenSettings:
+          url = GURL("chrome://settings");
+          break;
+        case HeliumCommandBarItem::Command::kOpenHistory:
+          url = GURL("chrome://history");
+          break;
+        case HeliumCommandBarItem::Command::kOpenDownloads:
+          url = GURL("chrome://downloads");
+          break;
+        case HeliumCommandBarItem::Command::kCopyUrl: {
+          TabStripModel* tab_strip = browser_->GetTabStripModel();
+          content::WebContents* contents =
+              tab_strip ? tab_strip->GetActiveWebContents() : nullptr;
+          if (contents) {
+            ui::ScopedClipboardWriter writer(ui::ClipboardBuffer::kCopyPaste);
+            writer.WriteText(base::UTF8ToUTF16(contents->GetVisibleURL().spec()));
+          }
+          HideSoon();
+          return;
+        }
+      }
+      break;
+    case HeliumCommandBarItem::Type::kBookmark:
+    case HeliumCommandBarItem::Type::kHistory:
+    case HeliumCommandBarItem::Type::kUrl:
+    case HeliumCommandBarItem::Type::kSearch:
+      url = item.url;
+      break;
+  }
+  if (url.is_valid()) {
+    NavigateParams params(browser_, url, ui::PAGE_TRANSITION_TYPED);
+    params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+    // On the new tab page there is nothing to keep: navigate in place
+    // instead of stacking another tab, no matter the Cmd+T/Cmd+L entry.
+    TabStripModel* tab_strip = browser_->GetTabStripModel();
+    content::WebContents* contents =
+        tab_strip ? tab_strip->GetActiveWebContents() : nullptr;
+    if (contents && IsNewTabUrl(contents->GetVisibleURL())) {
+      params.disposition = WindowOpenDisposition::CURRENT_TAB;
+    }
+    Navigate(&params);
+  }
+  HideSoon();
+}

