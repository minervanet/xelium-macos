+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/helium_command_bar_model.h"
+
+#include <algorithm>
+
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/search_engines/template_url_service_factory.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/bookmarks/browser/bookmark_model.h"
+#include "components/bookmarks/browser/bookmark_node.h"
+#include "components/bookmarks/browser/bookmark_utils.h"
+#include "components/history/core/browser/history_types.h"
+#include "components/search_engines/template_url.h"
+#include "components/search_engines/template_url_service.h"
+#include "content/public/browser/web_contents.h"
+
+namespace helium_command_bar_model {
+namespace {
+
+// Score bands. Prefix beats word-boundary beats substring, mirroring Lumno's
+// exact > prefix > word ordering at a smaller scale.
+constexpr int kScoreExact = 140;
+constexpr int kScorePrefix = 70;
+constexpr int kScoreWord = 45;
+constexpr int kScoreSubstring = 20;
+constexpr int kScoreTabBoost = 10;
+
+bool IsWordBoundary(char16_t c) {
+  return c == u' ' || c == u'/' || c == u'.' || c == u'-' || c == u'_' ||
+         c == u':' || c == u'?' || c == u'&' || c == u'=' || c == u'#';
+}
+
+}  // namespace
+
+int ScoreText(const std::u16string& text, const std::u16string& query) {
+  if (query.empty() || text.size() < query.size()) {
+    return 0;
+  }
+  if (text == query) {
+    return kScoreExact;
+  }
+  if (text.starts_with(query)) {
+    return kScorePrefix;
+  }
+  size_t pos = text.find(query);
+  if (pos == std::u16string::npos) {
+    return 0;
+  }
+  if (pos > 0 && IsWordBoundary(text[pos - 1])) {
+    return kScoreWord;
+  }
+  return kScoreSubstring;
+}
+
+std::vector<HeliumCommandBarItem> TabsForQuery(
+    TabStripModel* tab_strip,
+    const std::u16string& query) {
+  std::vector<HeliumCommandBarItem> items;
+  if (!tab_strip) {
+    return items;
+  }
+  const std::u16string q = base::ToLowerASCII(query);
+  const int active = tab_strip->active_index();
+  for (int i = 0; i < tab_strip->count(); ++i) {
+    if (i == active) {
+      continue;
+    }
+    content::WebContents* contents = tab_strip->GetWebContentsAt(i);
+    if (!contents) {
+      continue;
+    }
+    HeliumCommandBarItem item;
+    item.type = HeliumCommandBarItem::Type::kTab;
+    item.title = contents->GetTitle();
+    item.url = contents->GetURL();
+    item.url_spec = item.url.spec();
+    item.tab_index = i;
+    if (q.empty()) {
+      item.score = kScoreTabBoost;
+      items.push_back(item);
+      continue;
+    }
+    const int title_score =
+        ScoreText(base::ToLowerASCII(item.title), q);
+    const int url_score =
+        ScoreText(base::ToLowerASCII(base::UTF8ToUTF16(item.url_spec)), q);
+    item.score = std::max(title_score, url_score);
+    if (item.score > 0) {
+      item.score += kScoreTabBoost;
+      items.push_back(item);
+    }
+  }
+  return items;
+}
+
+std::vector<HeliumCommandBarItem> BookmarksForQuery(
+    bookmarks::BookmarkModel* model,
+    const std::u16string& query) {
+  std::vector<HeliumCommandBarItem> items;
+  if (!model || !model->loaded() || query.empty()) {
+    return items;
+  }
+  bookmarks::QueryFields query_fields;
+  query_fields.word_phrase_query = std::make_unique<std::u16string>(query);
+  std::vector<const bookmarks::BookmarkNode*> matches =
+      bookmarks::GetBookmarksMatchingProperties(model, query_fields,
+                                                kMaxResults);
+  for (const bookmarks::BookmarkNode* node : matches) {
+    if (!node || !node->url().SchemeIsHTTPOrHTTPS()) {
+      continue;
+    }
+    HeliumCommandBarItem item;
+    item.type = HeliumCommandBarItem::Type::kBookmark;
+    item.title = node->GetTitle();
+    item.url = node->url();
+    item.url_spec = item.url.spec();
+    item.score =
+        std::max(ScoreText(base::ToLowerASCII(item.title),
+                           base::ToLowerASCII(query)),
+                 ScoreText(base::ToLowerASCII(base::UTF8ToUTF16(item.url_spec)),
+                           base::ToLowerASCII(query)));
+    items.push_back(item);
+  }
+  return items;
+}
+
+std::vector<HeliumCommandBarItem> HistoryItemsForRows(
+    const history::QueryResults& results,
+    const std::u16string& query) {
+  std::vector<HeliumCommandBarItem> items;
+  const std::u16string q = base::ToLowerASCII(query);
+  for (const history::URLResult& row : results) {
+    HeliumCommandBarItem item;
+    item.type = HeliumCommandBarItem::Type::kHistory;
+    item.title = row.title().empty() ? base::UTF8ToUTF16(row.url().spec())
+                                     : row.title();
+    item.url = row.url();
+    item.url_spec = item.url.spec();
+    const int title_score = ScoreText(base::ToLowerASCII(item.title), q);
+    const int url_score =
+        ScoreText(base::ToLowerASCII(base::UTF8ToUTF16(item.url_spec)), q);
+    item.score = std::max(title_score, url_score);
+    if (item.score == 0) {
+      continue;
+    }
+    // Slight boost for frequently and recently visited pages.
+    item.score += std::min(row.visit_count(), 10);
+    items.push_back(item);
+  }
+  return items;
+}
+
+std::vector<HeliumCommandBarItem> CommandsForQuery(
+    const std::u16string& query) {
+  static constexpr struct {
+    const char* title;
+    HeliumCommandBarItem::Command command;
+  } kCommands[] = {
+      {"New Tab", HeliumCommandBarItem::Command::kNewTab},
+      {"Open Settings", HeliumCommandBarItem::Command::kOpenSettings},
+      {"Show History", HeliumCommandBarItem::Command::kOpenHistory},
+      {"Show Downloads", HeliumCommandBarItem::Command::kOpenDownloads},
+      {"Copy Page URL", HeliumCommandBarItem::Command::kCopyUrl},
+  };
+  std::vector<HeliumCommandBarItem> items;
+  const std::u16string q = base::ToLowerASCII(query);
+  for (const auto& entry : kCommands) {
+    std::u16string title = base::UTF8ToUTF16(entry.title);
+    int score = q.empty() ? 0
+                          : ScoreText(base::ToLowerASCII(title), q);
+    if (q.empty() || score == 0) {
+      continue;
+    }
+    HeliumCommandBarItem item;
+    item.type = HeliumCommandBarItem::Type::kCommand;
+    item.title = title;
+    item.command = entry.command;
+    item.score = score;
+    items.push_back(item);
+  }
+  return items;
+}
+
+std::optional<HeliumCommandBarItem> UrlOrSearchForQuery(
+    Profile* profile,
+    const std::u16string& query) {
+  const std::string trimmed(base::TrimWhitespaceASCII(
+      base::UTF16ToUTF8(query), base::TrimPositions::TRIM_ALL));
+  if (trimmed.empty()) {
+    return std::nullopt;
+  }
+  // Direct URL, with or without a scheme.
+  GURL url(trimmed);
+  if (!url.has_scheme() && trimmed.find(' ') == std::string::npos &&
+      trimmed.find('.') != std::string::npos) {
+    url = GURL("https://" + trimmed);
+  }
+  if (url.is_valid() && url.has_scheme() &&
+      (url.SchemeIs("http") || url.SchemeIs("https"))) {
+    HeliumCommandBarItem item;
+    item.type = HeliumCommandBarItem::Type::kUrl;
+    item.title = base::UTF8ToUTF16(url.spec());
+    item.url = url;
+    item.url_spec = url.spec();
+    item.score = 1;
+    return item;
+  }
+  // Fall back to the default search engine.
+  TemplateURLService* template_urls =
+      TemplateURLServiceFactory::GetForProfile(profile);
+  const TemplateURL* provider =
+      template_urls ? template_urls->GetDefaultSearchProvider() : nullptr;
+  if (!provider) {
+    return std::nullopt;
+  }
+  TemplateURLRef::SearchTermsArgs args(query);
+  GURL search_url(
+      provider->url_ref().ReplaceSearchTerms(args, template_urls->search_terms_data()));
+  if (!search_url.is_valid()) {
+    return std::nullopt;
+  }
+  HeliumCommandBarItem item;
+  item.type = HeliumCommandBarItem::Type::kSearch;
+  item.title = query;
+  item.url = search_url;
+  item.url_spec = search_url.spec();
+  item.score = 1;
+  return item;
+}
+
+void SortAndCap(std::vector<HeliumCommandBarItem>& items) {
+  std::ranges::stable_sort(items, [](const HeliumCommandBarItem& a,
+                                     const HeliumCommandBarItem& b) {
+    return a.score > b.score;
+  });
+  if (items.size() > kMaxResults) {
+    items.resize(kMaxResults);
+  }
+}
+
+}  // namespace helium_command_bar_model

