+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_HELIUM_COMMAND_BAR_CONTROLLER_H_
+#define CHROME_BROWSER_UI_HELIUM_HELIUM_COMMAND_BAR_CONTROLLER_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback_forward.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/cancelable_task_tracker.h"
+#include "chrome/browser/ui/helium/helium_command_bar_model.h"
+#include "components/history/core/browser/history_types.h"
+#include "ui/base/unowned_user_data/scoped_unowned_user_data.h"
+#include "ui/gfx/native_ui_types.h"
+
+class BrowserWindowInterface;
+
+namespace views {
+class Widget;
+}  // namespace views
+
+class HeliumCommandBarView;
+
+// Per-window native command bar (floating URL/command palette).
+//
+// Lumno implements its command bar as an extension content script, which
+// Chromium refuses to inject into chrome:// pages, WebUI and the new tab
+// page — so the bar can never open there. This controller instead owns a
+// plain Views popup widget anchored to the browser window, so it opens on
+// every page including settings and the new tab page.
+//
+// The controller is owned by BrowserWindowFeatures and reachable via
+// HeliumCommandBarController::From(browser). The parent window is supplied by
+// the command handler at toggle time, keeping this target free of the
+// views/frame dependency.
+class HeliumCommandBarController {
+ public:
+  DECLARE_USER_DATA(HeliumCommandBarController);
+
+  static HeliumCommandBarController* From(BrowserWindowInterface* browser);
+
+  explicit HeliumCommandBarController(BrowserWindowInterface* browser);
+  HeliumCommandBarController(const HeliumCommandBarController&) = delete;
+  HeliumCommandBarController& operator=(const HeliumCommandBarController&) =
+      delete;
+  ~HeliumCommandBarController();
+
+  void Toggle(gfx::NativeView parent,
+              const std::u16string& initial_query = {});
+  void Show(gfx::NativeView parent,
+            const std::u16string& initial_query = {});
+  void Hide();
+  bool IsShowing() const;
+
+  // Rebuilds results for |query|: tabs, bookmarks and commands synchronously,
+  // history asynchronously. Called by the view on every keystroke.
+  void OnQueryChanged(const std::u16string& query);
+  // Opens or switches to items_[index], then closes the bar.
+  void ActivateItem(size_t index);
+
+  base::WeakPtr<HeliumCommandBarController> GetWeakPtr();
+
+ private:
+  void OnWidgetClosed() {
+    widget_ = nullptr;
+    view_ = nullptr;
+  }
+  void OnHistoryResults(int seq,
+                        const std::u16string& query,
+                        history::QueryResults results);
+  void PushItems(std::vector<HeliumCommandBarItem> items);
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  // Owned by the widget itself (deleted on close); null when hidden.
+  raw_ptr<views::Widget> widget_ = nullptr;
+  // Owned by |widget_|; null when hidden.
+  raw_ptr<HeliumCommandBarView> view_ = nullptr;
+  std::vector<HeliumCommandBarItem> items_;
+  std::u16string last_query_;
+  int history_seq_ = 0;
+  // Cancels in-flight history queries on each keystroke and on destruction.
+  base::CancelableTaskTracker history_tracker_;
+  ui::ScopedUnownedUserData<HeliumCommandBarController> scoped_unowned_user_data_;
+  base::WeakPtrFactory<HeliumCommandBarController> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_HELIUM_HELIUM_COMMAND_BAR_CONTROLLER_H_

