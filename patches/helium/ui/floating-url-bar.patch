+}  // namespace
+
+// static
+HeliumCommandBarView* HeliumCommandBarView::Show(
+    gfx::NativeView parent,
+    const std::u16string& initial_query,
+    base::OnceClosure on_closed,
+    base::RepeatingCallback<void(const std::u16string&)> on_query,
+    base::RepeatingCallback<void(size_t)> on_activate,
+    base::RepeatingClosure on_tab,
+    base::RepeatingClosure on_escape) {
+  auto delegate = std::unique_ptr<HeliumCommandBarView>(new HeliumCommandBarView(
+      parent, initial_query, std::move(on_closed), std::move(on_query),
+      std::move(on_activate), std::move(on_tab), std::move(on_escape)));
+  HeliumCommandBarView* view = delegate.get();
+  views::Widget* widget = new views::Widget;
+  views::Widget::InitParams params(
+      views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_POPUP);
+  params.parent = parent;
+  params.delegate = delegate.release();
+  params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+  params.shadow_type = views::Widget::InitParams::ShadowType::kDrop;
+  params.activatable = views::Widget::InitParams::Activatable::kYes;
+  widget->Init(std::move(params));
+
+  // Hang the bar near the top of the browser window, Lumno-style.
+  const gfx::Rect parent_bounds =
+      views::Widget::GetWidgetForNativeView(parent)->GetWindowBoundsInScreen();
+  widget->SetBounds(gfx::Rect(
+      parent_bounds.x() + (parent_bounds.width() - kBarWidth) / 2,
+      parent_bounds.y() + parent_bounds.height() / 5, kBarWidth,
+      kInputHeight + 2 * 8));
+  widget->Show();
+  widget->AddObserver(view);
+  view->input_->RequestFocus();
+  return view;
+}
+
+HeliumCommandBarView::HeliumCommandBarView(
+    gfx::NativeView parent,
+    const std::u16string& initial_query,
+    base::OnceClosure on_closed,
+    base::RepeatingCallback<void(const std::u16string&)> on_query,
+    base::RepeatingCallback<void(size_t)> on_activate,
+    base::RepeatingClosure on_tab,
+    base::RepeatingClosure on_escape)
+    : on_closed_(std::move(on_closed)),
+      on_query_(std::move(on_query)),
+      on_activate_(std::move(on_activate)),
+      on_tab_(std::move(on_tab)),
+      on_escape_(std::move(on_escape)) {
+  SetModalType(ui::mojom::ModalType::kNone);
+  auto contents = std::make_unique<views::View>();
+  // Bottom inset compensates the main-axis gap below the input, so the empty
+  // state (input only) has visually balanced top/bottom margins.
+  contents->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets::TLBR(8, 8, 4, 8),
+      4));
+  // Opaque bubble so page content never bleeds through the results.
+  contents->SetBackground(views::CreateRoundedRectBackground(
+      ui::kColorBubbleBackground, kBubbleRadius));
+  contents->SetBorder(views::CreateRoundedRectBorder(
+      1, kBubbleRadius, ui::kColorBubbleBorder));
+  auto input = std::make_unique<views::Textfield>();
+  input->SetPlaceholderText(u"Search or type a URL...");
+  input->SetPreferredSize(gfx::Size(kBarWidth, kInputHeight));
+  input->SetController(this);
+  if (!initial_query.empty()) {
+    input->SetText(initial_query);
+  }
+  input_ = input.get();
+  contents->AddChildView(std::move(input));
+  // Scope bar: hidden unless a keyword scope is active. Shows the provider
+  // name and how to leave.
+  auto scope = std::make_unique<views::Label>(
+      std::u16string(), views::style::CONTEXT_LABEL,
+      views::style::STYLE_SECONDARY);
+  scope->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  scope->SetFontList(scope->font_list().DeriveWithSizeDelta(-1));
+  scope->SetVisible(false);
+  scope_bar_ = scope.get();
+  contents->AddChildView(std::move(scope));
+  auto results = std::make_unique<views::View>();
+  results->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), 0));
+  results_ = results.get();
+  contents->AddChildView(std::move(results));
+  SetContentsView(std::move(contents));
+}
+
+HeliumCommandBarView::~HeliumCommandBarView() = default;
+
+void HeliumCommandBarView::Close() {
+  if (GetWidget()) {
+    GetWidget()->Close();
+  }
+}
+
+void HeliumCommandBarView::SetResults(
+    const std::vector<HeliumCommandBarItem>& items,
+    std::optional<size_t> scope_hint) {
+  items_ = items;
+  scope_hint_ = scope_hint;
+  results_->RemoveAllChildViews();
+  selected_ = 0;
+  {
+    // TEMPORARY crash hunt: see comment in the controller.
+    FILE* f = fopen("/tmp/cmdbar.log", "a");
+    if (f) {
+      fprintf(f, "setresults n=%zu\n", items.size());
+      fclose(f);
+    }
+  }
+  for (size_t i = 0; i < items.size(); ++i) {
+    auto row = std::make_unique<ResultRowView>(
+        items[i],
+        base::BindRepeating(
+            [](HeliumCommandBarView* view, size_t index) {
+              view->on_activate_.Run(index);
+            },
+            base::Unretained(this), i),
+        base::BindRepeating(
+            [](HeliumCommandBarView* view, size_t index) {
+              view->SetSelected(index);
+            },
+            base::Unretained(this), i));
+    results_->AddChildView(std::move(row));
+  }
+  UpdateRowHighlight();
+  ResizeToContents();
+}
+
+void HeliumCommandBarView::ResizeToContents() {
+  if (!GetWidget()) {
+    return;
+  }
+  // Resizing the popup every keystroke flashes the whole bubble. Only
+  // resize when the height actually changed.
+  const int height = GetContentsView()->GetPreferredSize().height();
+  if (GetWidget()->GetWindowBoundsInScreen().height() != height) {
+    GetWidget()->SetSize(gfx::Size(kBarWidth, height));
+  }
+}
+
+void HeliumCommandBarView::SetInputText(const std::u16string& text) {
+  input_->SetText(text);
+}
+
+void HeliumCommandBarView::SetScope(const std::u16string& name) {
+  scope_bar_->SetText(name + u"   esc to exit");
+  scope_bar_->SetVisible(true);
+  ResizeToContents();
+}
+
+void HeliumCommandBarView::ClearScope() {
+  if (!scope_bar_->GetVisible()) {
+    return;
+  }
+  scope_bar_->SetVisible(false);
+  ResizeToContents();
+}
+
+void HeliumCommandBarView::SetItemImage(size_t index,
+                                          const gfx::Image& image) {
+  const auto& children = results_->children();
+  if (index >= children.size()) {
+    return;
+  }
+  static_cast<ResultRowView*>(children[index].get())->SetImage(image);
+}
+
+void HeliumCommandBarView::MoveSelection(int delta) {
+  const size_t count = results_->children().size();
+  if (count == 0) {
+    return;
+  }
+  SetSelected((selected_ + count + delta) % count);
+}
+
+void HeliumCommandBarView::SetSelected(size_t index) {
+  if (index >= results_->children().size()) {
+    return;
+  }
+  selected_ = index;
+  UpdateRowHighlight();
+}
+
+void HeliumCommandBarView::UpdateRowHighlight() {
+  const auto& children = results_->children();
+  for (size_t i = 0; i < children.size(); ++i) {
+    static_cast<ResultRowView*>(children[i].get())->SetSelected(i ==
+                                                                selected_);
+  }
+}
+
+void HeliumCommandBarView::WindowClosing() {
+  if (GetWidget()) {
+    GetWidget()->RemoveObserver(this);
+  }
+  std::move(on_closed_).Run();
+}
+
+void HeliumCommandBarView::OnWidgetActivationChanged(views::Widget* widget,
+                                                     bool active) {
+  if (!active) {
+    Close();
+  }
+}
+
+void HeliumCommandBarView::ContentsChanged(
+    views::Textfield* sender,
+    const std::u16string& new_contents) {
+  if (!on_query_.is_null()) {
+    on_query_.Run(new_contents);
+  }
+}
+
+bool HeliumCommandBarView::HandleKeyEvent(views::Textfield* sender,
+                                          const ui::KeyEvent& event) {
+  // Textfield forwards both key-press and key-release here; only act once.
+  if (event.type() != ui::EventType::kKeyPressed) {
+    return false;
+  }
+  switch (event.key_code()) {
+    case ui::VKEY_ESCAPE:
+      on_escape_.Run();
+      return true;
+    case ui::VKEY_UP:
+      MoveSelection(-1);
+      return true;
+    case ui::VKEY_DOWN:
+      MoveSelection(1);
+      return true;
+    case ui::VKEY_TAB:
+      // Tab enters the hinted scope, or completes the input with the
+      // selected row's URL. Never moves focus out of the bar.
+      on_tab_.Run();
+      return true;
+    case ui::VKEY_BACK:
+      // Backspace on empty input exits the scope; otherwise edit text.
+      if (sender->GetText().empty() && scope_bar_->GetVisible()) {
+        on_escape_.Run();
+        return true;
+      }
+      return false;
+    case ui::VKEY_RETURN:
+      if (!results_->children().empty()) {
+        on_activate_.Run(selected_);
+      }
+      return true;
+    default:
+      return false;
+  }
+}
+
+void HeliumCommandBarView::CompleteSelection() {
+  if (selected_ >= items_.size()) {
+    return;
+  }
+  const std::u16string& url = base::UTF8ToUTF16(items_[selected_].url_spec);
+  if (!url.empty()) {
+    SetInputText(url);
+  }
+}

