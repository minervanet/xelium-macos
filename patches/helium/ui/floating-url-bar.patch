+namespace views {
+class Label;
+class Textfield;
+class View;
+class Widget;
+}  // namespace views
+
+// Floating command bar popup: a text field with a results list below.
+// Rows are rebuilt on every keystroke; extras are clipped, never scrolled.
+class HeliumCommandBarView : public views::WidgetDelegate,
+                             public views::TextfieldController {
+ public:
+  // Creates, focuses and shows the popup parented to |parent|. |on_closed|
+  // runs when the widget begins closing, |on_query| on every keystroke,
+  // |on_activate| with the chosen result index. Returns the owning view
+  // (owned by the widget, deleted on close).
+  static HeliumCommandBarView* Show(
+      gfx::NativeView parent,
+      const std::u16string& initial_query,
+      base::OnceClosure on_closed,
+      base::RepeatingCallback<void(const std::u16string&)> on_query,
+      base::RepeatingCallback<void(size_t)> on_activate);
+
+  HeliumCommandBarView(const HeliumCommandBarView&) = delete;
+  HeliumCommandBarView& operator=(const HeliumCommandBarView&) = delete;
+  ~HeliumCommandBarView() override;
+
+  void Close();
+
+  // Rebuilds the rows from |items| and resizes the popup to fit.
+  void SetResults(const std::vector<HeliumCommandBarItem>& items);
+
+  // views::TextfieldController:
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string& new_contents) override;
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& event) override;
+
+ private:
+  HeliumCommandBarView(gfx::NativeView parent,
+                       const std::u16string& initial_query,
+                       base::OnceClosure on_closed,
+                       base::RepeatingCallback<void(const std::u16string&)>
+                           on_query,
+                       base::RepeatingCallback<void(size_t)> on_activate);
+
+  void WindowClosing() override;
+  void MoveSelection(int delta);
+  void UpdateRowHighlight();
+
+  base::OnceClosure on_closed_;
+  base::RepeatingCallback<void(const std::u16string&)> on_query_;
+  base::RepeatingCallback<void(size_t)> on_activate_;
+  raw_ptr<views::Textfield> input_ = nullptr;
+  raw_ptr<views::View> results_ = nullptr;
+  size_t selected_ = 0;
+};
+
+#endif  // CHROME_BROWSER_UI_HELIUM_HELIUM_COMMAND_BAR_VIEW_H_

