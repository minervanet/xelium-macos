+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/helium_command_bar_controller.h"
+
+#include "base/functional/bind.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/bookmarks/bookmark_model_factory.h"
+#include "chrome/browser/favicon/favicon_service_factory.h"
+#include "chrome/browser/history/history_service_factory.h"
+#include "chrome/browser/ui/helium/helium_command_bar_view.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/common/pref_names.h"
+#include "components/favicon/core/favicon_service.h"
+#include "components/history/core/browser/history_service.h"
+#include "components/keyed_service/core/service_access_type.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/accelerators/accelerator_manager.h"
+#include "ui/base/clipboard/scoped_clipboard_writer.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+#include "ui/base/window_open_disposition.h"
+#include "ui/views/focus/focus_manager.h"
+#include "ui/views/widget/widget.h"
+
+DEFINE_USER_DATA(HeliumCommandBarController);
+
+// static
+HeliumCommandBarController* HeliumCommandBarController::From(
+    BrowserWindowInterface* browser) {
+  if (!browser) {
+    return nullptr;
+  }
+  return HeliumCommandBarController::Get(browser->GetUnownedUserDataHost());
+}
+
+HeliumCommandBarController::HeliumCommandBarController(
+    BrowserWindowInterface* browser)
+    : browser_(browser),
+      scoped_unowned_user_data_(browser->GetUnownedUserDataHost(), *this) {}
+
+HeliumCommandBarController::~HeliumCommandBarController() {
+  if (focus_manager_) {
+    focus_manager_->UnregisterAccelerators(this);
+  }
+}
+
+void HeliumCommandBarController::Toggle(
+    gfx::NativeView parent,
+    const std::u16string& initial_query) {
+  if (IsShowing()) {
+    Hide();
+  } else {
+    Show(parent, initial_query);
+  }
+}
+
+void HeliumCommandBarController::Show(gfx::NativeView parent,
+                                      const std::u16string& initial_query) {
+  if (widget_) {
+    widget_->Activate();
+    return;
+  }
+  HeliumCommandBarView* view = HeliumCommandBarView::Show(
+      parent, initial_query,
+      base::BindOnce(&HeliumCommandBarController::OnWidgetClosed,
+                     weak_factory_.GetWeakPtr()),
+      base::BindRepeating(&HeliumCommandBarController::OnQueryChanged,
+                          weak_factory_.GetWeakPtr()),
+      base::BindRepeating(&HeliumCommandBarController::ActivateItem,
+                          weak_factory_.GetWeakPtr()));
+  widget_ = view->GetWidget();
+  view_ = view;
+  // Populate from the initial query (empty for Cmd+T, page URL for Cmd+L).
+  OnQueryChanged(initial_query);
+}
+
+void HeliumCommandBarController::Hide() {
+  if (!widget_) {
+    return;
+  }
+  // Null first: closing runs WindowClosing synchronously, which would
+  // otherwise re-enter and double-close.
+  views::Widget* widget = widget_;
+  widget_ = nullptr;
+  widget->Close();
+}
+
+bool HeliumCommandBarController::IsShowing() const {
+  return widget_ != nullptr;
+}
+
+base::WeakPtr<HeliumCommandBarController>
+HeliumCommandBarController::GetWeakPtr() {
+  return weak_factory_.GetWeakPtr();
+}
+
+void HeliumCommandBarController::RegisterAccelerators(
+    views::FocusManager* focus_manager) {
+  focus_manager_ = focus_manager;
+  for (const ui::KeyboardCode key : {ui::VKEY_T, ui::VKEY_L}) {
+    focus_manager_->RegisterAccelerator(
+        ui::Accelerator(key, ui::EF_PLATFORM_ACCELERATOR),
+        ui::AcceleratorManager::kHighPriority, this);
+  }
+}
+
+bool HeliumCommandBarController::AcceleratorPressed(
+    const ui::Accelerator& accelerator) {
+  if ((accelerator.key_code() != ui::VKEY_T &&
+       accelerator.key_code() != ui::VKEY_L) ||
+      accelerator.modifiers() != ui::EF_PLATFORM_ACCELERATOR) {
+    return false;
+  }
+  if (!browser_->GetProfile()->GetPrefs()->GetBoolean(
+          prefs::kHeliumCommandBarEnabled)) {
+    return false;
+  }
+  // Swallow repeats while open; Esc closes.
+  if (IsShowing()) {
+    return true;
+  }
+  TabStripModel* tab_strip = browser_->GetTabStripModel();
+  content::WebContents* contents =
+      tab_strip ? tab_strip->GetActiveWebContents() : nullptr;
+  if (!contents) {
+    return false;
+  }
+  std::u16string initial;
+  if (accelerator.key_code() == ui::VKEY_L) {
+    initial = base::UTF8ToUTF16(contents->GetVisibleURL().spec());
+  }
+  Toggle(contents->GetNativeView(), initial);
+  return true;
+}
+
+bool HeliumCommandBarController::CanHandleAccelerators() const {
+  return true;
+}
+
+void HeliumCommandBarController::OnQueryChanged(const std::u16string& query) {
+  last_query_ = query;
+
+  // Synchronous sources first so keystrokes feel instant; history merges in
+  // when its query returns.
+  std::vector<HeliumCommandBarItem> items =
+      helium_command_bar_model::TabsForQuery(browser_->GetTabStripModel(),
+                                             query);
+  bookmarks::BookmarkModel* bookmarks = BookmarkModelFactory::GetForBrowserContext(
+      browser_->GetProfile());
+  auto bookmark_items =
+      helium_command_bar_model::BookmarksForQuery(bookmarks, query);
+  items.insert(items.end(), std::make_move_iterator(bookmark_items.begin()),
+               std::make_move_iterator(bookmark_items.end()));
+  auto command_items = helium_command_bar_model::CommandsForQuery(query);
+  items.insert(items.end(), std::make_move_iterator(command_items.begin()),
+               std::make_move_iterator(command_items.end()));
+  if (auto direct = helium_command_bar_model::UrlOrSearchForQuery(
+          browser_->GetProfile(), query)) {
+    items.push_back(std::move(*direct));
+  }
+  helium_command_bar_model::SortAndCap(items);
+  PushItems(std::move(items));
+
+  // History is async. Sequence-guard so a slow query from an older keystroke
+  // can never overwrite newer results.
+  history_tracker_.TryCancelAll();
+  if (query.empty()) {
+    return;
+  }
+  history::HistoryService* history = HistoryServiceFactory::GetForProfile(
+      browser_->GetProfile(), ServiceAccessType::EXPLICIT_ACCESS);
+  if (!history) {
+    return;
+  }
+  const int seq = ++history_seq_;
+  history::QueryOptions options;
+  options.max_count = 30;
+  history->QueryHistory(
+      query, options,
+      base::BindOnce(&HeliumCommandBarController::OnHistoryResults,
+                     weak_factory_.GetWeakPtr(), seq, query),
+      &history_tracker_);
+}
+
+void HeliumCommandBarController::OnHistoryResults(
+    int seq,
+    const std::u16string& query,
+    history::QueryResults results) {
+  if (seq != history_seq_ || query != last_query_ || !view_) {
+    return;
+  }
+  std::vector<HeliumCommandBarItem> items =
+      helium_command_bar_model::TabsForQuery(browser_->GetTabStripModel(),
+                                             query);
+  bookmarks::BookmarkModel* bookmarks = BookmarkModelFactory::GetForBrowserContext(
+      browser_->GetProfile());
+  auto bookmark_items =
+      helium_command_bar_model::BookmarksForQuery(bookmarks, query);
+  items.insert(items.end(), std::make_move_iterator(bookmark_items.begin()),
+               std::make_move_iterator(bookmark_items.end()));
+  auto history_items = helium_command_bar_model::HistoryItemsForRows(
+      results, query);
+  items.insert(items.end(), std::make_move_iterator(history_items.begin()),
+               std::make_move_iterator(history_items.end()));
+  auto command_items = helium_command_bar_model::CommandsForQuery(query);
+  items.insert(items.end(), std::make_move_iterator(command_items.begin()),
+               std::make_move_iterator(command_items.end()));
+  if (auto direct = helium_command_bar_model::UrlOrSearchForQuery(
+          browser_->GetProfile(), query)) {
+    items.push_back(std::move(*direct));
+  }
+  helium_command_bar_model::SortAndCap(items);
+  PushItems(std::move(items));
+}
+
+void HeliumCommandBarController::PushItems(
+    std::vector<HeliumCommandBarItem> items) {
+  items_ = std::move(items);
+  ++items_seq_;
+  if (view_) {
+    view_->SetResults(items_);
+  }
+  FetchFavicons();
+}
+
+void HeliumCommandBarController::FetchFavicons() {
+  favicon::FaviconService* favicons = FaviconServiceFactory::GetForProfile(
+      browser_->GetProfile(), ServiceAccessType::EXPLICIT_ACCESS);
+  if (!favicons) {
+    return;
+  }
+  const int seq = items_seq_;
+  for (size_t i = 0; i < items_.size(); ++i) {
+    const GURL& url = items_[i].url;
+    if (!url.SchemeIsHTTPOrHTTPS()) {
+      continue;
+    }
+    const std::string spec = url.spec();
+    auto cached = favicon_cache_.find(spec);
+    if (cached != favicon_cache_.end() && view_) {
+      view_->SetItemImage(i, cached->second);
+      continue;
+    }
+    favicons->GetFaviconImageForPageURL(
+        url,
+        base::BindOnce(&HeliumCommandBarController::OnFavicon,
+                       weak_factory_.GetWeakPtr(), seq, i, spec),
+        &favicon_tracker_);
+  }
+}
+
+void HeliumCommandBarController::OnFavicon(
+    int seq,
+    size_t index,
+    const std::string& url_spec,
+    const favicon_base::FaviconImageResult& result) {
+  if (result.image.IsEmpty()) {
+    return;
+  }
+  favicon_cache_[url_spec] = result.image;
+  if (seq != items_seq_ || !view_ || index >= items_.size()) {
+    return;
+  }
+  view_->SetItemImage(index, result.image);
+}
+
+void HeliumCommandBarController::ActivateItem(size_t index) {
+  if (index >= items_.size()) {
+    return;
+  }
+  const HeliumCommandBarItem item = items_[index];
+  if (item.type == HeliumCommandBarItem::Type::kTab) {
+    TabStripModel* tab_strip = browser_->GetTabStripModel();
+    if (tab_strip && item.tab_index >= 0 &&
+        item.tab_index < tab_strip->count()) {
+      tab_strip->ActivateTabAt(item.tab_index);
+    }
+    Hide();
+    return;
+  }
+  GURL url;
+  switch (item.type) {
+    case HeliumCommandBarItem::Type::kTab:
+      break;  // Handled above.
+    case HeliumCommandBarItem::Type::kCommand:
+      switch (item.command) {
+        case HeliumCommandBarItem::Command::kNewTab:
+          url = GURL("chrome://newtab/");
+          break;
+        case HeliumCommandBarItem::Command::kOpenSettings:
+          url = GURL("chrome://settings");
+          break;
+        case HeliumCommandBarItem::Command::kOpenHistory:
+          url = GURL("chrome://history");
+          break;
+        case HeliumCommandBarItem::Command::kOpenDownloads:
+          url = GURL("chrome://downloads");
+          break;
+        case HeliumCommandBarItem::Command::kCopyUrl: {
+          TabStripModel* tab_strip = browser_->GetTabStripModel();
+          content::WebContents* contents =
+              tab_strip ? tab_strip->GetActiveWebContents() : nullptr;
+          if (contents) {
+            ui::ScopedClipboardWriter writer(ui::ClipboardBuffer::kCopyPaste);
+            writer.WriteText(base::UTF8ToUTF16(contents->GetVisibleURL().spec()));
+          }
+          Hide();
+          return;
+        }
+      }
+      break;
+    case HeliumCommandBarItem::Type::kBookmark:
+    case HeliumCommandBarItem::Type::kHistory:
+    case HeliumCommandBarItem::Type::kUrl:
+    case HeliumCommandBarItem::Type::kSearch:
+      url = item.url;
+      break;
+  }
+  if (url.is_valid()) {
+    NavigateParams params(browser_, url, ui::PAGE_TRANSITION_TYPED);
+    params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+    Navigate(&params);
+  }
+  Hide();
+}

