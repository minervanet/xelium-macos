+
+// One result row. Mirrors Lumno's slate: open tabs first, then bookmarks,
+// history and built-in commands, then a direct URL / default-search row.
+struct HeliumCommandBarItem {
+  enum class Type {
+    kTab,
+    kBookmark,
+    kHistory,
+    kCommand,
+    kUrl,
+    kSearch,
+    kSiteSearch,
+  };
+
+  enum class Command {
+    kNewTab,
+    kOpenSettings,
+    kOpenHistory,
+    kOpenDownloads,
+    kCopyUrl,
+  };
+
+  Type type;
+  std::u16string title;
+  // Display URL (empty for commands and the search row until composed).
+  std::string url_spec;
+  GURL url;
+  // Set for kTab: index in the window's TabStripModel.
+  int tab_index = -1;
+  // Set for kCommand.
+  Command command = Command::kNewTab;
+  // Set for kSiteSearch: the keyword that opened the scope ("gh") and the
+  // provider's display name ("GitHub"). Empty for the built-in "tab" scope,
+  // which lists open tabs only.
+  std::string site_keyword;
+  std::u16string site_name;
+  // Favicon override (e.g. the search engine's icon). Fetch falls back to
+  // |url| when invalid.
+  GURL icon_url;
+  // Higher ranks first. Tabs keep strip order among equal scores.
+  int score = 0;
+};
+
+namespace helium_command_bar_model {
+
+// Maximum rows shown. Extras are clipped, never scrolled.
+inline constexpr size_t kMaxResults = 9;
+
+// Scores |text| (already lowercased title or URL) against |query|
+// (lowercased, non-empty). Prefix beats word-boundary beats substring.
+int ScoreText(const std::u16string& text, const std::u16string& query);
+
+std::vector<HeliumCommandBarItem> TabsForQuery(
+    TabStripModel* tab_strip,
+    const std::u16string& query);
+
+std::vector<HeliumCommandBarItem> BookmarksForQuery(
+    bookmarks::BookmarkModel* model,
+    const std::u16string& query);
+
+std::vector<HeliumCommandBarItem> HistoryItemsForRows(
+    const history::QueryResults& results,
+    const std::u16string& query);
+
+std::vector<HeliumCommandBarItem> CommandsForQuery(
+    const std::u16string& query);
+
+// Splits |query| into a keyword and remainder ("gh foo" -> {"gh", "foo"}).
+// A leading '!' is stripped ("!gh foo"). Returns nullopt when there is no
+// space-separated remainder and |require_remainder| is true.
+struct KeywordSplit {
+  std::string keyword;
+  std::u16string remainder;
+  bool has_remainder = false;
+};
+std::optional<KeywordSplit> SplitKeyword(const std::u16string& query,
+                                         bool require_remainder);
+
+// Built-in tabs-only scope, used when no search engine owns the keyword
+// "tab". |remainder| may be empty (lists every open tab).
+HeliumCommandBarItem TabsScopeHint(const std::u16string& remainder);
+
+// Scope hint row for the search engine owning |keyword|. Nullopt when the
+// engine is missing or cannot search. |remainder| may be empty (Enter then
+// opens the scope instead of navigating).
+std::optional<HeliumCommandBarItem> SiteSearchHintForQuery(
+    TemplateURLService* template_urls,
+    const std::string& keyword,
+    const std::u16string& remainder);
+
+// Search URL for |keyword| + |remainder|. Nullopt when the engine is missing,
+// cannot search, or |remainder| is empty.
+std::optional<GURL> BuildSiteSearchUrl(TemplateURLService* template_urls,
+                                       const std::string& keyword,
+                                       const std::u16string& remainder);
+
+// Display name for the scope badge. Falls back to the keyword itself.
+std::u16string SiteScopeName(TemplateURLService* template_urls,
+                             const std::string& keyword);
+
+// True when |keyword| (after '!' normalization) names a searchable engine.
+bool EngineOwnsKeyword(TemplateURLService* template_urls,
+                       const std::string& keyword);
+
+// Direct-navigation or default-search row for a non-empty query. Nullopt when
+// the query is empty or no search provider exists.
+std::optional<HeliumCommandBarItem> UrlOrSearchForQuery(
+    Profile* profile,
+    const std::u16string& query);
+
+void SortAndCap(std::vector<HeliumCommandBarItem>& items);
+
