+    // Default glyph so rows without a favicon (commands, chrome:// pages)
+    // still show an icon. Replaced when the favicon arrives.
+    icon_->SetImage(ui::ImageModel::FromVectorIcon(
+        kGlobeIcon, ui::kColorMenuIcon, kIconSize));
+    auto* text = AddChildView(std::make_unique<views::View>());
+    text->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(), 1));
+    text->SetProperty(
+        views::kFlexBehaviorKey,
+        views::FlexSpecification(views::MinimumFlexSizeRule::kScaleToZero,
+                                 views::MaximumFlexSizeRule::kPreferred));
+    auto* title = text->AddChildView(std::make_unique<views::Label>(
+        item.title, views::style::CONTEXT_LABEL,
+        views::style::STYLE_PRIMARY));
+    title->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    title->SetElideBehavior(gfx::ELIDE_TAIL);
+    title_ = title;
+    // Single-line rows (commands, tabs without... ) must not reserve a
+    // second line: an empty Label still measures a full line height, which
+    // pushed the title above the icon instead of centering it.
+    const bool has_subtitle = !item.url_spec.empty();
+    views::Label* url = nullptr;
+    if (has_subtitle) {
+      const std::u16string subtitle = base::UTF8ToUTF16(item.url_spec);
+      url = text->AddChildView(std::make_unique<views::Label>(
+          subtitle, views::style::CONTEXT_LABEL,
+          views::style::STYLE_SECONDARY));
+      url->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+      url->SetElideBehavior(gfx::ELIDE_TAIL);
+      url->SetFontList(url->font_list().DeriveWithSizeDelta(-2));
+    }
+    // Fixed width so every row lines up and the tag column never moves.
+    // Height follows the labels; the row centers it vertically.
+    text->SetPreferredSize(
+        gfx::Size(kTextWidth, text->GetPreferredSize().height()));
+    auto* tag = AddChildView(std::make_unique<views::Label>(
+        base::UTF8ToUTF16(TagForType(item.type)),
+        views::style::CONTEXT_LABEL, views::style::STYLE_SECONDARY));
+    tag->SetHorizontalAlignment(gfx::ALIGN_RIGHT);
+    tag->SetElideBehavior(gfx::ELIDE_TAIL);
+    tag->SetFontList(tag->font_list().DeriveWithSizeDelta(-1));
+    // Fixed width, vertically centered by the row's cross-axis alignment, so
+    // the tag never drifts into the title or URL. Height tracks the title
+    // so single-line rows keep the tag aligned with it.
+    tag->SetPreferredSize(
+        gfx::Size(kTagWidth, title->GetPreferredSize().height()));
+    SetPreferredSize(
+        gfx::Size(kBarWidth - 2 * kHorizontalPadding, kRowHeight));
+    on_click_ = std::move(on_click);
+    on_hover_ = std::move(on_hover);
+  }
+  ~ResultRowView() override = default;
+
+  void SetSelected(bool selected) {
+    marker_->SetText(selected ? u"\u2192" : u"");
+    if (selected) {
+      // Translucent so the frosted backdrop tints through.
+      SkColor base = GetColorProvider()->GetColor(
+          ui::kColorAppMenuRowBackgroundHovered);
+      SetBackground(views::CreateRoundedRectBackground(
+          SkColorSetA(base, 0x73), kRowRadius));
+    } else {
+      SetBackground(nullptr);
+    }
+  }
+
+  void SetImage(const gfx::Image& image) {
+    icon_->SetImage(
+        ui::ImageModel::FromImageSkia(*image.ToImageSkia()));
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    if (event.IsOnlyLeftMouseButton() && !on_click_.is_null()) {
+      on_click_.Run();
+      return true;
+    }
+    return false;
+  }
+
+  void OnMouseEntered(const ui::MouseEvent& event) override {
+    if (!on_hover_.is_null()) {
+      on_hover_.Run();
+    }
+  }
+
+ private:
+  raw_ptr<views::Label> marker_ = nullptr;
+  raw_ptr<views::ImageView> icon_ = nullptr;
+  raw_ptr<views::Label> title_ = nullptr;
+  base::RepeatingClosure on_click_;
+  base::RepeatingClosure on_hover_;
+};
+
+BEGIN_METADATA(ResultRowView)
+END_METADATA
