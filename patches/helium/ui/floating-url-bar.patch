+namespace {
+
+// TEMPORARY crash hunt (youtube.com keystroke kills the browser): append-only
+// file log, flushed per event so the tail survives the crash. Remove once
+// the faulting input is identified.
+void CmdBarTrace(const std::string& line) {
+  if (FILE* f = fopen("/tmp/cmdbar.log", "a")) {
+    fprintf(f, "%s\n", line.c_str());
+    fclose(f);
+  }
+}
+
+std::string ItemSig(const HeliumCommandBarItem& item) {
+  return std::to_string(static_cast<int>(item.type)) + ":" +
+         std::to_string(item.title.size()) + ":" +
+         std::to_string(item.url_spec.size());
+}
+
+}  // namespace
+
+namespace {
+
+// Visible identity of a result row. Scores are excluded on purpose: the same
+// query always scores the same, and rebuilding identical rows every
+// keystroke is what made the bubble flash.
+bool SameItems(const std::vector<HeliumCommandBarItem>& a,
+               const std::vector<HeliumCommandBarItem>& b) {
+  if (a.size() != b.size()) {
+    return false;
+  }
+  for (size_t i = 0; i < a.size(); ++i) {
+    if (a[i].type != b[i].type || a[i].title != b[i].title ||
+        a[i].url_spec != b[i].url_spec ||
+        a[i].site_keyword != b[i].site_keyword ||
+        a[i].command != b[i].command || a[i].tab_index != b[i].tab_index) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// True for the new tab page in both its incarnations. Entering a URL there
+// navigates in place instead of opening yet another tab.
+bool IsNewTabUrl(const GURL& url) {
+  return url.SchemeIs("chrome") &&
+         (url.host() == "newtab" || url.host() == "new-tab-page");
+}
+
+}  // namespace
