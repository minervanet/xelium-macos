@@ -0,0 +1,157 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_HELIUM_COMMAND_BAR_CONTROLLER_H_
+#define CHROME_BROWSER_UI_HELIUM_HELIUM_COMMAND_BAR_CONTROLLER_H_
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback_forward.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/cancelable_task_tracker.h"
+#include "chrome/browser/ui/helium/helium_command_bar_model.h"
+#include "components/favicon_base/favicon_types.h"
+#include "components/history/core/browser/history_types.h"
+#include "ui/base/accelerators/accelerator.h"
+#include "ui/base/unowned_user_data/scoped_unowned_user_data.h"
+#include "ui/gfx/image/image.h"
+#include "ui/gfx/native_ui_types.h"
+#include "ui/views/focus/focus_manager.h"
+
+class BrowserWindowInterface;
+
+namespace views {
+class Widget;
+}  // namespace views
+
+class HeliumCommandBarView;
+
+// Per-window native command bar (floating URL/command palette).
+//
+// Lumno implements its command bar as an extension content script, which
+// Chromium refuses to inject into chrome:// pages, WebUI and the new tab
+// page — so the bar can never open there. This controller instead owns a
+// plain Views popup widget anchored to the browser window, so it opens on
+// every page including settings and the new tab page.
+//
+// The controller is owned by BrowserWindowFeatures and reachable via
+// HeliumCommandBarController::From(browser). The parent window is supplied by
+// the command handler at toggle time, keeping this target free of the
+// views/frame dependency.
+//
+// Cmd+T / Cmd+L takeover: on macOS the main menu claims those equivalents
+// before Views accelerators are consulted, so a static-table entry would
+// never fire. Instead the controller registers itself as a high-priority
+// accelerator target on the window's FocusManager — the same path extension
+// commands use to outrank the menu — and consumes plain Cmd+T / Cmd+L only
+// while the pref is on. Menu clicks and other invocations still execute
+// IDC_NEW_TAB / IDC_FOCUS_LOCATION normally.
+class HeliumCommandBarController : public ui::AcceleratorTarget,
+                                   public views::FocusChangeListener {
+ public:
+  DECLARE_USER_DATA(HeliumCommandBarController);
+
+  static HeliumCommandBarController* From(BrowserWindowInterface* browser);
+
+  explicit HeliumCommandBarController(BrowserWindowInterface* browser);
+  HeliumCommandBarController(const HeliumCommandBarController&) = delete;
+  HeliumCommandBarController& operator=(const HeliumCommandBarController&) =
+      delete;
+  ~HeliumCommandBarController() override;
+
+  // Registers Cmd+T / Cmd+L at high accelerator priority. Called once the
+  // window's FocusManager exists.
+  void RegisterAccelerators(views::FocusManager* focus_manager);
+
+  void Toggle(gfx::NativeView parent,
+              const std::u16string& initial_query = {});
+  void Show(gfx::NativeView parent,
+            const std::u16string& initial_query = {});
+  void Hide();
+  // Deferred Hide for use inside input/mouse event dispatch, where closing
+  // the widget synchronously would destroy views still on the stack.
+  void HideSoon();
+  bool IsShowing() const;
+
+  // Rebuilds results for |query|: tabs, bookmarks and commands synchronously,
+  // history asynchronously. Called by the view on every keystroke.
+  void OnQueryChanged(const std::u16string& query);
+  // Opens or switches to items_[index], then closes the bar.
+  void ActivateItem(size_t index);
+  // Tab key: enters the hinted scope, or completes the input with the
+  // selected row's URL.
+  void OnTabPressed();
+  // Esc (or Backspace on empty input while scoped): exits the scope, else
+  // closes the bar.
+  void OnEscapePressed();
+  void ExitScope();
+
+  base::WeakPtr<HeliumCommandBarController> GetWeakPtr();
+
+  // ui::AcceleratorTarget:
+  bool AcceleratorPressed(const ui::Accelerator& accelerator) override;
+  bool CanHandleAccelerators() const override;
+
+  // views::FocusChangeListener: the window's FocusManager dies before this
+  // controller on browser shutdown. Clear the pointer there so the
+  // destructor never calls into freed memory (crash seen in the wild:
+  // UnregisterAccelerators on a dead manager during Browser teardown).
+  void OnFocusManagerDestroying(views::FocusManager* focus_manager) override;
+
+ private:
+  void OnWidgetClosed() {
+    widget_ = nullptr;
+    view_ = nullptr;
+  }
+  // Builds the result list for |query| from the synchronous sources plus
+  // |history_rows| when present. Honors the active scope.
+  std::vector<HeliumCommandBarItem> CollectResults(
+      const std::u16string& query,
+      const history::QueryResults* history_rows);
+  // Remainder after the scope keyword ("gh foo" in scope "gh" -> "foo").
+  std::u16string ScopeRemainder(const std::u16string& query) const;
+  void OnHistoryResults(int seq,
+                        const std::u16string& query,
+                        history::QueryResults results);
+  void PushItems(std::vector<HeliumCommandBarItem> items);
+  void FetchFavicons();
+  void OnFavicon(int seq, size_t index, const std::string& url_spec,
+                 const favicon_base::FaviconImageResult& result);
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  // Owned by the widget itself (deleted on close); null when hidden.
+  raw_ptr<views::Widget> widget_ = nullptr;
+  // Owned by |widget_|; null when hidden.
+  raw_ptr<HeliumCommandBarView> view_ = nullptr;
+  // Focus manager holding our high-priority Cmd+T / Cmd+L registration;
+  // unregistered in the destructor.
+  raw_ptr<views::FocusManager> focus_manager_ = nullptr;
+  std::vector<HeliumCommandBarItem> items_;
+  // Index of the scope-hint row in |items_|, if any. Tab/Enter on it enters
+  // the scope instead of navigating.
+  std::optional<size_t> scope_hint_index_;
+  std::u16string last_query_;
+  // Active scope keyword ("gh", or "tab" for the tabs-only scope). Empty
+  // means mixed results.
+  std::string scope_keyword_;
+  int history_seq_ = 0;
+  // Cancels in-flight history queries on each keystroke and on destruction.
+  base::CancelableTaskTracker history_tracker_;
+  // Most recent history rows, re-scored for interim paints so the list does
+  // not flash out and back on every keystroke while a fresh query runs.
+  history::QueryResults last_history_rows_;
+  int items_seq_ = 0;
+  // Favicon cache keyed by URL spec; avoids refetching while scrolling keys.
+  std::map<std::string, gfx::Image> favicon_cache_;
+  base::CancelableTaskTracker favicon_tracker_;
+  ui::ScopedUnownedUserData<HeliumCommandBarController> scoped_unowned_user_data_;
+  base::WeakPtrFactory<HeliumCommandBarController> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_HELIUM_HELIUM_COMMAND_BAR_CONTROLLER_H_

