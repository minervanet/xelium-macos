+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/helium_command_bar_view.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/strings/utf_string_conversions.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/events/event.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+#include "ui/gfx/font_list.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/controls/textfield/textfield.h"
+#include "ui/views/layout/box_layout.h"
+#include "ui/views/view_class_properties.h"
+#include "ui/views/widget/widget.h"
+
+namespace {
+
+// Matches Lumno's panel density. Rows are a fixed height; the popup grows
+// with the result count and clips extras instead of scrolling.
+constexpr int kBarWidth = 560;
+constexpr int kInputHeight = 40;
+constexpr int kRowHeight = 46;
+constexpr int kHorizontalPadding = 12;
+
+const char* TagForType(HeliumCommandBarItem::Type type) {
+  switch (type) {
+    case HeliumCommandBarItem::Type::kTab:
+      return "Switch";
+    case HeliumCommandBarItem::Type::kBookmark:
+      return "Bookmark";
+    case HeliumCommandBarItem::Type::kHistory:
+      return "History";
+    case HeliumCommandBarItem::Type::kCommand:
+      return "Command";
+    case HeliumCommandBarItem::Type::kUrl:
+      return "Open";
+    case HeliumCommandBarItem::Type::kSearch:
+      return "Search";
+  }
+}
+
+// One result row. Clicking activates it; the leading marker shows selection.
+class ResultRowView : public views::View {
+  METADATA_HEADER(ResultRowView, views::View)
+
+ public:
+  ResultRowView(HeliumCommandBarItem item,
+                base::RepeatingClosure on_click) {
+    SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal,
+        gfx::Insets::VH(4, kHorizontalPadding), 8));
+    marker_ = AddChildView(std::make_unique<views::Label>(u""));
+    marker_->SetPreferredSize(gfx::Size(16, kRowHeight));
+    auto* text = AddChildView(std::make_unique<views::View>());
+    text->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(), 1));
+    text->SetProperty(
+        views::kFlexBehaviorKey,
+        views::FlexSpecification(views::MinimumFlexSizeRule::kScaleToZero,
+                                 views::MaximumFlexSizeRule::kUnbounded));
+    auto* title = text->AddChildView(std::make_unique<views::Label>(
+        item.title, views::style::CONTEXT_LABEL,
+        views::style::STYLE_PRIMARY));
+    title->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    title->SetElideBehavior(gfx::ELIDE_TAIL);
+    title_ = title;
+    const std::u16string subtitle = item.url_spec.empty()
+                                        ? u""
+                                        : base::UTF8ToUTF16(item.url_spec);
+    auto* url = text->AddChildView(
+        std::make_unique<views::Label>(subtitle, views::style::CONTEXT_LABEL,
+                                       views::style::STYLE_SECONDARY));
+    url->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    url->SetElideBehavior(gfx::ELIDE_TAIL);
+    url->SetFontList(
+        url->font_list().DeriveWithSizeDelta(-2));
+    auto* tag = AddChildView(std::make_unique<views::Label>(
+        base::UTF8ToUTF16(TagForType(item.type)),
+        views::style::CONTEXT_LABEL, views::style::STYLE_SECONDARY));
+    tag->SetFontList(tag->font_list().DeriveWithSizeDelta(-1));
+    SetPreferredSize(
+        gfx::Size(kBarWidth - 2 * kHorizontalPadding, kRowHeight));
+    on_click_ = std::move(on_click);
+  }
+  ~ResultRowView() override = default;
+
+  void SetSelected(bool selected) {
+    marker_->SetText(selected ? u"\u2192" : u"");
+    title_->SetFontList(title_->font_list().DeriveWithWeight(
+        selected ? gfx::Font::Weight::BOLD : gfx::Font::Weight::NORMAL));
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    if (event.IsOnlyLeftMouseButton() && !on_click_.is_null()) {
+      on_click_.Run();
+      return true;
+    }
+    return false;
+  }
+
+ private:
+  raw_ptr<views::Label> marker_ = nullptr;
+  raw_ptr<views::Label> title_ = nullptr;
+  base::RepeatingClosure on_click_;
+};
+
+BEGIN_METADATA(ResultRowView)
+END_METADATA
+
+}  // namespace
+
+// static
+HeliumCommandBarView* HeliumCommandBarView::Show(
+    gfx::NativeView parent,
+    const std::u16string& initial_query,
+    base::OnceClosure on_closed,
+    base::RepeatingCallback<void(const std::u16string&)> on_query,
+    base::RepeatingCallback<void(size_t)> on_activate) {
+  auto delegate = std::unique_ptr<HeliumCommandBarView>(
+      new HeliumCommandBarView(parent, initial_query, std::move(on_closed),
+                               std::move(on_query), std::move(on_activate)));
+  HeliumCommandBarView* view = delegate.get();
+  views::Widget* widget = new views::Widget;
+  views::Widget::InitParams params(
+      views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_POPUP);
+  params.parent = parent;
+  params.delegate = delegate.release();
+  params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+  params.shadow_type = views::Widget::InitParams::ShadowType::kDrop;
+  params.activatable = views::Widget::InitParams::Activatable::kYes;
+  widget->Init(std::move(params));
+
+  // Hang the bar near the top of the browser window, Lumno-style.
+  const gfx::Rect parent_bounds =
+      views::Widget::GetWidgetForNativeView(parent)->GetWindowBoundsInScreen();
+  widget->SetBounds(gfx::Rect(
+      parent_bounds.x() + (parent_bounds.width() - kBarWidth) / 2,
+      parent_bounds.y() + parent_bounds.height() / 5, kBarWidth,
+      kInputHeight + 2 * 8));
+  widget->Show();
+  view->input_->RequestFocus();
+  return view;
+}
+
+HeliumCommandBarView::HeliumCommandBarView(
+    gfx::NativeView parent,
+    const std::u16string& initial_query,
+    base::OnceClosure on_closed,
+    base::RepeatingCallback<void(const std::u16string&)> on_query,
+    base::RepeatingCallback<void(size_t)> on_activate)
+    : on_closed_(std::move(on_closed)),
+      on_query_(std::move(on_query)),
+      on_activate_(std::move(on_activate)) {
+  SetModalType(ui::mojom::ModalType::kNone);
+  auto contents = std::make_unique<views::View>();
+  contents->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets::VH(8, 12), 0));
+  auto input = std::make_unique<views::Textfield>();
+  input->SetPlaceholderText(u"Search or type a URL...");
+  input->SetPreferredSize(gfx::Size(kBarWidth, kInputHeight));
+  input->SetController(this);
+  if (!initial_query.empty()) {
+    input->SetText(initial_query);
+  }
+  input_ = input.get();
+  contents->AddChildView(std::move(input));
+  auto results = std::make_unique<views::View>();
+  results->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), 0));
+  results_ = results.get();
+  contents->AddChildView(std::move(results));
+  SetContentsView(std::move(contents));
+}
+
+HeliumCommandBarView::~HeliumCommandBarView() = default;
+
+void HeliumCommandBarView::Close() {
+  if (GetWidget()) {
+    GetWidget()->Close();
+  }
+}
+
+void HeliumCommandBarView::SetResults(
+    const std::vector<HeliumCommandBarItem>& items) {
+  results_->RemoveAllChildViews();
+  selected_ = 0;
+  for (size_t i = 0; i < items.size(); ++i) {
+    auto row = std::make_unique<ResultRowView>(
+        items[i], base::BindRepeating(
+                      [](HeliumCommandBarView* view, size_t index) {
+                        view->on_activate_.Run(index);
+                      },
+                      base::Unretained(this), i));
+    results_->AddChildView(std::move(row));
+  }
+  UpdateRowHighlight();
+  if (GetWidget()) {
+    GetWidget()->SetSize(GetContentsView()->GetPreferredSize());
+  }
+}
+
+void HeliumCommandBarView::MoveSelection(int delta) {
+  const size_t count = results_->children().size();
+  if (count == 0) {
+    return;
+  }
+  selected_ = (selected_ + count + delta) % count;
+  UpdateRowHighlight();
+}
+
+void HeliumCommandBarView::UpdateRowHighlight() {
+  const auto& children = results_->children();
+  for (size_t i = 0; i < children.size(); ++i) {
+    static_cast<ResultRowView*>(children[i].get())->SetSelected(i ==
+                                                                selected_);
+  }
+}
+
+void HeliumCommandBarView::WindowClosing() {
+  std::move(on_closed_).Run();
+}
+
+void HeliumCommandBarView::ContentsChanged(
+    views::Textfield* sender,
+    const std::u16string& new_contents) {
+  if (!on_query_.is_null()) {
+    on_query_.Run(new_contents);
+  }
+}
+
+bool HeliumCommandBarView::HandleKeyEvent(views::Textfield* sender,
+                                          const ui::KeyEvent& event) {
+  switch (event.key_code()) {
+    case ui::VKEY_ESCAPE:
+      Close();
+      return true;
+    case ui::VKEY_UP:
+      MoveSelection(-1);
+      return true;
+    case ui::VKEY_DOWN:
+      MoveSelection(1);
+      return true;
+    case ui::VKEY_RETURN:
+      if (!results_->children().empty()) {
+        on_activate_.Run(selected_);
+      }
+      return true;
+    default:
+      return false;
+  }
+}

