+namespace {
+constexpr int kTabPadding = 4;
+
+// Reads the user-configured maximum number of pinned tabs per row in the
+// vertical tab strip. Returns 0 when uncapped.
+int GetMaxPinnedTabsPerRow(const TabStripCollectionController* controller) {
+  BrowserView* browser_view =
+      controller ? controller->GetBrowserView() : nullptr;
+  const BrowserWindowInterface* browser_window =
+      browser_view ? browser_view->browser() : nullptr;
+  const Profile* profile =
+      browser_window ? browser_window->GetProfile() : nullptr;
+  const PrefService* prefs = profile ? profile->GetPrefs() : nullptr;
+  if (!prefs || !prefs->HasPref(prefs::kHeliumVerticalPinnedTabsPerRow)) {
+    return 0;
+  }
+  const int max_per_row =
+      prefs->GetInteger(prefs::kHeliumVerticalPinnedTabsPerRow);
+  if (max_per_row <= 0) {
+    return 0;
+  }
+  return max_per_row > 4 ? 4 : max_per_row;
+}
+}  // namespace
 
