+bool ContentsContainerView::IsPointInFrameThickness(
+    const gfx::Point& point) const {
+  if (!should_round_contents_ ||
+      ContentsContainerOutline::GetThickness(false) <= 0 ||
+      !GetLocalBounds().Contains(point)) {
+    return false;
+  }
+  return !GetContentsBounds().Contains(point);
+}
