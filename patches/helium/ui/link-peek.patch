+// Floating peek bubble: a header row (favicon, title, actions) above the
+// live preview page. Owned by the popup widget; the controller owns the
+// preview WebContents and lends it here for display.
+class HeliumLinkPeekView : public views::WidgetDelegate,
+                           public views::WidgetObserver,
+                           public ui::AcceleratorTarget {
+ public:
+  // Shows the bubble for |preview| parented under |parent| and returns the
+  // owning view (owned by the widget, deleted on close). |on_closed| runs
+  // when the widget begins closing.
+  static HeliumLinkPeekView* Show(
+      gfx::NativeView parent,
+      content::WebContents* preview,
+      Profile* profile,
+      base::OnceClosure on_closed,
+      base::RepeatingCallback<void(bool)> on_open_tab,
+      base::RepeatingClosure on_open_split,
+      base::RepeatingClosure on_copy_link);
+
+  HeliumLinkPeekView(const HeliumLinkPeekView&) = delete;
+  HeliumLinkPeekView& operator=(const HeliumLinkPeekView&) = delete;
+  ~HeliumLinkPeekView() override;
+
+  void Close();
+  // Detaches the preview WebContents (for tab/split adoption); the bubble
+  // must close immediately after.
+  void DetachPreview();
+  void SetTitle(const std::u16string& title);
+  void SetIcon(const gfx::Image& image);
+
+  // views::WidgetDelegate:
+  // ui::AcceleratorTarget:
+  bool AcceleratorPressed(const ui::Accelerator& accelerator) override;
+  bool CanHandleAccelerators() const override;
+
+ private:
+  HeliumLinkPeekView(gfx::NativeView parent,
+                     content::WebContents* preview,
+                     Profile* profile,
+                     const gfx::Size& popup_size,
+                     base::OnceClosure on_closed,
+                     base::RepeatingCallback<void(bool)> on_open_tab,
+                     base::RepeatingClosure on_open_split,
+                     base::RepeatingClosure on_copy_link);
+
+  void WindowClosing() override;
+  void OnWidgetActivationChanged(views::Widget* widget, bool active) override;
+
+  base::OnceClosure on_closed_;
+  base::RepeatingCallback<void(bool)> on_open_tab_;
+  base::RepeatingClosure on_open_split_;
+  base::RepeatingClosure on_copy_link_;
+  raw_ptr<views::ImageView> icon_ = nullptr;
+  raw_ptr<views::Label> title_ = nullptr;
+  raw_ptr<views::WebView> web_view_ = nullptr;
+};
+
