+#ifndef CHROME_BROWSER_UI_HELIUM_HELIUM_LINK_PEEK_CONTROLLER_H_
+#define CHROME_BROWSER_UI_HELIUM_HELIUM_LINK_PEEK_CONTROLLER_H_
+
+#include <memory>
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/cancelable_task_tracker.h"
+#include "components/favicon_base/favicon_types.h"
+#include "content/public/browser/web_contents_delegate.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "ui/base/unowned_user_data/scoped_unowned_user_data.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace blink {
+namespace mojom {
+class WindowFeatures;
+}  // namespace mojom
+}  // namespace blink
+
+namespace favicon_base {
+struct FaviconImageResult;
+}  // namespace favicon_base
+
+class BrowserWindowInterface;
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace views {
+class Widget;
+}  // namespace views
+
+class HeliumLinkPeekView;
+
+// Blocks popups inside the preview bubble: the bubble is self-contained, and
+// new windows belong in real tabs (openable explicitly from the bubble).
+class PreviewBlocker : public content::WebContentsDelegate {
+ public:
+  PreviewBlocker() = default;
+  PreviewBlocker(const PreviewBlocker&) = delete;
+  PreviewBlocker& operator=(const PreviewBlocker&) = delete;
+  ~PreviewBlocker() override;
+
+  content::WebContents* AddNewContents(
+      content::WebContents* source,
+      std::unique_ptr<content::WebContents> new_contents,
+      const GURL& target_url,
+      WindowOpenDisposition disposition,
+      const blink::mojom::WindowFeatures& window_features,
+      bool user_gesture,
+      bool* was_blocked) override;
+};
+
+// Native link peek: intercepting new-tab clicks and window.open() popups shows
+// a floating preview of the target page instead of navigating immediately.
+// Opening from the preview adopts the already-loaded WebContents (no reload),
+// and splitting inserts it into a real Helium split view. This replaces the
+// DiaPeek extension's content-script + iframe approach, which cannot run on
+// chrome:// pages or the new tab page and fakes splits with CSS.
+class HeliumLinkPeekController : public content::WebContentsObserver {
+ public:
+  DECLARE_USER_DATA(HeliumLinkPeekController);
+
+  static HeliumLinkPeekController* From(BrowserWindowInterface* browser);
+
+  explicit HeliumLinkPeekController(BrowserWindowInterface* browser);
+  HeliumLinkPeekController(const HeliumLinkPeekController&) = delete;
+  HeliumLinkPeekController& operator=(const HeliumLinkPeekController&) =
+      delete;
+  ~HeliumLinkPeekController() override;
+
+  // Interception entry points, called from BrowserWebContentsDelegate.
+  // Returns true when the navigation was consumed by a peek preview.
+  // |modifier_held| is true when Cmd/Ctrl/Alt is down: those clicks keep
+  // their native behavior (instant tab, context menu, native split).
+  // Middle-click (background tab) also keeps its native behavior; peek
+  // triggers on Shift+click and links that force a new foreground tab.
+  bool MaybePeek(content::WebContents* source,
+                 const GURL& url,
+                 WindowOpenDisposition disposition,
+                 bool modifier_held);
+  bool MaybePeekPopup(content::WebContents* source,
+                      const GURL& target_url,
+                      bool has_window_features,
+                      bool user_gesture,
+                      bool modifier_held);
+
+  void OpenInNewTab(bool foreground);
+  void OpenInSplit();
+  void CopyLink();
+  void Close();
+
+  bool IsShowing() const { return widget_ != nullptr; }
+
+  base::WeakPtr<HeliumLinkPeekController> GetWeakPtr();
+
+  // content::WebContentsObserver (observes the preview while visible):
+  void DidFinishNavigation(
+      content::NavigationHandle* navigation_handle) override;
+
+ private:
+  void Show(content::WebContents* source, const GURL& url);
+  void UpdateTitleAndIcon();
+  void OnWidgetClosed();
+  void FetchFavicons();
+  void OnFavicon(const favicon_base::FaviconImageResult& result);
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  // Owned by the widget (deleted on close); null when hidden.
+  raw_ptr<views::Widget> widget_ = nullptr;
+  raw_ptr<HeliumLinkPeekView> view_ = nullptr;
+  // The live preview. Adopted by the tab strip on open, destroyed on close.
+  std::unique_ptr<content::WebContents> preview_contents_;
+  GURL preview_url_;
+  PreviewBlocker preview_blocker_;
+  base::CancelableTaskTracker favicon_tracker_;
+  ui::ScopedUnownedUserData<HeliumLinkPeekController> scoped_unowned_user_data_;
+  base::WeakPtrFactory<HeliumLinkPeekController> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_HELIUM_HELIUM_LINK_PEEK_CONTROLLER_H_

