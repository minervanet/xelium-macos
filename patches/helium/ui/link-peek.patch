+namespace {
+
+// File types that download instead of rendering. Peeking those would either
+// start a download or show a viewer for a file the user wanted saved, so
+// they fall through to the normal path (same spirit as DiaPeek's blocklist).
+bool IsDownloadUrl(const GURL& url) {
+  const std::string spec = url.spec();
+  const size_t slash = spec.find_last_of('/');
+  const size_t dot = spec.find_last_of('.');
+  if (dot == std::string::npos ||
+      (slash != std::string::npos && dot < slash)) {
+    return false;
+  }
+  std::string ext =
+      base::ToLowerASCII(spec.substr(dot + 1, spec.find_first_of("?#", dot)));
+  if (ext.empty() || ext == "htm" || ext == "html" || ext == "xhtml") {
+    return false;
+  }
+  static constexpr const char* kBlocked[] = {
+      "exe", "msi", "dmg", "pkg", "apk", "zip", "rar",
+      "7z",  "tar", "gz",  "bz2", "xz",  "iso",
+  };
+  for (const char* blocked : kBlocked) {
+    if (ext == blocked) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+DEFINE_USER_DATA(HeliumLinkPeekController);
+
+PreviewBlocker::~PreviewBlocker() = default;
+
+content::WebContents* PreviewBlocker::AddNewContents(
+    content::WebContents* source,
+    std::unique_ptr<content::WebContents> new_contents,
+    const GURL& target_url,
+    WindowOpenDisposition disposition,
+    const blink::mojom::WindowFeatures& window_features,
+    bool user_gesture,
+    bool* was_blocked) {
+  // Popups inside the preview are swallowed; the bubble is self-contained.
+  if (was_blocked) {
+    *was_blocked = true;
+  }
+  return nullptr;
+}
+
+// static
+HeliumLinkPeekController* HeliumLinkPeekController::From(
+    BrowserWindowInterface* browser) {
+  if (!browser) {
+    return nullptr;
+  }
+  return HeliumLinkPeekController::Get(browser->GetUnownedUserDataHost());
+}
+
+HeliumLinkPeekController::HeliumLinkPeekController(
+    BrowserWindowInterface* browser)
+    : content::WebContentsObserver(nullptr),
+      browser_(browser),
+      scoped_unowned_user_data_(browser->GetUnownedUserDataHost(), *this) {}
+
+HeliumLinkPeekController::~HeliumLinkPeekController() = default;
+
+bool HeliumLinkPeekController::MaybePeek(content::WebContents* source,
+                                         const GURL& url,
+                                         WindowOpenDisposition disposition,
+                                         bool modifier_held) {
+  if (IsShowing() || modifier_held) {
+    return false;
+  }
+  if (disposition != WindowOpenDisposition::NEW_FOREGROUND_TAB &&
+      disposition != WindowOpenDisposition::NEW_WINDOW) {
+    return false;
+  }
+  if (!browser_->GetProfile()->GetPrefs()->GetBoolean(
+          prefs::kHeliumLinkPeekEnabled)) {
+    return false;
+  }
+  if (!url.SchemeIsHTTPOrHTTPS() || IsDownloadUrl(url)) {
+    return false;
+  }
+  Show(source, url);
+  return true;
+}
+
+bool HeliumLinkPeekController::MaybePeekPopup(content::WebContents* source,
+                                              const GURL& target_url,
+                                              bool has_window_features,
+                                              bool user_gesture,
+                                              bool modifier_held) {
+  if (IsShowing() || modifier_held || !user_gesture || has_window_features) {
+    return false;
+  }
+  if (!browser_->GetProfile()->GetPrefs()->GetBoolean(
+          prefs::kHeliumLinkPeekEnabled)) {
+    return false;
+  }
+  if (!target_url.SchemeIsHTTPOrHTTPS() || IsDownloadUrl(target_url)) {
+    return false;
+  }
+  // The renderer's own WebContents is discarded; the preview loads the target
+  // directly so open/split adopt the finished page with no reload.
+  Show(source, target_url);
+  return true;
+}
+
+void HeliumLinkPeekController::Show(content::WebContents* source,
+                                    const GURL& url) {
+  preview_url_ = url;
+  content::WebContents::CreateParams params(browser_->GetProfile());
+  preview_contents_ = content::WebContents::Create(params);
+  preview_contents_->SetDelegate(&preview_blocker_);
+
+  gfx::NativeView parent;
+  bool has_parent = false;
+  if (auto* tab_strip = browser_->GetTabStripModel()) {
+    if (content::WebContents* active = tab_strip->GetActiveWebContents()) {
+      parent = active->GetNativeView();
+      has_parent = true;
+    }
+  }
+  if (!has_parent && source) {
+    parent = source->GetNativeView();
+    has_parent = true;
+  }
+  if (!has_parent) {
+    preview_contents_.reset();
+    return;
+  }
+  view_ = HeliumLinkPeekView::Show(
+      parent, preview_contents_.get(), browser_->GetProfile(),
+      base::BindOnce(&HeliumLinkPeekController::OnWidgetClosed,
+                     weak_factory_.GetWeakPtr()),
+      base::BindRepeating(&HeliumLinkPeekController::OpenInNewTab,
+                          weak_factory_.GetWeakPtr()),
+      base::BindRepeating(&HeliumLinkPeekController::OpenInSplit,
+                          weak_factory_.GetWeakPtr()),
+      base::BindRepeating(&HeliumLinkPeekController::CopyLink,
+                          weak_factory_.GetWeakPtr()));
+  widget_ = view_->GetWidget();
+  // Navigate only after the preview is attached to the bubble's WebView, so
+  // the renderer creates its view at the real popup size and paints the
+  // first frame there. Navigating while detached leaves a blank bubble: the
+  // page commits at 0x0 and only paints once adopted into a tab.
+  Observe(preview_contents_.get());
+  content::NavigationController::LoadURLParams load_params(url);
+  load_params.transition_type = ui::PAGE_TRANSITION_LINK;
+  preview_contents_->GetController().LoadURLWithParams(load_params);
+  UpdateTitleAndIcon();
+}
+
+void HeliumLinkPeekController::OpenInNewTab(bool foreground) {
+  if (!preview_contents_) {
+    return;
+  }
+  TabStripModel* tab_strip = browser_->GetTabStripModel();
+  if (!tab_strip) {
+    return;
+  }
+  const int index = tab_strip->active_index() + 1;
+  const int add_types =
+      foreground ? AddTabTypes::ADD_ACTIVE : AddTabTypes::ADD_NONE;
+  auto group = tab_strip->GetTabGroupForTab(tab_strip->active_index());
+  auto contents = std::move(preview_contents_);
+  Observe(nullptr);
+  view_->DetachPreview();
+  tab_strip->InsertWebContentsAt(index, std::move(contents), add_types, group);
+  Close();
+}
+
+void HeliumLinkPeekController::OpenInSplit() {
+  if (!preview_contents_) {
+    return;
+  }
+  TabStripModel* tab_strip = browser_->GetTabStripModel();
+  if (!tab_strip) {
+    return;
+  }
+  const int active_index = tab_strip->active_index();
+  auto group = tab_strip->GetTabGroupForTab(active_index);
+  auto contents = std::move(preview_contents_);
+  Observe(nullptr);
+  view_->DetachPreview();
+  const int new_index = tab_strip->InsertWebContentsAt(
+      active_index + 1, std::move(contents), AddTabTypes::ADD_ACTIVE, group);
+  tab_strip->AddToNewSplit(
+      {active_index, new_index},
+      split_tabs::SplitTabVisualData(split_tabs::SplitTabLayout::kSideBySide),
+      split_tabs::SplitTabCreatedSource::kLinkClick);
+  Close();
+}
+
+void HeliumLinkPeekController::CopyLink() {
+  ui::ScopedClipboardWriter writer(ui::ClipboardBuffer::kCopyPaste);
+  writer.WriteText(base::UTF8ToUTF16(preview_url_.spec()));
+}
+
+void HeliumLinkPeekController::Close() {
+  if (!widget_) {
+    return;
+  }
+  views::Widget* widget = widget_;
+  widget_ = nullptr;
+  view_ = nullptr;
+  widget->Close();
+}
+
+void HeliumLinkPeekController::OnWidgetClosed() {
+  widget_ = nullptr;
+  view_ = nullptr;
+  Observe(nullptr);
+  preview_contents_.reset();
+}
+
+void HeliumLinkPeekController::UpdateTitleAndIcon() {
+  if (!view_ || !preview_contents_) {
+    return;
+  }
+  std::u16string title = preview_contents_->GetTitle();
+  if (title.empty()) {
+    title = base::UTF8ToUTF16(preview_url_.spec());
+  }
+  view_->SetTitle(title);
+  if (preview_url_.SchemeIsHTTPOrHTTPS()) {
+    if (favicon::FaviconService* favicons =
+            FaviconServiceFactory::GetForProfile(
+                browser_->GetProfile(),
+                ServiceAccessType::EXPLICIT_ACCESS)) {
+      favicons->GetFaviconImageForPageURL(
+          preview_url_,
+          base::BindOnce(&HeliumLinkPeekController::OnFavicon,
+                         weak_factory_.GetWeakPtr()),
+          &favicon_tracker_);
+    }
+  }
+}
+
+void HeliumLinkPeekController::OnFavicon(
+    const favicon_base::FaviconImageResult& result) {
+  if (!result.image.IsEmpty() && view_) {
+    view_->SetIcon(result.image);
+  }
+}
+
+void HeliumLinkPeekController::DidFinishNavigation(
+    content::NavigationHandle* navigation_handle) {
+  if (navigation_handle && navigation_handle->HasCommitted() &&
+      !navigation_handle->IsErrorPage()) {
+    UpdateTitleAndIcon();
+  }
+}
+
+base::WeakPtr<HeliumLinkPeekController> HeliumLinkPeekController::GetWeakPtr() {
+  return weak_factory_.GetWeakPtr();
+}

