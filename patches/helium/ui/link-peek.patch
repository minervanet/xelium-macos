+#include "ui/views/controls/button/label_button.h"
+#include "ui/views/controls/image_view.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/controls/webview/webview.h"
+#include "ui/views/focus/focus_manager.h"
+#include "ui/views/layout/box_layout.h"
+#include "ui/views/view_class_properties.h"
+#include "ui/views/widget/widget.h"
+#include "third_party/skia/include/core/SkColor.h"
+
+namespace {
+
+// The bubble covers most of the content area: 62% of the parent width and
+// 72% of its height, clamped so it stays usable on small windows and never
+// overwhelms large ones.
+constexpr int kBubbleRadius = 16;
+constexpr int kHeaderHeight = 40;
+constexpr int kIconSize = 16;
+constexpr int kActionButtonSize = 28;
+
+gfx::Size ComputePopupSize(const gfx::Rect& parent_bounds) {
+  const int width = std::clamp(
+      static_cast<int>(parent_bounds.width() * 0.62), 880, 1080);
+  const int height = std::clamp(
+      static_cast<int>(parent_bounds.height() * 0.72), 620, 800);
+  return gfx::Size(width, height);
+}
+
+views::ImageButton* ActionButton(const gfx::VectorIcon& icon,
+                                 const std::u16string& tooltip,
+                                 views::View* parent,
+                                 base::RepeatingClosure pressed) {
+  auto* button = parent->AddChildView(
+      std::make_unique<views::ImageButton>(std::move(pressed)));
+  button->SetImageModel(
+      views::Button::STATE_NORMAL,
+      ui::ImageModel::FromVectorIcon(icon, ui::kColorMenuIcon, kIconSize));
+  button->SetTooltipText(tooltip);
+  button->SetPreferredSize(gfx::Size(kActionButtonSize, kActionButtonSize));
+  button->SetImageHorizontalAlignment(views::ImageButton::ALIGN_CENTER);
+  button->SetImageVerticalAlignment(views::ImageButton::ALIGN_MIDDLE);
+  return button;
+}
+
+}  // namespace
+
+// static
+HeliumLinkPeekView* HeliumLinkPeekView::Show(
+    gfx::NativeView parent,
+    content::WebContents* preview,
+    Profile* profile,
+    base::OnceClosure on_closed,
+    base::RepeatingCallback<void(bool)> on_open_tab,
+    base::RepeatingClosure on_open_split,
+    base::RepeatingClosure on_copy_link) {
+  const gfx::Rect parent_bounds =
+      views::Widget::GetWidgetForNativeView(parent)->GetWindowBoundsInScreen();
+  const gfx::Size popup_size = ComputePopupSize(parent_bounds);
+  auto delegate = std::unique_ptr<HeliumLinkPeekView>(new HeliumLinkPeekView(
+      parent, preview, profile, popup_size, std::move(on_closed),
+      std::move(on_open_tab), std::move(on_open_split),
+      std::move(on_copy_link)));
+  HeliumLinkPeekView* view = delegate.get();
+  views::Widget* widget = new views::Widget;
+  views::Widget::InitParams params(
+      views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_POPUP);
+  params.parent = parent;
+  params.delegate = delegate.release();
+  params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+  params.shadow_type = views::Widget::InitParams::ShadowType::kDrop;
+  params.activatable = views::Widget::InitParams::Activatable::kYes;
+  widget->Init(std::move(params));
+
+  widget->SetBounds(gfx::Rect(
+      parent_bounds.x() + (parent_bounds.width() - popup_size.width()) / 2,
+      parent_bounds.y() + parent_bounds.height() / 8, popup_size.width(),
+      popup_size.height()));
+  widget->Show();
+  widget->AddObserver(view);
+  widget->GetFocusManager()->RegisterAccelerator(
+      ui::Accelerator(ui::VKEY_ESCAPE, ui::EF_NONE),
+      ui::AcceleratorManager::kNormalPriority, view);
+  view->web_view_->RequestFocus();
+  return view;
+}
+
+HeliumLinkPeekView::HeliumLinkPeekView(
+    gfx::NativeView parent,
+    content::WebContents* preview,
+    Profile* profile,
+    const gfx::Size& popup_size,
+    base::OnceClosure on_closed,
+    base::RepeatingCallback<void(bool)> on_open_tab,
+    base::RepeatingClosure on_open_split,
+    base::RepeatingClosure on_copy_link)
+    : on_closed_(std::move(on_closed)),
+      on_open_tab_(std::move(on_open_tab)),
+      on_open_split_(std::move(on_open_split)),
+      on_copy_link_(std::move(on_copy_link)) {
+  SetModalType(ui::mojom::ModalType::kNone);
+  auto contents = std::make_unique<views::View>();
+  contents->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(8), 4));
+  contents->SetBackground(views::CreateRoundedRectBackground(
+      ui::kColorBubbleBackground, kBubbleRadius));
+  contents->SetBorder(views::CreateRoundedRectBorder(
+      1, kBubbleRadius, ui::kColorBubbleBorder));
+
+  auto* header = contents->AddChildView(std::make_unique<views::View>());
+  header->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets::VH(0, 4), 8));
+  header->SetPreferredSize(gfx::Size(popup_size.width(), kHeaderHeight));
+  icon_ = header->AddChildView(std::make_unique<views::ImageView>());
+  icon_->SetPreferredSize(gfx::Size(kIconSize, kIconSize));
+  icon_->SetImageSize(gfx::Size(kIconSize, kIconSize));
+  icon_->SetVerticalAlignment(views::ImageView::Alignment::kCenter);
+  icon_->SetImage(ui::ImageModel::FromVectorIcon(
+      kGlobeIcon, ui::kColorMenuIcon, kIconSize));
+  title_ = header->AddChildView(std::make_unique<views::Label>());
+  title_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  title_->SetElideBehavior(gfx::ELIDE_TAIL);
+  title_->SetProperty(
+      views::kFlexBehaviorKey,
+      views::FlexSpecification(views::MinimumFlexSizeRule::kScaleToZero,
+                               views::MaximumFlexSizeRule::kUnbounded));
+  ActionButton(kOpenInNewIcon, u"Open in new tab", header,
+               base::BindRepeating(
+                   [](HeliumLinkPeekView* view) {
+                     view->on_open_tab_.Run(true);
+                   },
+                   base::Unretained(this)));
+  ActionButton(kSplitSceneIcon, u"Open in split view", header,
+               base::BindRepeating(
+                   [](HeliumLinkPeekView* view) { view->on_open_split_.Run(); },
+                   base::Unretained(this)));
+  ActionButton(vector_icons::kContentCopyIcon, u"Copy link", header,
+               base::BindRepeating(
+                   [](HeliumLinkPeekView* view) { view->on_copy_link_.Run(); },
+                   base::Unretained(this)));
+  ActionButton(kCloseIcon, u"Close", header,
+               base::BindRepeating(
+                   [](HeliumLinkPeekView* view) { view->Close(); },
+                   base::Unretained(this)));
+
+  auto web_view = std::make_unique<views::WebView>(profile);
+  web_view->SetWebContents(preview);
+  // No fixed height: flex fills whatever the fixed-size popup leaves over.
+  web_view->SetProperty(
+      views::kFlexBehaviorKey,
+      views::FlexSpecification(views::MinimumFlexSizeRule::kScaleToZero,
+                               views::MaximumFlexSizeRule::kUnbounded));
+  web_view_ = web_view.get();
+  contents->AddChildView(std::move(web_view));
+  SetContentsView(std::move(contents));
+}
+
+HeliumLinkPeekView::~HeliumLinkPeekView() {
+  if (GetWidget() && GetWidget()->GetFocusManager()) {
+    GetWidget()->GetFocusManager()->UnregisterAccelerators(this);
+  }
+}
+
+void HeliumLinkPeekView::Close() {
+  if (GetWidget()) {
+    GetWidget()->Close();
+  }
+}
+
+void HeliumLinkPeekView::DetachPreview() {
+  if (web_view_ && web_view_->GetWebContents()) {
+    web_view_->SetWebContents(nullptr);
+  }
+}
+
+void HeliumLinkPeekView::SetTitle(const std::u16string& title) {
+  if (title_) {
+    title_->SetText(title.empty() ? u"Loading\u2026" : title);
+  }
+}
+
+void HeliumLinkPeekView::SetIcon(const gfx::Image& image) {
+  if (!image.IsEmpty() && icon_) {
+    icon_->SetImage(ui::ImageModel::FromImageSkia(*image.ToImageSkia()));
+  }
+}
+
+bool HeliumLinkPeekView::AcceleratorPressed(const ui::Accelerator& accelerator) {
+  if (accelerator.key_code() == ui::VKEY_ESCAPE) {
+    Close();
+    return true;
+  }
+  return false;
+}
+
+bool HeliumLinkPeekView::CanHandleAccelerators() const {
+  return true;
+}
+
+void HeliumLinkPeekView::WindowClosing() {
+  if (GetWidget()) {
+    GetWidget()->RemoveObserver(this);
+  }
+  std::move(on_closed_).Run();
+}
+
+void HeliumLinkPeekView::OnWidgetActivationChanged(views::Widget* widget,
+                                                   bool active) {
+  if (!active) {
+    Close();
+  }
+}

