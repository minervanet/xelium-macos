+
+HeliumWorkspaceMenuModel::HeliumWorkspaceMenuModel(
+    BrowserWindowInterface* browser,
+    TabStripModel* tab_strip,
+    int context_index)
+    : ui::SimpleMenuModel(this),
+      browser_(browser),
+      tab_strip_(tab_strip),
+      context_index_(context_index) {
+  Build();
+}
+
+HeliumWorkspaceMenuModel::~HeliumWorkspaceMenuModel() = default;
+
+void HeliumWorkspaceMenuModel::Build() {
+  HeliumWorkspaceController* controller =
+      HeliumWorkspaceController::From(browser_);
+  if (!controller || !controller->IsAvailable()) {
+    return;
+  }
+  int command_id = kMinCommandId;
+  for (const auto& entry : controller->GetWorkspaces()) {
+    if (entry.active || command_id >= kMaxCommandId) {
+      continue;
+    }
+    workspace_ids_.push_back(entry.id);
+    AddItem(command_id++, base::UTF8ToUTF16(entry.name));
+  }
+  if (!workspace_ids_.empty()) {
+    AddSeparator(ui::NORMAL_SEPARATOR);
+  }
+  AddItem(kNewWorkspaceCommandId,
+          l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_NEW));
+}
+
+bool HeliumWorkspaceMenuModel::IsCommandIdChecked(int command_id) const {
+  return false;
+}
+
+bool HeliumWorkspaceMenuModel::IsCommandIdEnabled(int command_id) const {
+  HeliumWorkspaceController* controller =
+      HeliumWorkspaceController::From(browser_);
+  if (!controller || !controller->IsAvailable()) {
+    return false;
+  }
+  if (command_id == kNewWorkspaceCommandId) {
+    return !controller->HasPendingLoad();
+  }
+  const int index = command_id - kMinCommandId;
+  return index >= 0 &&
+         static_cast<size_t>(index) < workspace_ids_.size() &&
+         !controller->HasPendingLoad() && tab_strip_ &&
+         context_index_ >= 0 && context_index_ < tab_strip_->count();
+}
+
+bool HeliumWorkspaceMenuModel::GetAcceleratorForCommandId(
+    int command_id,
+    ui::Accelerator* accelerator) const {
+  return false;
+}
+
+void HeliumWorkspaceMenuModel::ExecuteCommand(int command_id,
+                                             int event_flags) {
+  HeliumWorkspaceController* controller =
+      HeliumWorkspaceController::From(browser_);
+  if (!controller || !controller->IsAvailable() || !tab_strip_) {
+    return;
+  }
+  if (command_id == kNewWorkspaceCommandId) {
+    controller->MoveTabsToNewWorkspace(context_index_);
+    return;
+  }
+  const int index = command_id - kMinCommandId;
+  if (index < 0 || static_cast<size_t>(index) >= workspace_ids_.size() ||
+      context_index_ < 0 || context_index_ >= tab_strip_->count()) {
+    return;
+  }
+  controller->MoveTabsToWorkspace(workspace_ids_[index], context_index_);
+}

