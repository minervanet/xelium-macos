+#ifndef CHROME_BROWSER_UI_HELIUM_HELIUM_WORKSPACE_SERVICE_H_
+#define CHROME_BROWSER_UI_HELIUM_HELIUM_WORKSPACE_SERVICE_H_
+
+#include <map>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/time/time.h"
+#include "components/keyed_service/core/keyed_service.h"
+#include "components/sessions/core/session_command.h"
+#include "components/tab_groups/tab_group_color.h"
+
+class Profile;
+
+namespace sessions {
+class CommandStorageBackend;
+}  // namespace sessions
+
+// Profile-scoped store for Workspaces (Settings > Appearance > Workspaces).
+//
+// Each workspace keeps its metadata (name, modification time) in profile prefs
+// and its tabs as Chromium session commands in
+//   {profile}/helium_workspaces/{workspace_id}/
+// written through a CommandStorageBackend on a background sequenced runner.
+// Reads never touch the UI thread's message loop and writes never activate,
+// focus or otherwise disturb any browser window.
+//
+// Workspace ids are stable opaque strings ("default" for the built-in
+// workspace, random tokens otherwise) so renames never move data on disk.
+// Only the window that owns a workspace's live tabs ever writes that
+// workspace; concurrent same-workspace edits from two windows are
+// last-writer-wins.
+class HeliumWorkspaceService : public KeyedService {
+ public:
+  struct WorkspaceInfo {
+    std::string id;
+    std::string name;
+    base::Time modified_at;
+    // Tab count from the last save; -1 when never saved.
+    int tab_count = -1;
+    // Accent color picked for the workspace's dot; grey by default.
+    tab_groups::TabGroupColorId color = tab_groups::TabGroupColorId::kGrey;
+  };
+
+  using LoadCallback = base::OnceCallback<void(
+      std::vector<std::unique_ptr<sessions::SessionCommand>>)>;
+
+  explicit HeliumWorkspaceService(Profile* profile);
+  HeliumWorkspaceService(const HeliumWorkspaceService&) = delete;
+  HeliumWorkspaceService& operator=(const HeliumWorkspaceService&) = delete;
+  ~HeliumWorkspaceService() override;
+
+  // Workspaces in display order. Entries with broken metadata are skipped,
+  // never fatal.
+  std::vector<WorkspaceInfo> ListWorkspaces() const;
+  bool HasWorkspace(const std::string& id) const;
+  std::string GetWorkspaceName(const std::string& id) const;
+
+  // Creates or replaces the metadata entry for |id| and writes |commands| to
+  // disk, truncating any previous file. Metadata is updated synchronously;
+  // the file write completes on the background runner.
+  void SaveWorkspace(
+      const std::string& id,
+      const std::string& name,
+      std::vector<std::unique_ptr<sessions::SessionCommand>> commands,
+      int tab_count);
+
+  // Updates the stored name without touching the tab data on disk.
+  // Returns false when |id| is unknown, |name| is empty or |name| collides
+  // with another workspace.
+  bool RenameWorkspace(const std::string& id, const std::string& name);
+
+  // Changes the workspace's accent color without touching tab data.
+  bool SetWorkspaceColor(const std::string& id,
+                         tab_groups::TabGroupColorId color);
+
+  // Moves |id| to |new_index| in the display order (clamped). Returns false
+  // when |id| is unknown.
+  bool ReorderWorkspace(const std::string& id, int new_index);
+
+  // Reads the stored commands and invokes |callback| on the UI thread. The
+  // callback receives an empty vector when nothing was ever saved or the file
+  // is unreadable; callers must fall back to a fresh empty workspace.
+  void LoadWorkspace(const std::string& id, LoadCallback callback);
+
+  // Drops the metadata entry and deletes the on-disk directory. The active
+  // workspace pointer is cleared when it referenced |id|.
+  void DeleteWorkspace(const std::string& id);
+
+  std::string GetActiveWorkspaceId() const;
+  void SetActiveWorkspaceId(const std::string& id);
+
+  base::WeakPtr<HeliumWorkspaceService> GetWeakPtr();
+
+  // KeyedService:
+  void Shutdown() override;
+
+ private:
+  base::FilePath GetWorkspacePath(const std::string& id) const;
+  scoped_refptr<sessions::CommandStorageBackend> GetBackend(
+      const std::string& id);
+
+  raw_ptr<Profile> profile_;
+  const base::FilePath workspaces_path_;
+  scoped_refptr<base::SequencedTaskRunner> io_task_runner_;
+  std::map<std::string, scoped_refptr<sessions::CommandStorageBackend>>
+      backends_;
+  base::WeakPtrFactory<HeliumWorkspaceService> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_HELIUM_HELIUM_WORKSPACE_SERVICE_H_

