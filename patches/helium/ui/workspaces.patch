+// Size of the dot hit area; the painted dot is smaller.
+constexpr int kDotHitSize = 24;
+constexpr int kDotRadius = 6;
+constexpr int kDotRingWidth = 2;
+
+std::u16string TooltipFor(const std::string& name,
+                          bool active,
+                          int tab_count) {
+  std::u16string tooltip = base::UTF8ToUTF16(name);
+  if (tab_count >= 0) {
+    tooltip += u" (" + base::UTF8ToUTF16(base::NumberToString(tab_count)) +
+               u")";
+  }
+  if (active) {
+    tooltip += u" — " + l10n_util::GetStringUTF16(
+                               IDS_HELIUM_WORKSPACE_ACTIVE);
+  }
+  return tooltip;
+}
