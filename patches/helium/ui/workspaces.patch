+
+#include "chrome/browser/ui/helium/helium_workspace_service_factory.h"
+
+#include <memory>
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/helium/helium_workspace_service.h"
+#include "components/keyed_service/core/keyed_service.h"
+
+// static
+HeliumWorkspaceService* HeliumWorkspaceServiceFactory::GetForProfile(
+    Profile* profile) {
+  return static_cast<HeliumWorkspaceService*>(
+      GetInstance()->GetServiceForBrowserContext(profile, /*create=*/true));
+}
+
+// static
+HeliumWorkspaceService* HeliumWorkspaceServiceFactory::GetForProfileIfExisting(
+    Profile* profile) {
+  return static_cast<HeliumWorkspaceService*>(
+      GetInstance()->GetServiceForBrowserContext(profile, /*create=*/false));
+}
+
+// static
+HeliumWorkspaceServiceFactory* HeliumWorkspaceServiceFactory::GetInstance() {
+  static base::NoDestructor<HeliumWorkspaceServiceFactory> instance;
+  return instance.get();
+}
+
+HeliumWorkspaceServiceFactory::HeliumWorkspaceServiceFactory()
+    : ProfileKeyedServiceFactory(
+          "HeliumWorkspaceService",
+          ProfileSelections::Builder()
+              .WithRegular(ProfileSelection::kOriginalOnly)
+              .Build()) {}
+
+HeliumWorkspaceServiceFactory::~HeliumWorkspaceServiceFactory() = default;
+
+std::unique_ptr<KeyedService>
+HeliumWorkspaceServiceFactory::BuildServiceInstanceForBrowserContext(
+    content::BrowserContext* context) const {
+  return std::make_unique<HeliumWorkspaceService>(
+      Profile::FromBrowserContext(context));
+}
+
+bool HeliumWorkspaceServiceFactory::ServiceIsNULLWhileTesting() const {
+  // The service owns a sequenced task runner for real profile-directory disk
+  // I/O; unit tests must not construct it implicitly.
+  return true;
+}

