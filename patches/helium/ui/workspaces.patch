+std::vector<HeliumWorkspaceController::SwitcherTab>
+HeliumWorkspaceController::GetLoadedTabs() const {
+  std::vector<SwitcherTab> out;
+  if (!IsAvailable()) {
+    return out;
+  }
+  HeliumWorkspaceService* service = GetService();
+  TabStripModel* tab_strip = GetTabStripModel();
+  if (!service || !tab_strip) {
+    return out;
+  }
+  auto append_snapshot = [&out](const Snapshot& snapshot,
+                                const std::string& id) {
+    for (const auto& item : snapshot.live_items) {
+      if (std::holds_alternative<std::unique_ptr<DetachedTab>>(item)) {
+        tabs::TabInterface* tab =
+            std::get<std::unique_ptr<DetachedTab>>(item)->tab.get();
+        if (tab && tab->GetContents()) {
+          out.push_back({tab->GetContents(), id, false});
+        }
+        continue;
+      }
+      ForEachDetachedTab(
+          *std::get<std::unique_ptr<DetachedTabCollection>>(item),
+          [&out, &id](tabs::TabInterface* tab) {
+            if (tab && tab->GetContents()) {
+              out.push_back({tab->GetContents(), id, false});
+            }
+          });
+    }
+    for (const auto& flat : snapshot.flat_tabs) {
+      if (flat.model && flat.model->GetContents()) {
+        out.push_back({flat.model->GetContents(), id, false});
+      }
+    }
+  };
+
+  // The active workspace's tabs are in the strip, in strip order.
+  for (int i = 0; i < tab_strip->count(); ++i) {
+    if (content::WebContents* contents = tab_strip->GetWebContentsAt(i)) {
+      out.push_back({contents, active_id_, true});
+    }
+  }
+  // Then every other workspace that is already loaded, in workspace order.
+  for (const auto& info : service->ListWorkspaces()) {
+    if (info.id == active_id_) {
+      continue;
+    }
+    if (auto it = snapshots_.find(info.id); it != snapshots_.end()) {
+      append_snapshot(it->second, info.id);
+    }
+    if (auto it = pending_moves_.find(info.id); it != pending_moves_.end()) {
+      for (const auto& flat : it->second.tabs) {
+        if (flat.model && flat.model->GetContents()) {
+          out.push_back({flat.model->GetContents(), info.id, false});
+        }
+      }
+    }
+  }
+  return out;
+}
+
+bool HeliumWorkspaceController::SwitchToWorkspace(const std::string& id) {
+  if (!IsAvailable() || id.empty() || id == active_id_ || load_in_flight_) {
+    return false;
+  }
+  HeliumWorkspaceService* service = GetService();
+  TabStripModel* tab_strip = GetTabStripModel();
+  if (!service || !tab_strip || tab_strip->count() == 0 ||
+      !service->HasWorkspace(id)) {
+    return false;
+  }
+
+  // Unload workspaces that have been idle for a long time before switching;
+  // the visual tab switcher is not open at this point, so no raw pointers to
+  // those tabs remain.
+  MaybeDiscardInactiveWorkspaces(id);
+
+  // Persist what is visible now before hiding it.
+  SaveActiveWorkspace();
+
+  if (auto it = snapshots_.find(id); it != snapshots_.end()) {
+    Snapshot snapshot = std::move(it->second);
+    snapshots_.erase(it);
+    // Capture the source tabs by identity: inserting the replacement below
+    // may shift their positions. Pinned tabs stay visible in every workspace.
+    std::vector<tabs::TabInterface*> source_tabs;
+    bool has_pinned_tabs = false;
+    for (int i = 0; i < tab_strip->count(); ++i) {
+      if (tab_strip->IsTabPinned(i)) {
+        has_pinned_tabs = true;
+      } else {
+        source_tabs.push_back(tab_strip->GetTabAtIndex(i));
+      }
+    }
+    // An empty target plus no shared pinned tabs would leave the strip empty
+    // (closing the window), so give the new workspace a fresh tab.
+    if (snapshot.TabCount() == 0 && !has_pinned_tabs) {
+      chrome::NewTab(browser_, NewTabTypes::kNewTabCommand);
+    }
+    InsertSnapshot(std::move(snapshot));
+    ParkSnapshot(active_id_, DetachVisibleTabs(source_tabs));
+    active_id_ = id;
+    service->SetActiveWorkspaceId(id);
+    NotifyChanged();
+    return true;
+  }
+
+  // Materialize from disk asynchronously. The visible tabs stay put until the
+  // replacement is ready so the strip never empties (which would close the
+  // window).
+  load_in_flight_ = true;
+  pending_switch_ = id;
+  const int sequence = ++switch_sequence_;
+  service->LoadWorkspace(
+      id, base::BindOnce(&HeliumWorkspaceController::OnWorkspaceLoaded,
+                         weak_factory_.GetWeakPtr(), id, sequence));
+  return true;
+}
+
+std::string HeliumWorkspaceController::CreateWorkspace() {
+  if (!IsAvailable()) {
+    return std::string();
+  }
+  TabStripModel* tab_strip = GetTabStripModel();
+  HeliumWorkspaceService* service = GetService();
+  if (!tab_strip || !service || tab_strip->count() == 0) {
+    return std::string();
+  }
+  EnsureWorkspaces();
+  const std::string id = base::UnguessableToken::Create().ToString();
+  std::string name = "Workspace";
+  int suffix = static_cast<int>(service->ListWorkspaces().size()) + 1;
+  auto name_taken = [&](const std::string& candidate) {
+    for (const auto& info : service->ListWorkspaces()) {
+      if (info.name == candidate) {
+        return true;
+      }
+    }
+    return false;
+  };
+  while (name_taken(name)) {
+    name = "Workspace " + base::NumberToString(suffix++);
+  }
+  // Open the new workspace's first tab first so detaching never empties the
+  // strip (which would close the window). The new tab stays visible; the
+  // previous workspace's unpinned tabs are parked under the old workspace.
+  // Pinned tabs belong to every workspace and stay visible.
+  std::vector<tabs::TabInterface*> source_tabs;
+  int old_active_index = 0;
+  int unpinned_position = 0;
+  const int live_active_index = tab_strip->active_index();
+  for (int i = 0; i < tab_strip->count(); ++i) {
+    if (tab_strip->IsTabPinned(i)) {
+      continue;
+    }
+    source_tabs.push_back(tab_strip->GetTabAtIndex(i));
+    if (i == live_active_index) {
+      old_active_index = unpinned_position;
+    }
+    ++unpinned_position;
+  }
+  SaveActiveWorkspace();
+  chrome::NewTab(browser_, NewTabTypes::kNewTabCommand);
+  Snapshot parked = DetachVisibleTabs(source_tabs);
+  parked.active_index =
+      std::clamp(old_active_index, 0,
+                 std::max(0, parked.TabCount() - 1));
+  snapshots_[active_id_] = std::move(parked);
+  service->SaveWorkspace(id, name, {}, /*tab_count=*/1);
+  active_id_ = id;
+  service->SetActiveWorkspaceId(id);
+  NotifyChanged();
+  return id;
+}
