+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "components/sessions/core/session_command.h"
+#include "components/tab_groups/tab_group_id.h"
+#include "components/tab_groups/tab_group_visual_data.h"
+#include "ui/base/unowned_user_data/scoped_unowned_user_data.h"
+
+class BrowserWindowInterface;
+class HeliumWorkspaceService;
+class PrefService;
+
+namespace tabs {
+class TabInterface;
+class TabModel;
+}  // namespace tabs
+
+// Per-window Workspaces controller (Settings > Appearance > Workspaces).
+//
+// Several workspaces live inside ONE window. Switching hides the current
+// workspace's tabs by detaching them from the TabStripModel into memory and
+// inserts the target workspace's tabs, so tabs are never closed or reloaded
+// by a switch. Tab groups (names, colors, collapsed state), splits, pinned
+// state and tab order survive in-session switches through Chromium's detached
+// tab collections.
+//
+// Every switch, move and metadata change also serializes the affected
+// workspace as session commands through HeliumWorkspaceService, so inactive
+// workspaces survive a restart and are materialized on first use. Anything
+// unreadable recovers to a single fresh workspace instead of crashing.
+//
+// The controller is owned by BrowserWindowFeatures and intentionally observes
+// neither the tab strip nor individual tabs: saves happen at switch/move
+// time from fully-known state, which avoids observer-lifetime hazards and
+// backgrounding the window. With the feature disabled (or in private and
+// non-normal windows) the controller is inert and the tab strip is untouched.
+class HeliumWorkspaceController {
+ public:
+  DECLARE_USER_DATA(HeliumWorkspaceController);
+
+  static HeliumWorkspaceController* From(BrowserWindowInterface* browser);
+
+  HeliumWorkspaceController(BrowserWindowInterface* browser,
+                            PrefService* pref_service);
+  HeliumWorkspaceController(const HeliumWorkspaceController&) = delete;
+  HeliumWorkspaceController& operator=(const HeliumWorkspaceController&) =
+      delete;
+  ~HeliumWorkspaceController();
+
+  struct WorkspaceEntry {
+    std::string id;
+    std::string name;
+    bool active = false;
+    // Live or snapshot tab count; -1 when known only from possibly stale
+    // on-disk metadata.
+    int tab_count = -1;
+  };
+  std::vector<WorkspaceEntry> GetWorkspaces() const;
+
+  // False when workspaces are disabled, or for private / non-normal windows.
+  // Every mutating method below is a no-op returning failure when false.
+  bool IsAvailable() const;
+
+  const std::string& active_workspace_id() const { return active_id_; }
+  bool HasPendingLoad() const { return load_in_flight_; }
+
+  // Makes |id| the visible workspace. Returns false when unavailable,
+  // unknown, already active or (for disk-backed workspaces) while the
+  // previous load is still in flight; the load itself completes
+  // asynchronously.
+  bool SwitchToWorkspace(const std::string& id);
+
+  // Creates a new workspace with a single fresh tab and switches to it.
+  // Returns the new id, or empty on failure.
+  std::string CreateWorkspace();
+
+  bool RenameWorkspace(const std::string& id, const std::string& name);
+  bool DeleteWorkspace(const std::string& id);
+
+  // Moves the selected tabs (or |index| when it is not selected) into |id|.
+  // |id| may be inactive; its tabs are loaded first when necessary.
+  bool MoveTabsToWorkspace(const std::string& id, int index);
+  // Moves the selected tabs (or |index|) into a brand-new workspace without
+  // switching to it. Returns the new id, or empty on failure.
+  std::string MoveTabsToNewWorkspace(int index);
+
+  using ChangedCallback = base::RepeatingCallback<void()>;
+  base::CallbackListSubscription AddObserver(ChangedCallback callback);
+
+  base::WeakPtr<HeliumWorkspaceController> GetWeakPtr();
+
+ private:
+  // Live-detached tabs, in strip order. Groups and splits detached whole
+  // stay whole through their collections.
+  using LiveItem = std::variant<std::unique_ptr<DetachedTab>,
+                                std::unique_ptr<DetachedTabCollection>>;
+  struct FlatTab {
+    std::unique_ptr<tabs::TabModel> model;
+    bool pinned = false;
+    // Index into Snapshot::group_visuals; nullopt when ungrouped. Splits are
+    // flattened on a disk round-trip and regrouped plainly.
+    std::optional<int> group_slot;
+  };
+  struct Snapshot {
+    std::vector<LiveItem> live_items;
+    std::vector<FlatTab> flat_tabs;
+    // Parallel to group slots; empty when the workspace has no groups.
+    std::vector<tab_groups::TabGroupVisualData> group_visuals;
+    // Maps a live (possibly detached) group id to its slot.
+    std::map<tab_groups::TabGroupId, int> group_slots;
+    int active_index = 0;
+    int TabCount() const;
+  };
+
+  // Detaches |indices| (selected tabs, or a single tab) from the visible
+  // strip as flat models, opening a fresh tab first when the whole strip is
+  // moving so the strip never empties. Returns nullopt when there is nothing
+  // to detach.
+  struct DetachedSelection {
+    std::vector<FlatTab> tabs;
+    std::vector<tab_groups::TabGroupVisualData> visuals;
+  };
+  std::optional<DetachedSelection> DetachIndices(std::vector<int> indices);
+
+  HeliumWorkspaceService* GetService() const;
+  TabStripModel* GetTabStripModel() const;
+
+  // Adopts the current tabs into the active workspace and guarantees the
+  // default workspace exists. Never moves tabs.
+  void EnsureWorkspaces();
+  void OnEnabledPrefChanged();
+
+  // Serializes the visible strip and stores it via the service under the
+  // active workspace id.
+  void SaveActiveWorkspace();
+  // Serializes the in-memory |snapshots_[id]| and stores it via the service.
+  // No-op when |id| has no snapshot.
+  void SaveSnapshot(const std::string& id);
+
+  // Detaches |tabs_to_detach| (captured from the visible strip before
+  // replacement tabs were inserted) into a snapshot (order, groups, splits,
+  // pinned state and active index preserved). The strip must hold other tabs
+  // afterwards; this must never leave the strip empty.
+  Snapshot DetachVisibleTabs(
+      const std::vector<tabs::TabInterface*>& tabs_to_detach);
+
+  // Inserts |snapshot| at the end of the visible strip and activates its
+  // recorded active tab. The strip must be non-empty.
+  void InsertSnapshot(Snapshot snapshot);
+
+  // Builds detached models for a workspace parsed from disk.
+  Snapshot SnapshotFromSerialized(
+      std::unique_ptr<struct HeliumSerializedWorkspace> parsed);
+
+  void OnWorkspaceLoaded(const std::string& id,
+                         int switch_sequence,
+                         std::vector<std::unique_ptr<sessions::SessionCommand>>
+                             commands);
+  void NotifyChanged();
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<PrefService> pref_service_;
+  PrefChangeRegistrar pref_registrar_;
+
+  // In-memory tabs of inactive workspaces, keyed by workspace id. The active
+  // workspace's tabs always live in the tab strip, never here.
+  std::map<std::string, Snapshot> snapshots_;
+  // Tabs moved into a workspace whose disk state has not loaded yet. Merged
+  // into the snapshot when the load completes.
+  struct PendingMove {
+    std::vector<FlatTab> tabs;
+    std::vector<tab_groups::TabGroupVisualData> visuals;
+  };
+  std::map<std::string, PendingMove> pending_moves_;
+  // Set while a disk load for a workspace switch is outstanding.
+  std::optional<std::string> pending_switch_;
+
+  std::string active_id_;
+  bool load_in_flight_ = false;
+  int switch_sequence_ = 0;
+
+  base::RepeatingCallbackList<void()> observers_;
+  base::WeakPtrFactory<HeliumWorkspaceController> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_HELIUM_HELIUM_WORKSPACE_CONTROLLER_H_

