+// Owns one HeliumWorkspaceService per regular (non-incognito) profile.
+// The service is created lazily on first use and performs no disk I/O until
+// a workspace is actually saved or loaded.
+class HeliumWorkspaceServiceFactory : public ProfileKeyedServiceFactory {
+ public:
