+                    base::RepeatingCallback<void(const std::string&,
+                                                 const gfx::Point&)>
+                        on_drag_finished)
+      : browser_(browser),
+        id_(id),
+        active_(active),
+        color_(color),
+        on_drag_finished_(std::move(on_drag_finished)) {
+    SetPreferredSize(gfx::Size(hit_size, hit_size));
+    SetTooltipText(TooltipFor(name, active, tab_count));
+    GetViewAccessibility().SetRole(ax::mojom::Role::kButton);
+    GetViewAccessibility().SetName(base::UTF8ToUTF16(name));
+    SetFocusBehavior(FocusBehavior::ACCESSIBLE_ONLY);
+  }
+  ~WorkspaceItemView() override = default;
+
+  bool IsActive() const { return active_; }
+  void SetActive(bool active) { active_ = active; }
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override {
+    views::View::OnPaint(canvas);
+    const gfx::PointF center(GetLocalBounds().CenterPoint());
+    const ui::ColorId color_id =
+        GetTabGroupContextMenuColorId(color_);
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    if (active_) {
+      flags.setStyle(cc::PaintFlags::kFill_Style);
+      flags.setColor(GetColorProvider()->GetColor(color_id));
+      canvas->DrawCircle(center, kDotRadius, flags);
+    } else {
+      flags.setStyle(cc::PaintFlags::kStroke_Style);
+      flags.setStrokeWidth(kDotRingWidth);
+      flags.setColor(GetColorProvider()->GetColor(color_id));
+      canvas->DrawCircle(center, kDotRadius, flags);
+    }
+  }
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    if (event.IsOnlyLeftMouseButton()) {
+      press_point_ = event.location();
+      dragging_ = false;
+    }
+    return true;
+  }
+  bool OnMouseDragged(const ui::MouseEvent& event) override {
+    if (!event.IsOnlyLeftMouseButton()) {
+      return false;
+    }
+    if (!dragging_ &&
+        (event.location() - press_point_).Length() > kDragThreshold) {
+      dragging_ = true;
+    }
+    return dragging_;
+  }
+  void OnMouseReleased(const ui::MouseEvent& event) override {
+    if (event.IsOnlyRightMouseButton()) {
+      ShowWorkspaceMenu(event.location());
+      return;
+    }
+    if (!event.IsOnlyLeftMouseButton()) {
+      return;
+    }
+    if (dragging_) {
+      dragging_ = false;
+      gfx::Point screen_point = event.location();
+      ConvertPointToScreen(this, &screen_point);
+      if (!on_drag_finished_.is_null()) {
+        on_drag_finished_.Run(id_, screen_point);
+      }
+      return;
+    }
+    if (HeliumWorkspaceController* controller =
+            HeliumWorkspaceController::From(browser_)) {
+      controller->SwitchToWorkspace(id_);
+    }
+  }
+  bool OnKeyPressed(const ui::KeyEvent& event) override {
+    if (event.key_code() == ui::VKEY_RETURN ||
+        event.key_code() == ui::VKEY_SPACE) {
+      if (HeliumWorkspaceController* controller =
+              HeliumWorkspaceController::From(browser_)) {
+        controller->SwitchToWorkspace(id_);
+      }
+      return true;
+    }
+    return false;
+  }
+  // ui::SimpleMenuModel::Delegate:
+  bool IsCommandIdChecked(int command_id) const override {
+    if (command_id >= kColorCommandBase &&
+        command_id < kColorCommandBase +
+                         static_cast<int>(
+                             tab_groups::TabGroupColorId::kNumEntries)) {
+      return command_id - kColorCommandBase == static_cast<int>(color_);
+    }
+    return false;
+  }
+  bool IsCommandIdEnabled(int command_id) const override {
+    HeliumWorkspaceController* controller =
+        HeliumWorkspaceController::From(browser_);
+    if (!controller || !controller->IsAvailable()) {
+      return false;
+    }
+    if (command_id == kDeleteCommand) {
+      return controller->GetWorkspaces().size() > 1;
+    }
+    if (command_id == kMoveLeftCommand) {
+      return WorkspaceIndex(controller) > 0;
+    }
+    if (command_id == kMoveRightCommand) {
+      const int index = WorkspaceIndex(controller);
+      return index >= 0 &&
+             index + 1 < static_cast<int>(controller->GetWorkspaces().size());
+    }
+    return true;
+  }
+  bool GetAcceleratorForCommandId(
+      int command_id,
+      ui::Accelerator* accelerator) const override {
+    return false;
+  }
+  void ExecuteCommand(int command_id, int event_flags) override {
+    HeliumWorkspaceController* controller =
+        HeliumWorkspaceController::From(browser_);
+    if (!controller || !controller->IsAvailable()) {
+      return;
+    }
+    if (command_id == kRenameCommand) {
+      std::string id = id_;
+      base::WeakPtr<HeliumWorkspaceController> weak_controller =
+          controller->GetWeakPtr();
+      WorkspaceNameDialog::Show(
+          GetWidget() ? GetWidget()->GetNativeWindow()
+                      : gfx::NativeWindow(),
+          l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_RENAME_TITLE),
+          NameFor(controller, id),
+          base::BindRepeating(
+              [](base::WeakPtr<HeliumWorkspaceController> c,
+                 const std::string& self, const std::string& candidate) {
+                if (!c || candidate.empty()) {
+                  return false;
+                }
+                for (const auto& entry : c->GetWorkspaces()) {
+                  if (entry.id != self && entry.name == candidate) {
+                    return false;
+                  }
+                }
+                return true;
+              },
+              weak_controller, id),
+          base::BindOnce(
+              [](base::WeakPtr<HeliumWorkspaceController> c,
+                 const std::string& self, const std::string& name) {
+                if (c) {
+                  c->RenameWorkspace(self, name);
+                }
+              },
+              weak_controller, id));
+    } else if (command_id == kDeleteCommand) {
+      // Ask first: deleting closes every tab in the workspace.
+      const std::string id = id_;
+      base::WeakPtr<HeliumWorkspaceController> weak_controller =
+          controller->GetWeakPtr();
+      chrome::ShowQuestionMessageBoxAsync(
+          GetWidget() ? GetWidget()->GetNativeWindow() : gfx::NativeWindow(),
+          l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_DELETE_TITLE),
+          l10n_util::GetStringFUTF16(
+              IDS_HELIUM_WORKSPACE_DELETE_BODY,
+              base::UTF8ToUTF16(NameFor(controller, id))),
+          base::BindOnce(
+              [](base::WeakPtr<HeliumWorkspaceController> c,
+                 const std::string& id, chrome::MessageBoxResult result) {
+                if (c && result == chrome::MESSAGE_BOX_RESULT_YES) {
+                  c->DeleteWorkspace(id);
+                }
+              },
+              weak_controller, id));
+    } else if (command_id == kMoveLeftCommand ||
+               command_id == kMoveRightCommand) {
+      const int index = WorkspaceIndex(controller);
+      if (index >= 0) {
+        controller->ReorderWorkspace(
+            id_, index + (command_id == kMoveLeftCommand ? -1 : 1));
+      }
+    } else if (command_id >= kColorCommandBase &&
+               command_id < kColorCommandBase +
+                                static_cast<int>(
+                                    tab_groups::TabGroupColorId::kNumEntries)) {
+      const auto color =
+          static_cast<tab_groups::TabGroupColorId>(command_id -
+                                                   kColorCommandBase);
+      if (controller->SetWorkspaceColor(id_, color)) {
+        color_ = color;
+        SchedulePaint();
+      }
+    }
+  }
+
+ private:
+  int WorkspaceIndex(HeliumWorkspaceController* controller) const {
+    const auto entries = controller->GetWorkspaces();
+    for (size_t i = 0; i < entries.size(); ++i) {
+      if (entries[i].id == id_) {
+        return static_cast<int>(i);
+      }
+    }
+    return -1;
+  }
+
+  static std::string NameFor(HeliumWorkspaceController* controller,
+                             const std::string& id) {
+    for (const auto& entry : controller->GetWorkspaces()) {
+      if (entry.id == id) {
+        return entry.name;
+      }
+    }
+    return std::string();
+  }
+
+  void ShowWorkspaceMenu(const gfx::Point& point) {
+    context_menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+    context_menu_model_->AddItem(
+        kRenameCommand,
+        l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_RENAME));
+    context_menu_model_->AddItem(
+        kMoveLeftCommand,
+        l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_MOVE_LEFT));
+    context_menu_model_->AddItem(
+        kMoveRightCommand,
+        l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_MOVE_RIGHT));
+    color_menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+    for (const auto& [color, label] :
+         tab_groups::GetTabGroupColorLabelMap()) {
+      color_menu_model_->AddCheckItem(kColorCommandBase +
+                                          static_cast<int>(color),
+                                      label);
+    }
+    context_menu_model_->AddSubMenu(
+        kColorMenuCommand,
+        l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_COLOR),
+        color_menu_model_.get());
+    context_menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+    context_menu_model_->AddItem(
+        kDeleteCommand,
+        l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_DELETE));
+    context_menu_runner_ = std::make_unique<views::MenuRunner>(
+        context_menu_model_.get(),
+        views::MenuRunner::HAS_MNEMONICS | views::MenuRunner::CONTEXT_MENU);
+    gfx::Point screen_point = point;
+    ConvertPointToScreen(this, &screen_point);
+    context_menu_runner_->RunMenuAt(
+        GetWidget(), nullptr, gfx::Rect(screen_point, gfx::Size()),
+        views::MenuAnchorPosition::kTopLeft,
+        ui::mojom::MenuSourceType::kMouse);
+  }
+
+  static constexpr int kRenameCommand = 1;
+  static constexpr int kDeleteCommand = 2;
+  static constexpr int kMoveLeftCommand = 3;
+  static constexpr int kMoveRightCommand = 4;
+  static constexpr int kColorMenuCommand = 5;
+  static constexpr int kColorCommandBase = 100;
+  static constexpr int kDragThreshold = 6;
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  const std::string id_;
+  bool active_;
+  tab_groups::TabGroupColorId color_;
+  base::RepeatingCallback<void(const std::string&, const gfx::Point&)>
+      on_drag_finished_;
+  gfx::Point press_point_;
+  bool dragging_ = false;
+  std::unique_ptr<ui::SimpleMenuModel> color_menu_model_;
+  std::unique_ptr<ui::SimpleMenuModel> context_menu_model_;
+  std::unique_ptr<views::MenuRunner> context_menu_runner_;
+};
+
+// The scrolling row itself. Dots handle their own clicks and drag-reorder;
+// empty row space (including the gaps between dots) starts a click-and-drag
+// horizontal scroll instead. The view is at least as wide as the viewport, so
+// clicks in the empty part of a short row still land here and bubble up to the
+// surrounding chrome.
+class HeliumWorkspaceSwitcherView::ContentsView : public views::View {
+ public:
+  explicit ContentsView(HeliumWorkspaceSwitcherView* owner) : owner_(owner) {
+    auto* layout = static_cast<views::BoxLayout*>(SetLayoutManager(
+        std::make_unique<views::BoxLayout>(
+            views::BoxLayout::Orientation::kHorizontal,
+            gfx::Insets::VH(kRowVerticalInset, 0), kDotGap)));
+    layout->set_main_axis_alignment(
+        views::BoxLayout::MainAxisAlignment::kStart);
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+    SetFocusBehavior(FocusBehavior::NEVER);
+  }
+  ~ContentsView() override = default;
+
+  // views::View:
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    if (!event.IsOnlyLeftMouseButton() || !owner_->scroll_view_ ||
+        !owner_->scroll_view_->IsHorizontalContentOverflowing()) {
+      // Nothing to scroll: let the surrounding chrome handle the drag.
+      return false;
+    }
+    dragging_ = true;
+    last_drag_x_ = event.x();
+    return true;
+  }
+  bool OnMouseDragged(const ui::MouseEvent& event) override {
+    if (!dragging_ || !event.IsOnlyLeftMouseButton()) {
+      return false;
+    }
+    const int delta = event.x() - last_drag_x_;
+    last_drag_x_ = event.x();
+    if (delta != 0 && owner_->scroll_view_) {
+      // Dragging the row left reveals later dots.
+      owner_->scroll_view_->ScrollByOffset(gfx::PointF(-delta, 0));
+    }
+    return true;
+  }
+  void OnMouseReleased(const ui::MouseEvent& event) override {
+    if (event.IsOnlyLeftMouseButton()) {
+      dragging_ = false;
+    }
+  }
+
+ private:
+  raw_ptr<HeliumWorkspaceSwitcherView> owner_;
+  int last_drag_x_ = 0;
+  bool dragging_ = false;
+};
+
+HeliumWorkspaceSwitcherView::HeliumWorkspaceSwitcherView(
+    BrowserWindowInterface* browser)
+    : browser_(browser) {
+  SetLayoutManager(std::make_unique<views::FillLayout>());
+
+  auto scroll_view = std::make_unique<views::ScrollView>(
+      views::ScrollView::ScrollWithLayers::kEnabled);
+  // No opaque background: the native frame material must show through.
+  scroll_view->SetBackgroundColor(std::nullopt);
+  scroll_view->SetVerticalScrollBarMode(
+      views::ScrollView::ScrollBarMode::kDisabled);
+  scroll_view->SetHorizontalScrollBar(
+      std::make_unique<views::OverlayScrollBar>(
+          views::ScrollBar::Orientation::kHorizontal));
+  scroll_view->SetHorizontalScrollBarMode(
+      views::ScrollView::ScrollBarMode::kEnabled);
+  // Vertical wheel and trackpad gestures scroll the row sideways.
+  scroll_view->SetTreatAllScrollEventsAsHorizontal(true);
+  scroll_view->SetOverflowGradientMask(
+      views::ScrollView::GradientDirection::kHorizontal);
+  // Keep the built-in overflow gradient updating, but replace the hard edge
+  // separators with empty views so only the soft fade is visible.
+  scroll_view->SetCustomOverflowIndicator(
+      views::OverflowIndicatorAlignment::kLeft,
+      std::make_unique<views::View>(), 0, false);
+  scroll_view->SetCustomOverflowIndicator(
+      views::OverflowIndicatorAlignment::kRight,
+      std::make_unique<views::View>(), 0, false);
+  scroll_view->RegisterPostLayoutCallback(base::BindRepeating(
+      [](HeliumWorkspaceSwitcherView* self, views::ScrollView*) {
+        self->ScrollActiveItemIntoView();
+      },
+      base::Unretained(this)));
+  contents_view_ =
+      scroll_view->SetContents(std::make_unique<ContentsView>(this));
+  scroll_view_ = AddChildView(std::move(scroll_view));
+
+  HeliumWorkspaceController* controller =
+      HeliumWorkspaceController::From(browser);
+  if (controller) {
+    controller_subscription_ = controller->AddObserver(base::BindRepeating(
+        &HeliumWorkspaceSwitcherView::OnControllerChanged,
+        base::Unretained(this)));
+  }
+  Refresh();
+}
+
+HeliumWorkspaceSwitcherView::~HeliumWorkspaceSwitcherView() = default;
+
+gfx::Size HeliumWorkspaceSwitcherView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  const int row_height =
+      GetLayoutConstant(LayoutConstant::kVerticalTabHeight);
+
+  int content_width = 0;
+  if (contents_view_) {
+    const auto& children = contents_view_->children();
+    for (const auto& child : children) {
+      content_width += child->GetPreferredSize().width();
+    }
+    if (children.size() > 1) {
+      content_width +=
+          kDotGap * (static_cast<int>(children.size()) - 1);
+    }
+  }
+  const int width =
+      std::clamp(content_width, kDotHitSize, kMaxSwitcherWidth);
+  return gfx::Size(width, row_height);
+}
+
+gfx::Size HeliumWorkspaceSwitcherView::GetMinimumSize() const {
+  // Keep at least one dot reachable when the toolbar is very narrow; the rest
+  // of the row stays available by scrolling.
+  return gfx::Size(kDotHitSize,
+                   GetLayoutConstant(LayoutConstant::kVerticalTabHeight));
+}
+
+void HeliumWorkspaceSwitcherView::Refresh() {
+  refresh_pending_ = false;
+  items_.clear();
+  if (contents_view_) {
+    contents_view_->RemoveAllChildViews();
+  }
+  HeliumWorkspaceController* controller =
+      HeliumWorkspaceController::From(browser_);
+  const bool available = controller && controller->IsAvailable();
+  SetVisible(available);
+  if (!available) {
+    last_active_id_.clear();
+    pending_scroll_to_active_ = false;
+    return;
+  }
+
+  std::string active_id;
+  for (const auto& entry : controller->GetWorkspaces()) {
+    auto item = std::make_unique<WorkspaceItemView>(
+        browser_, entry.id, entry.name, entry.active, entry.tab_count,
+        entry.color, kDotHitSize,
+        base::BindRepeating(&HeliumWorkspaceSwitcherView::OnItemDragged,
+                            base::Unretained(this)));
+    if (entry.active) {
+      active_id = entry.id;
+    }
+    items_.push_back(item.get());
+    contents_view_->AddChildView(std::move(item));
+  }
+  // "New workspace" affordance. An ImageButton keeps hover feedback without
+  // any opaque fill, so the translucent frame material shows through.
+  auto add_button = std::make_unique<views::ImageButton>(
+      base::BindRepeating(
+          [](BrowserWindowInterface* browser) {
+            if (HeliumWorkspaceController* c =
+                    HeliumWorkspaceController::From(browser)) {
+              c->CreateWorkspace();
+            }
+          },
+          browser_));
+  add_button->SetImageModel(
+      views::Button::STATE_NORMAL,
+      ui::ImageModel::FromVectorIcon(kAddIcon, ui::kColorMenuIcon,
+                                     kDotHitSize - 8));
+  add_button->SetTooltipText(
+      l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_NEW));
+  add_button->SetPreferredSize(gfx::Size(kDotHitSize, kDotHitSize));
+  contents_view_->AddChildView(std::move(add_button));
+
+  // Only yank the row when the active workspace actually changed; ordinary
+  // tab-count refreshes should not undo a manual scroll.
+  if (active_id != last_active_id_) {
+    pending_scroll_to_active_ = true;
+  }
+  last_active_id_ = std::move(active_id);
+
+  contents_view_->InvalidateLayout();
+  InvalidateLayout();
+  SchedulePaint();
+}
+
+void HeliumWorkspaceSwitcherView::ScrollActiveItemIntoView() {
+  if (!pending_scroll_to_active_) {
+    return;
+  }
+  pending_scroll_to_active_ = false;
+  for (WorkspaceItemView* item : items_) {
+    if (item && item->IsActive()) {
+      item->ScrollViewToVisible();
+      return;
+    }
+  }
+}
+
+void HeliumWorkspaceSwitcherView::ScheduleRefresh() {
+  if (refresh_pending_) {
+    return;
+  }
+  refresh_pending_ = true;
+  // Rebuilding destroys the view that may still be handling a click or a menu
+  // command, so always do it after the current event has unwound.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&HeliumWorkspaceSwitcherView::Refresh,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void HeliumWorkspaceSwitcherView::OnControllerChanged() {
+  ScheduleRefresh();
+}
+
+void HeliumWorkspaceSwitcherView::OnItemDragged(
+    const std::string& id,
+    const gfx::Point& screen_point) {
+  HeliumWorkspaceController* controller =
+      HeliumWorkspaceController::From(browser_);
+  if (!controller || !controller->IsAvailable()) {
+    return;
+  }
+  // Find the dot under the cursor. items_ follows workspace order, so the
+  // hit item's position is also the destination index.
+  for (size_t i = 0; i < items_.size(); ++i) {
+    views::View* item = items_[i];
+    if (!item) {
+      continue;
+    }
+    gfx::Point local = screen_point;
+    views::View::ConvertPointFromScreen(item, &local);
+    if (item->GetLocalBounds().Contains(local)) {
+      controller->ReorderWorkspace(id, static_cast<int>(i));
+      return;
+    }
+  }
+}
