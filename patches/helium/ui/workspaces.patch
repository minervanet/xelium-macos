+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/helium_workspace_utils.h"
+
+#include <algorithm>
+#include <map>
+#include <set>
+#include <utility>
+
+#include "chrome/browser/ui/tabs/tab_group_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/sessions/content/content_serialized_navigation_builder.h"
+#include "components/sessions/core/session_id.h"
+#include "components/sessions/core/session_service_commands.h"
+#include "components/sessions/core/session_types.h"
+#include "components/tab_groups/tab_group_visual_data.h"
+#include "components/tabs/public/split_tab_data.h"
+#include "components/tabs/public/tab_group.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/web_contents.h"
+
+namespace {
+
+using sessions::ContentSerializedNavigationBuilder;
+
+// Serializes the navigation history of one live tab.
+HeliumSerializedWorkspace::Tab SerializeOneTab(content::WebContents* contents,
+                                              bool pinned,
+                                              std::optional<int> group_slot,
+                                              std::optional<int> split_slot) {
+  HeliumSerializedWorkspace::Tab out;
+  out.pinned = pinned;
+  out.group_slot = group_slot;
+  out.split_slot = split_slot;
+  if (!contents) {
+    return out;
+  }
+  auto& controller = contents->GetController();
+  const int nav_count = controller.GetEntryCount();
+  const int current = controller.GetCurrentEntryIndex();
+  for (int i = 0; i < nav_count; ++i) {
+    content::NavigationEntry* entry = controller.GetEntryAtIndex(i);
+    if (!entry) {
+      continue;
+    }
+    out.navigations.push_back(
+        ContentSerializedNavigationBuilder::FromNavigationEntry(i, entry));
+  }
+  out.selected_navigation =
+      out.navigations.empty()
+          ? 0
+          : std::clamp(current, 0,
+                       static_cast<int>(out.navigations.size()) - 1);
+  return out;
+}
+
+}  // namespace
+
+HeliumSerializedWorkspace SerializeLiveTabStrip(
+    const TabStripModel* tab_strip,
+    bool include_pinned) {
+  HeliumSerializedWorkspace out;
+  if (!tab_strip || tab_strip->count() == 0) {
+    return out;
+  }
+  // Assign a stable slot to every group in first-appearance order.
+  std::map<tab_groups::TabGroupId, int> slots;
+  std::map<split_tabs::SplitTabId, int> split_slots;
+  if (tab_strip->group_model()) {
+    for (int i = 0; i < tab_strip->count(); ++i) {
+      const std::optional<tab_groups::TabGroupId> group =
+          tab_strip->GetTabGroupForTab(i);
+      if (!group.has_value() || slots.contains(group.value())) {
+        continue;
+      }
+      const int slot = static_cast<int>(out.groups.size());
+      slots[group.value()] = slot;
+      HeliumSerializedWorkspace::Group serialized;
+      const TabGroup* tab_group =
+          tab_strip->group_model()->GetTabGroup(group.value());
+      if (tab_group && tab_group->visual_data()) {
+        serialized.visual_data = *tab_group->visual_data();
+      }
+      out.groups.push_back(std::move(serialized));
+    }
+  }
+  for (int i = 0; i < tab_strip->count(); ++i) {
+    if (!include_pinned && tab_strip->IsTabPinned(i)) {
+      continue;
+    }
+    const std::optional<tab_groups::TabGroupId> group =
+        tab_strip->GetTabGroupForTab(i);
+    std::optional<int> slot;
+    if (group.has_value()) {
+      const auto it = slots.find(group.value());
+      if (it != slots.end()) {
+        slot = it->second;
+      }
+    }
+    std::optional<int> split_slot;
+    if (const std::optional<split_tabs::SplitTabId> split_id =
+            tab_strip->GetSplitForTab(i);
+        split_id.has_value()) {
+      auto split_it = split_slots.find(split_id.value());
+      if (split_it == split_slots.end()) {
+        const int new_slot = static_cast<int>(out.splits.size());
+        split_slots[split_id.value()] = new_slot;
+        HeliumSerializedWorkspace::Split serialized;
+        if (const split_tabs::SplitTabData* split =
+                tab_strip->GetSplitData(split_id.value())) {
+          serialized.visual_data = *split->visual_data();
+        }
+        out.splits.push_back(std::move(serialized));
+        split_slot = new_slot;
+      } else {
+        split_slot = split_it->second;
+      }
+    }
+    out.tabs.push_back(SerializeOneTab(tab_strip->GetWebContentsAt(i),
+                                       tab_strip->IsTabPinned(i), slot,
+                                       split_slot));
+  }
+  const int active = tab_strip->active_index();
+  if (active >= 0 && active < tab_strip->count()) {
+    // Map the active tab into the serialized (possibly pinned-free) list.
+    int position = 0;
+    out.active_index = 0;
+    for (int i = 0; i <= active; ++i) {
+      if (!include_pinned && tab_strip->IsTabPinned(i)) {
+        continue;
+      }
+      if (i == active) {
+        out.active_index = position;
+        break;
+      }
+      ++position;
+    }
+  }
+  out.active_index =
+      std::clamp(out.active_index, 0,
+                 std::max(0, static_cast<int>(out.tabs.size()) - 1));
+  return out;
+}
+
+std::vector<std::unique_ptr<sessions::SessionCommand>> BuildWorkspaceCommands(
+    const HeliumSerializedWorkspace& workspace) {
+  std::vector<std::unique_ptr<sessions::SessionCommand>> commands;
+  if (workspace.tabs.empty()) {
+    return commands;
+  }
+  const SessionID window_id = SessionID::NewUnique();
+  commands.push_back(sessions::CreateSetWindowTypeCommand(
+      window_id, sessions::SessionWindow::TYPE_NORMAL));
+  // Map group slots back to fresh group ids. Original ids are deliberately
+  // not reused: they may still be referenced by detached live tabs.
+  std::vector<std::optional<tab_groups::TabGroupId>> group_ids(
+      workspace.groups.size());
+  for (size_t slot = 0; slot < workspace.groups.size(); ++slot) {
+    group_ids[slot] = tab_groups::TabGroupId::GenerateNew();
+    commands.push_back(sessions::CreateTabGroupMetadataUpdateCommand(
+        group_ids[slot].value(), &workspace.groups[slot].visual_data));
+  }
+  std::vector<split_tabs::SplitTabId> split_ids;
+  split_ids.reserve(workspace.splits.size());
+  for (size_t slot = 0; slot < workspace.splits.size(); ++slot) {
+    split_ids.push_back(split_tabs::SplitTabId::GenerateNew());
+    commands.push_back(sessions::CreateSplitTabDataUpdateCommand(
+        split_ids.back(), &workspace.splits[slot].visual_data));
+  }
+  for (size_t i = 0; i < workspace.tabs.size(); ++i) {
+    const auto& tab = workspace.tabs[i];
+    if (tab.navigations.empty()) {
+      continue;
+    }
+    const SessionID tab_id = SessionID::NewUnique();
+    commands.push_back(
+        sessions::CreateSetTabWindowCommand(window_id, tab_id));
+    commands.push_back(sessions::CreateSetTabIndexInWindowCommand(
+        tab_id, static_cast<int>(i)));
+    if (tab.pinned) {
+      commands.push_back(sessions::CreatePinnedStateCommand(tab_id, true));
+    }
+    if (tab.group_slot.has_value() &&
+        tab.group_slot.value() >= 0 &&
+        static_cast<size_t>(tab.group_slot.value()) < group_ids.size() &&
+        group_ids[tab.group_slot.value()].has_value()) {
+      commands.push_back(sessions::CreateTabGroupCommand(
+          tab_id, group_ids[tab.group_slot.value()]));
+    }
+    if (tab.split_slot.has_value() && tab.split_slot.value() >= 0 &&
+        static_cast<size_t>(tab.split_slot.value()) < split_ids.size()) {
+      commands.push_back(sessions::CreateSplitTabCommand(
+          tab_id, split_ids[tab.split_slot.value()]));
+    }
+    for (const auto& navigation : tab.navigations) {
+      commands.push_back(
+          sessions::CreateUpdateTabNavigationCommand(tab_id, navigation));
+    }
+    commands.push_back(sessions::CreateSetSelectedNavigationIndexCommand(
+        tab_id, tab.selected_navigation));
+  }
+  commands.push_back(sessions::CreateSetSelectedTabInWindowCommand(
+      window_id, std::clamp(workspace.active_index, 0,
+                            static_cast<int>(workspace.tabs.size()) - 1)));
+  return commands;
+}
+
+std::unique_ptr<HeliumSerializedWorkspace> ParseWorkspaceCommands(
+    const std::vector<std::unique_ptr<sessions::SessionCommand>>& commands) {
+  if (commands.empty()) {
+    return nullptr;
+  }
+  std::vector<std::unique_ptr<sessions::SessionWindow>> windows;
+  SessionID active_window_id = SessionID::InvalidValue();
+  std::string platform_session_id;
+  std::set<SessionID> discarded_window_ids;
+  sessions::RestoreSessionFromCommands(commands, &windows, &active_window_id,
+                                       &platform_session_id,
+                                       &discarded_window_ids);
+  const sessions::SessionWindow* source = nullptr;
+  for (const auto& window : windows) {
+    if (!window->tabs.empty()) {
+      source = window.get();
+      break;
+    }
+  }
+  if (!source) {
+    return nullptr;
+  }
+  auto out = std::make_unique<HeliumSerializedWorkspace>();
+  std::map<tab_groups::TabGroupId, int> slots;
+  for (const auto& session_group : source->tab_groups) {
+    const int slot = static_cast<int>(out->groups.size());
+    slots[session_group->id] = slot;
+    HeliumSerializedWorkspace::Group group;
+    group.visual_data = session_group->visual_data;
+    out->groups.push_back(std::move(group));
+  }
+  std::map<split_tabs::SplitTabId, int> split_slots;
+  for (const auto& session_split : source->split_tabs) {
+    const int slot = static_cast<int>(out->splits.size());
+    split_slots[session_split->id_] = slot;
+    HeliumSerializedWorkspace::Split split;
+    split.visual_data = session_split->split_visual_data_;
+    out->splits.push_back(std::move(split));
+  }
+  for (const auto& session_tab : source->tabs) {
+    if (session_tab->navigations.empty()) {
+      continue;
+    }
+    HeliumSerializedWorkspace::Tab tab;
+    tab.navigations = session_tab->navigations;
+    tab.selected_navigation = session_tab->normalized_navigation_index();
+    tab.pinned = session_tab->pinned;
+    tab.extension_app_id = session_tab->extension_app_id;
+    if (session_tab->group.has_value()) {
+      const auto it = slots.find(session_tab->group.value());
+      if (it != slots.end()) {
+        tab.group_slot = it->second;
+      }
+    }
+    if (session_tab->split_id.has_value()) {
+      const auto it = split_slots.find(session_tab->split_id.value());
+      if (it != split_slots.end()) {
+        tab.split_slot = it->second;
+      }
+    }
+    out->tabs.push_back(std::move(tab));
+  }
+  if (out->tabs.empty()) {
+    return nullptr;
+  }
+  out->active_index =
+      std::clamp(source->selected_tab_index, 0,
+                 static_cast<int>(out->tabs.size()) - 1);
+  return out;
+}

