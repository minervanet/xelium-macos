+#include "components/tab_groups/tab_group_id.h"
+#include "components/tab_groups/tab_group_visual_data.h"
+#include "ui/base/unowned_user_data/scoped_unowned_user_data.h"
+
+class BrowserWindowInterface;
+class GlobalBrowserCollection;
+class HeliumWorkspaceService;
+class PrefService;
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace tabs {
+class TabInterface;
+class TabModel;
+}  // namespace tabs
+
+// Per-window Workspaces controller (Settings > Appearance > Workspaces).
+//
+// Several workspaces live inside ONE window. Switching hides the current
+// workspace's tabs by detaching them from the TabStripModel into memory and
+// inserts the target workspace's tabs, so tabs are never closed or reloaded
+// by a switch. Tab groups (names, colors, collapsed state), splits and tab
+// order survive in-session switches through Chromium's detached tab
+// collections; pinned tabs stay visible and are shared by every workspace.
+//
+// Every switch, move and metadata change also serializes the affected
+// workspace as session commands through HeliumWorkspaceService, so inactive
+// workspaces survive a restart and are materialized on first use. Anything
+// unreadable recovers to a single fresh workspace instead of crashing.
+//
+// The controller is owned by BrowserWindowFeatures. It observes the tab strip
+// only to debounce autosave after structural changes, and the global browser
+// collection to decide which window owns the shared workspace set. Individual
+// tabs are never observed. With the feature disabled (or in private and
+// non-normal windows, or in a window that is not the owner) the controller is
+// inert and the tab strip is untouched.
+class HeliumWorkspaceController : public TabStripModelObserver,
+                                  public BrowserCollectionObserver {
+ public:
+  DECLARE_USER_DATA(HeliumWorkspaceController);
+
+  static HeliumWorkspaceController* From(BrowserWindowInterface* browser);
+
+  HeliumWorkspaceController(BrowserWindowInterface* browser,
+                            PrefService* pref_service);
+  HeliumWorkspaceController(const HeliumWorkspaceController&) = delete;
+  HeliumWorkspaceController& operator=(const HeliumWorkspaceController&) =
+      delete;
+  ~HeliumWorkspaceController();
+
+  struct WorkspaceEntry {
+    std::string id;
+    std::string name;
+    bool active = false;
+    // Live or snapshot tab count; -1 when known only from possibly stale
+    // on-disk metadata.
+    int tab_count = -1;
+    tab_groups::TabGroupColorId color = tab_groups::TabGroupColorId::kGrey;
+  };
+  std::vector<WorkspaceEntry> GetWorkspaces() const;
+
+  // One tab reachable from the visual tab switcher. |workspace_id| is the
+  // workspace that currently owns it (empty when the feature is off) and
+  // |active_workspace| is true for tabs already in the visible strip. Only
+  // loaded workspaces are reported: inactive workspaces that exist solely on
+  // disk are not materialized just to populate the switcher.
+  struct SwitcherTab {
+    content::WebContents* contents = nullptr;
+    std::string workspace_id;
+    bool active_workspace = false;
+  };
+  std::vector<SwitcherTab> GetLoadedTabs() const;
+
+  // False when workspaces are disabled, or for private / non-normal windows.
+  // Every mutating method below is a no-op returning failure when false.
+  bool IsAvailable() const;
+
+  const std::string& active_workspace_id() const { return active_id_; }
+  bool HasPendingLoad() const { return load_in_flight_; }
+
+  // Makes |id| the visible workspace. Returns false when unavailable,
+  // unknown, already active or (for disk-backed workspaces) while the
+  // previous load is still in flight; the load itself completes
+  // asynchronously.
+  bool SwitchToWorkspace(const std::string& id);
+
+  // Creates a new workspace with a single fresh tab and switches to it.
+  // Returns the new id, or empty on failure.
+  std::string CreateWorkspace();
+
+  bool RenameWorkspace(const std::string& id, const std::string& name);
+  bool DeleteWorkspace(const std::string& id);
+
+  // Changes the dot color shown for |id|.
+  bool SetWorkspaceColor(const std::string& id,
+                         tab_groups::TabGroupColorId color);
+
+  // Moves |id| to |new_index| in the switcher order (clamped to the number of
+  // workspaces).
+  bool ReorderWorkspace(const std::string& id, int new_index);
+
+  // Switches to the workspace |delta| positions away in display order
+  // (wrapping). Used by the keyboard shortcuts. Returns false when there is
+  // only one workspace or the feature is off.
+  bool SwitchToAdjacentWorkspace(int delta);
+
+  // Closes a tab parked in an inactive workspace (for tab search and similar
+  // surfaces that can reach loaded tabs). Returns false when the tab is not
+  // parked in this window.
+  bool CloseParkedTab(content::WebContents* contents);
+
+  // Moves the selected tabs (or |index| when it is not selected) into |id|.
+  // |id| may be inactive; its tabs are loaded first when necessary.
+  bool MoveTabsToWorkspace(const std::string& id, int index);
+  // Moves the selected tabs (or |index|) into a brand-new workspace without
+  // switching to it. Returns the new id, or empty on failure.
+  std::string MoveTabsToNewWorkspace(int index);
+
+  using ChangedCallback = base::RepeatingCallback<void()>;
+  base::CallbackListSubscription AddObserver(ChangedCallback callback);
+
+  // Writes the visible workspace immediately. Called by the close path before
+  // the tab strip is torn down, so the last few seconds of tab changes are not
+  // lost to the autosave debounce.
+  void FlushSave();
+
+  base::WeakPtr<HeliumWorkspaceController> GetWeakPtr();
+
+ private:
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+  void OnTabStripModelDestroyed(TabStripModel* model) override;
+
+  // BrowserCollectionObserver:
+  void OnBrowserCreated(BrowserWindowInterface* browser) override;
+  void OnBrowserClosed(BrowserWindowInterface* browser) override;
+
+  // True when this window is the single window allowed to own workspaces:
+  // the first-created normal window for the profile. Workspaces live in one
+  // window, so extra windows stay plain and can never overwrite the same
+  // workspace set on disk.
+  bool IsWorkspaceOwner() const;
+  void OnWindowSetChanged();
+  // Keeps this window's current tabs as a new workspace. Used when workspaces
+  // move to this window because the previous owner closed, so the previous
+  // owner's saved tabs are never overwritten.
+  void AdoptVisibleTabsAsNewWorkspace();
+
+  void ScheduleAutosave();
+
+  // Live-detached tabs, in strip order. Groups and splits detached whole
+  // stay whole through their collections.
+  using LiveItem = std::variant<std::unique_ptr<DetachedTab>,
+                                std::unique_ptr<DetachedTabCollection>>;
+  struct FlatTab {
+    std::unique_ptr<tabs::TabModel> model;
+    bool pinned = false;
+    // Index into Snapshot::group_visuals; nullopt when ungrouped.
+    std::optional<int> group_slot;
+    // Index into Snapshot::split_visuals; nullopt when not split.
+    std::optional<int> split_slot;
+  };
+  struct Snapshot {
+    std::vector<LiveItem> live_items;
+    std::vector<FlatTab> flat_tabs;
+    // Parallel to group slots; empty when the workspace has no groups.
+    std::vector<tab_groups::TabGroupVisualData> group_visuals;
+    // Maps a live (possibly detached) group id to its slot.
+    std::map<tab_groups::TabGroupId, int> group_slots;
+    // Parallel to split slots; empty when the workspace has no split views.
+    std::vector<split_tabs::SplitTabVisualData> split_visuals;
+    int active_index = 0;
+    int TabCount() const;
+  };
+
+  // Detaches |indices| (selected tabs, or a single tab) from the visible
+  // strip as flat models, opening a fresh tab first when the whole strip is
+  // moving so the strip never empties. Returns nullopt when there is nothing
+  // to detach.
+  struct DetachedSelection {
+    std::vector<FlatTab> tabs;
+    std::vector<tab_groups::TabGroupVisualData> visuals;
+    std::vector<split_tabs::SplitTabVisualData> split_visuals;
+  };
+  std::optional<DetachedSelection> DetachIndices(std::vector<int> indices);
+
+  HeliumWorkspaceService* GetService() const;
+  TabStripModel* GetTabStripModel() const;
+
+  // Adopts the current tabs into the active workspace and guarantees the
+  // default workspace exists. Never moves tabs.
+  void EnsureWorkspaces();
+  void OnEnabledPrefChanged();
+
+  // Serializes the visible strip and stores it via the service under the
+  // active workspace id.
+  void SaveActiveWorkspace();
+  // Serializes the in-memory |snapshots_[id]| and stores it via the service.
+  // No-op when |id| has no snapshot.
+  void SaveSnapshot(const std::string& id);
+
+  // Detaches |tabs_to_detach| (captured from the visible strip before
+  // replacement tabs were inserted) into a snapshot (order, groups, splits,
+  // pinned state and active index preserved). The strip must hold other tabs
+  // afterwards; this must never leave the strip empty. Pinned tabs are
+  // shared by every workspace and are never detached.
+  Snapshot DetachVisibleTabs(
+      const std::vector<tabs::TabInterface*>& tabs_to_detach);
+
+  // Stores |snapshot| as the parked state of |id|, unless |id| is being
+  // deleted; in that case the tabs are destroyed instead of leaked.
+  void ParkSnapshot(const std::string& id, Snapshot snapshot);
+
+  // Frees parked workspaces that have been inactive for a while, so memory
+  // does not grow with every workspace the user has ever visited. Runs at
+  // switch time (when no tab switcher is holding raw pointers to them).
+  void MaybeDiscardInactiveWorkspaces(const std::string& target_id);
+
+  // Inserts |snapshot| at the end of the visible strip and activates its
+  // recorded active tab. The strip must be non-empty. Tabs saved as pinned by
+  // older builds are inserted unpinned: pinned tabs are now universal and
+  // only the ones already in the strip stay pinned.
+  void InsertSnapshot(Snapshot snapshot);
+
+  // Builds detached models for a workspace parsed from disk.
+  Snapshot SnapshotFromSerialized(
+      std::unique_ptr<struct HeliumSerializedWorkspace> parsed);
+
+  void OnWorkspaceLoaded(const std::string& id,
+                         int switch_sequence,
+                         std::vector<std::unique_ptr<sessions::SessionCommand>>
+                             commands);
+  void NotifyChanged();
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<PrefService> pref_service_;
+  PrefChangeRegistrar pref_registrar_;
+
+  // In-memory tabs of inactive workspaces, keyed by workspace id. The active
+  // workspace's tabs always live in the tab strip, never here.
+  std::map<std::string, Snapshot> snapshots_;
+  // When each parked workspace was last hidden; used to unload old ones.
+  std::map<std::string, base::TimeTicks> parked_at_;
+  // Tabs moved into a workspace whose disk state has not loaded yet. Merged
+  // into the snapshot when the load completes.
+  struct PendingMove {
+    std::vector<FlatTab> tabs;
+    std::vector<tab_groups::TabGroupVisualData> visuals;
+    std::vector<split_tabs::SplitTabVisualData> split_visuals;
+  };
+  std::map<std::string, PendingMove> pending_moves_;
+  // Set while a disk load for a workspace switch is outstanding.
+  std::optional<std::string> pending_switch_;
+  // Workspace that is being deleted while its tabs are still visible (the
+  // fallback had to load from disk). Its tabs are destroyed when the switch
+  // completes instead of being parked forever.
+  std::optional<std::string> pending_delete_id_;
+
+  std::string active_id_;
+  bool load_in_flight_ = false;
+  // True once this window has actually owned workspaces. A window that only
+  // inherits them later (because the previous owner closed) keeps its current
+  // tabs in a new workspace instead of overwriting saved data.
+  bool ever_available_ = false;
+  int switch_sequence_ = 0;
+  // Debounces disk writes while tabs are opened, closed, moved or regrouped.
+  base::OneShotTimer autosave_timer_;
+
+  // Registers this controller on the owning window so UI code can reach it
+  // via HeliumWorkspaceController::From(browser). Must be declared after
+  // the members it observes and destroyed first.
+  ui::ScopedUnownedUserData<HeliumWorkspaceController>
+      scoped_unowned_user_data_;
+
+  base::ScopedObservation<GlobalBrowserCollection, BrowserCollectionObserver>
+      browser_collection_observation_{this};
+
+  base::RepeatingCallbackList<void()> observers_;
+  base::WeakPtrFactory<HeliumWorkspaceController> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_HELIUM_HELIUM_WORKSPACE_CONTROLLER_H_

