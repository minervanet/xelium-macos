+void TabSearchPageHandler::AppendParkedWorkspaceTabs(
+    BrowserWindowInterface* browser,
+    tab_search::mojom::Window* window) {
+  HeliumWorkspaceController* controller =
+      HeliumWorkspaceController::From(browser);
+  if (!controller || !controller->IsAvailable()) {
+    return;
+  }
+  for (const auto& entry : controller->GetLoadedTabs()) {
+    if (entry.active_workspace || !entry.contents) {
+      continue;
+    }
+    tabs::TabInterface* tab =
+        tabs::TabInterface::MaybeGetFromContents(entry.contents);
+    if (!tab || !TabUIHelper::From(tab)) {
+      continue;
+    }
+    content::WebContents* contents = tab->GetContents();
+    if (!contents ||
+        !contents->GetController().GetLastCommittedEntry()) {
+      continue;
+    }
+    auto mojom_tab = GetTab(tab);
+    // Parked groups/splits are not part of the tab search tree; present the
+    // tabs plainly so they remain searchable and switchable.
+    mojom_tab->group_id.reset();
+    mojom_tab->split = false;
+    mojom_tab->split_id.reset();
+    mojom_tab->split_layout.reset();
+    mojom_tab->pinned = false;
+    mojom_tab->active = false;
+    mojom_tab->visible = false;
+    window->tabs.push_back(std::move(mojom_tab));
+  }
+}
+
+BrowserWindowInterface* TabSearchPageHandler::FindBrowserForTab(
+    tabs::TabInterface* tab) {
+  if (!tab) {
+    return nullptr;
+  }
+  if (BrowserWindowInterface* browser = tab->GetBrowserWindowInterface()) {
+    return browser;
+  }
+  BrowserWindowInterface* result = nullptr;
+  // Walk windows in creation order: the owning window is an intrinsic
+  // property of the tab, not something to guess from activation history.
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&](BrowserWindowInterface* browser) {
+        if (!ShouldTrackBrowser(profile_, browser)) {
+          return true;
+        }
+        HeliumWorkspaceController* controller =
+            HeliumWorkspaceController::From(browser);
+        if (!controller || !controller->IsAvailable()) {
+          return true;
+        }
+        for (const auto& entry : controller->GetLoadedTabs()) {
+          if (entry.contents == tab->GetContents()) {
+            result = browser;
+            return false;
+          }
+        }
+        return true;
+      });
+  return result;
+}
