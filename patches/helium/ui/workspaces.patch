+// Modal rename dialog. Caches the text on every change; the Textfield is
+// owned by the contents view and never touched after the dialog closes.
+// (Plain WidgetDelegate: subclassing DialogDelegateView is not allowed for
+// new code, and the transient rename UI does not need dialog-model hosting.)
+class WorkspaceNameDialog : public views::WidgetDelegate,
+                            public views::TextfieldController {
+ public:
+  using Validator = base::RepeatingCallback<bool(const std::string&)>;
+  using ResultCallback = base::OnceCallback<void(const std::string&)>;
+
+  static void Show(gfx::NativeWindow parent,
+                   const std::u16string& title,
+                   const std::string& initial,
+                   Validator validator,
+                   ResultCallback callback) {
+    auto dialog = std::make_unique<WorkspaceNameDialog>(
+        title, initial, std::move(validator), std::move(callback));
+    WorkspaceNameDialog* dialog_ptr = dialog.get();
+    views::Widget* widget = views::DialogDelegate::CreateDialogWidget(
+        std::move(dialog), parent, gfx::NativeView());
+    widget->Show();
+    dialog_ptr->textfield_->RequestFocus();
+    dialog_ptr->UpdateOkButton();
+  }
+
+  WorkspaceNameDialog(const std::u16string& title,
+                      const std::string& initial,
+                      Validator validator,
+                      ResultCallback callback)
+      : validator_(std::move(validator)), callback_(std::move(callback)) {
+    SetTitle(title);
+    SetModalType(ui::mojom::ModalType::kWindow);
+    auto contents = std::make_unique<views::View>();
+    contents->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical,
+        gfx::Insets::VH(12, 16), 8));
+    auto textfield = std::make_unique<views::Textfield>();
+    textfield->SetText(base::UTF8ToUTF16(initial));
+    textfield->SelectAll(false);
+    textfield->SetAccessibleName(title);
+    textfield->SetController(this);
+    textfield->SetPreferredSize(
+        gfx::Size(280, textfield->GetPreferredSize().height()));
+    textfield_ = textfield.get();
+    contents->AddChildView(std::move(textfield));
+    auto buttons = std::make_unique<views::View>();
+    buttons->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 8));
+    auto spacer = std::make_unique<views::View>();
+    spacer->SetProperty(
+        views::kFlexBehaviorKey,
+        views::FlexSpecification(views::MinimumFlexSizeRule::kScaleToZero,
+                                 views::MaximumFlexSizeRule::kUnbounded));
+    buttons->AddChildView(std::move(spacer));
+    auto cancel = std::make_unique<views::LabelButton>(
+        base::BindRepeating(&WorkspaceNameDialog::OnCancel,
+                            base::Unretained(this)),
+        l10n_util::GetStringUTF16(IDS_CANCEL));
+    buttons->AddChildView(std::move(cancel));
+    auto ok = std::make_unique<views::LabelButton>(
+        base::BindRepeating(&WorkspaceNameDialog::OnAccept,
+                            base::Unretained(this)),
+        l10n_util::GetStringUTF16(IDS_OK));
+    ok->SetIsDefault(true);
+    ok_button_ = ok.get();
+    buttons->AddChildView(std::move(ok));
+    contents->AddChildView(std::move(buttons));
+    name_ = initial;
+    SetContentsView(std::move(contents));
+  }
+  ~WorkspaceNameDialog() override = default;
+
+  // views::TextfieldController:
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string& new_contents) override {
+    name_ = base::UTF16ToUTF8(new_contents);
+    UpdateOkButton();
+  }
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& key_event) override {
+    if (key_event.key_code() == ui::VKEY_RETURN) {
+      OnAccept();
+      return true;
+    }
+    return false;
+  }
+
+ private:
+  void OnAccept() {
+    if (!validator_.is_null() && !validator_.Run(name_)) {
+      return;
+    }
+    ResultCallback callback = std::move(callback_);
+    if (views::Widget* widget = GetWidget()) {
+      widget->Close();
+    }
+    std::move(callback).Run(name_);
+  }
+  void OnCancel() {
+    if (views::Widget* widget = GetWidget()) {
+      widget->Close();
+    }
+  }
+  void UpdateOkButton() {
+    if (ok_button_) {
+      ok_button_->SetEnabled(validator_.is_null() ||
+                             validator_.Run(name_));
+    }
+  }
+
+  // Cached on every keystroke; the Textfield itself is never touched here.
+  std::string name_;
+  Validator validator_;
+  ResultCallback callback_;
+  raw_ptr<views::Textfield> textfield_ = nullptr;
+  raw_ptr<views::LabelButton> ok_button_ = nullptr;
+};
+
