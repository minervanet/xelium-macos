+bool HeliumWorkspaceController::SwitchToAdjacentWorkspace(int delta) {
+  if (!IsAvailable() || delta == 0) {
+    return false;
+  }
+  HeliumWorkspaceService* service = GetService();
+  if (!service) {
+    return false;
+  }
+  const std::vector<HeliumWorkspaceService::WorkspaceInfo> workspaces =
+      service->ListWorkspaces();
+  if (workspaces.size() < 2) {
+    return false;
+  }
+  int current = -1;
+  for (size_t i = 0; i < workspaces.size(); ++i) {
+    if (workspaces[i].id == active_id_) {
+      current = static_cast<int>(i);
+      break;
+    }
+  }
+  if (current < 0) {
+    return false;
+  }
+  const int count = static_cast<int>(workspaces.size());
+  const int target = ((current + delta) % count + count) % count;
+  if (target == current) {
+    return false;
+  }
+  return SwitchToWorkspace(workspaces[target].id);
+}
