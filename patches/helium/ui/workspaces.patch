+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_HELIUM_WORKSPACE_UTILS_H_
+#define CHROME_BROWSER_UI_HELIUM_HELIUM_WORKSPACE_UTILS_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "components/sessions/core/serialized_navigation_entry.h"
+#include "components/sessions/core/session_command.h"
+#include "components/tab_groups/tab_group_visual_data.h"
+
+class TabStripModel;
+
+namespace content {
+class WebContents;
+}
+
+// Serializable description of one workspace's tabs. This is the in-memory
+// form used to persist a workspace to disk and to rebuild tabs from disk.
+// Live tab switching keeps real WebContents alive instead and never touches
+// this struct.
+struct HeliumSerializedWorkspace {
+  struct Tab {
+    // Full navigation history, in order.
+    std::vector<sessions::SerializedNavigationEntry> navigations;
+    int selected_navigation = 0;
+    bool pinned = false;
+    // Index into |groups|. std::nullopt for ungrouped tabs. Splits are not
+    // preserved across a disk round-trip.
+    std::optional<int> group_slot;
+    std::string extension_app_id;
+  };
+  struct Group {
+    tab_groups::TabGroupVisualData visual_data;
+  };
+
+  std::vector<Tab> tabs;
+  std::vector<Group> groups;
+  // Active tab as an index into |tabs|.
+  int active_index = 0;
+};
+
+// Captures the live contents of |tab_strip| (order, pinned state, groups and
+// navigation history) without detaching or closing anything. Safe to call on
+// the UI thread only.
+HeliumSerializedWorkspace SerializeLiveTabStrip(
+    const TabStripModel* tab_strip);
+
+// Serializes |workspace| as Chromium session commands describing a single
+// window. Must run on the UI thread: SessionID allocation is sequence-checked
+// to it. The commands intentionally omit window bounds; they are interpreted
+// relative to the existing window on load.
+std::vector<std::unique_ptr<sessions::SessionCommand>> BuildWorkspaceCommands(
+    const HeliumSerializedWorkspace& workspace);
+
+// Inverse of BuildWorkspaceCommands. Must run on the UI thread because
+// restoring session objects allocates SessionIDs there. Returns nullptr when
+// |commands| is empty or does not describe at least one tab.
+std::unique_ptr<HeliumSerializedWorkspace> ParseWorkspaceCommands(
+    const std::vector<std::unique_ptr<sessions::SessionCommand>>& commands);
+
+#endif  // CHROME_BROWSER_UI_HELIUM_HELIUM_WORKSPACE_UTILS_H_

