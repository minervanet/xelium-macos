+// Modal rename dialog. Caches the text on every change; the Textfield is
+// owned by the contents view and never touched after the dialog closes.
+// (Plain WidgetDelegate: subclassing DialogDelegateView is not allowed for
+// new code, and the transient rename UI does not need dialog-model hosting.)
+class WorkspaceNameDialog : public views::WidgetDelegate,
+                            public views::TextfieldController {
+ public:
+  using Validator = base::RepeatingCallback<bool(const std::string&)>;
+  using ResultCallback = base::OnceCallback<void(const std::string&)>;
+
+  static void Show(gfx::NativeWindow parent,
+                   const std::u16string& title,
+                   const std::string& initial,
+                   Validator validator,
+                   ResultCallback callback) {
+    auto dialog = std::make_unique<WorkspaceNameDialog>(
+        title, initial, std::move(validator), std::move(callback));
+    WorkspaceNameDialog* dialog_ptr = dialog.get();
+    views::Widget* widget = views::DialogDelegate::CreateDialogWidget(
+        std::move(dialog), parent, gfx::NativeView());
+    widget->Show();
+    dialog_ptr->textfield_->RequestFocus();
+    dialog_ptr->UpdateOkButton();
+  }
+
+  WorkspaceNameDialog(const std::u16string& title,
+                      const std::string& initial,
+                      Validator validator,
+                      ResultCallback callback)
+      : validator_(std::move(validator)), callback_(std::move(callback)) {
+    SetTitle(title);
+    SetModalType(ui::mojom::ModalType::kWindow);
+    auto contents = std::make_unique<views::View>();
+    contents->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical,
+        gfx::Insets::VH(12, 16), 8));
+    auto textfield = std::make_unique<views::Textfield>();
+    textfield->SetText(base::UTF8ToUTF16(initial));
+    textfield->SelectAll(false);
+    textfield->SetAccessibleName(title);
+    textfield->SetController(this);
+    textfield->SetPreferredSize(
+        gfx::Size(280, textfield->GetPreferredSize().height()));
+    textfield_ = textfield.get();
+    contents->AddChildView(std::move(textfield));
+    auto buttons = std::make_unique<views::View>();
+    buttons->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 8));
+    auto spacer = std::make_unique<views::View>();
+    spacer->SetProperty(
+        views::kFlexBehaviorKey,
+        views::FlexSpecification(views::MinimumFlexSizeRule::kScaleToZero,
+                                 views::MaximumFlexSizeRule::kUnbounded));
+    buttons->AddChildView(std::move(spacer));
+    auto cancel = std::make_unique<views::LabelButton>(
+        base::BindRepeating(&WorkspaceNameDialog::OnCancel,
+                            base::Unretained(this)),
+        l10n_util::GetStringUTF16(IDS_CANCEL));
+    buttons->AddChildView(std::move(cancel));
+    auto ok = std::make_unique<views::LabelButton>(
+        base::BindRepeating(&WorkspaceNameDialog::OnAccept,
+                            base::Unretained(this)),
+        l10n_util::GetStringUTF16(IDS_OK));
+    ok->SetIsDefault(true);
+    ok_button_ = ok.get();
+    buttons->AddChildView(std::move(ok));
+    contents->AddChildView(std::move(buttons));
+    name_ = initial;
+    SetContentsView(std::move(contents));
+  }
+  ~WorkspaceNameDialog() override = default;
+
+  // views::TextfieldController:
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string& new_contents) override {
+    name_ = base::UTF16ToUTF8(new_contents);
+    UpdateOkButton();
+  }
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& key_event) override {
+    if (key_event.key_code() == ui::VKEY_RETURN) {
+      OnAccept();
+      return true;
+    }
+    return false;
+  }
+
+ private:
+  void OnAccept() {
+    if (!validator_.is_null() && !validator_.Run(name_)) {
+      return;
+    }
+    ResultCallback callback = std::move(callback_);
+    if (views::Widget* widget = GetWidget()) {
+      widget->Close();
+    }
+    std::move(callback).Run(name_);
+  }
+  void OnCancel() {
+    if (views::Widget* widget = GetWidget()) {
+      widget->Close();
+    }
+  }
+  void UpdateOkButton() {
+    if (ok_button_) {
+      ok_button_->SetEnabled(validator_.is_null() ||
+                             validator_.Run(name_));
+    }
+  }
+
+  // Cached on every keystroke; the Textfield itself is never touched here.
+  std::string name_;
+  Validator validator_;
+  ResultCallback callback_;
+  raw_ptr<views::Textfield> textfield_ = nullptr;
+  raw_ptr<views::LabelButton> ok_button_ = nullptr;
+};
+
+// One row: status dot plus (when expanded) the workspace name. Left-click
+// switches, right-click opens rename/delete.
+class HeliumWorkspaceSwitcherView::WorkspaceItemView
+    : public views::View,
+      public ui::SimpleMenuModel::Delegate {
+  METADATA_HEADER(WorkspaceItemView, views::View)
+
+ public:
+  WorkspaceItemView(BrowserWindowInterface* browser,
+                    const std::string& id,
+                    const std::string& name,
+                    bool active,
+                    int tab_count)
+      : browser_(browser), id_(id), active_(active) {
+    SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 6));
+    dot_ = AddChildView(std::make_unique<views::View>());
+    dot_->SetPreferredSize(gfx::Size(kDotHitSize, kDotHitSize));
+    label_ = AddChildView(std::make_unique<views::Label>(
+        base::UTF8ToUTF16(name)));
+    label_->SetElideBehavior(gfx::ElideBehavior::ELIDE_TAIL);
+    label_->SetMaximumWidth(120);
+    label_->SetCanProcessEventsWithinSubtree(false);
+    SetTooltipText(TooltipFor(name, active, tab_count));
+    GetViewAccessibility().SetRole(ax::mojom::Role::kButton);
+    GetViewAccessibility().SetName(base::UTF8ToUTF16(name));
+    SetFocusBehavior(FocusBehavior::ACCESSIBLE_ONLY);
+  }
+  ~WorkspaceItemView() override = default;
+
+  void SetCollapsed(bool collapsed) {
+    label_->SetVisible(!collapsed);
+    InvalidateLayout();
+  }
+
+  void SetActive(bool active) { active_ = active; }
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override {
+    views::View::OnPaint(canvas);
+    const gfx::Rect dot_bounds = dot_->bounds();
+    const gfx::PointF center(dot_bounds.CenterPoint());
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    if (active_) {
+      flags.setStyle(cc::PaintFlags::kFill_Style);
+      flags.setColor(GetColorProvider()->GetColor(ui::kColorSysPrimary));
+      canvas->DrawCircle(center, kDotRadius, flags);
+    } else {
+      flags.setStyle(cc::PaintFlags::kStroke_Style);
+      flags.setStrokeWidth(kDotRingWidth);
+      flags.setColor(GetColorProvider()->GetColor(ui::kColorSysOutline));
+      canvas->DrawCircle(center, kDotRadius, flags);
+    }
+  }
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    return true;
+  }
+  void OnMouseReleased(const ui::MouseEvent& event) override {
+    if (event.IsOnlyRightMouseButton()) {
+      ShowWorkspaceMenu(event.location());
+      return;
+    }
+    if (event.IsOnlyLeftMouseButton()) {
+      if (HeliumWorkspaceController* controller =
+              HeliumWorkspaceController::From(browser_)) {
+        controller->SwitchToWorkspace(id_);
+      }
+    }
+  }
+  bool OnKeyPressed(const ui::KeyEvent& event) override {
+    if (event.key_code() == ui::VKEY_RETURN ||
+        event.key_code() == ui::VKEY_SPACE) {
+      if (HeliumWorkspaceController* controller =
+              HeliumWorkspaceController::From(browser_)) {
+        controller->SwitchToWorkspace(id_);
+      }
+      return true;
+    }
+    return false;
+  }
+  // ui::SimpleMenuModel::Delegate:
+  bool IsCommandIdChecked(int command_id) const override { return false; }
+  bool IsCommandIdEnabled(int command_id) const override {
+    HeliumWorkspaceController* controller =
+        HeliumWorkspaceController::From(browser_);
+    if (!controller || !controller->IsAvailable()) {
+      return false;
+    }
+    if (command_id == kDeleteCommand) {
+      return controller->GetWorkspaces().size() > 1;
+    }
+    return true;
+  }
+  bool GetAcceleratorForCommandId(
+      int command_id,
+      ui::Accelerator* accelerator) const override {
+    return false;
+  }
+  void ExecuteCommand(int command_id, int event_flags) override {
+    HeliumWorkspaceController* controller =
+        HeliumWorkspaceController::From(browser_);
+    if (!controller || !controller->IsAvailable()) {
+      return;
+    }
+    if (command_id == kRenameCommand) {
+      std::string id = id_;
+      base::WeakPtr<HeliumWorkspaceController> weak_controller =
+          controller->GetWeakPtr();
+      WorkspaceNameDialog::Show(
+          GetWidget() ? GetWidget()->GetNativeWindow()
+                      : gfx::NativeWindow(),
+          l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_RENAME_TITLE),
+          NameFor(controller, id),
+          base::BindRepeating(
+              [](base::WeakPtr<HeliumWorkspaceController> c,
+                 const std::string& self, const std::string& candidate) {
+                if (!c || candidate.empty()) {
+                  return false;
+                }
+                for (const auto& entry : c->GetWorkspaces()) {
+                  if (entry.id != self && entry.name == candidate) {
+                    return false;
+                  }
+                }
+                return true;
+              },
+              weak_controller, id),
+          base::BindOnce(
+              [](base::WeakPtr<HeliumWorkspaceController> c,
+                 const std::string& self, const std::string& name) {
+                if (c) {
+                  c->RenameWorkspace(self, name);
+                }
+              },
+              weak_controller, id));
+    } else if (command_id == kDeleteCommand) {
+      controller->DeleteWorkspace(id_);
+    }
+  }
+
+ private:
+  static std::string NameFor(HeliumWorkspaceController* controller,
+                             const std::string& id) {
+    for (const auto& entry : controller->GetWorkspaces()) {
+      if (entry.id == id) {
+        return entry.name;
+      }
+    }
+    return std::string();
+  }
+
+  void ShowWorkspaceMenu(const gfx::Point& point) {
+    context_menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+    context_menu_model_->AddItem(
+        kRenameCommand,
+        l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_RENAME));
+    context_menu_model_->AddItem(
+        kDeleteCommand,
+        l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_DELETE));
+    context_menu_runner_ = std::make_unique<views::MenuRunner>(
+        context_menu_model_.get(),
+        views::MenuRunner::HAS_MNEMONICS | views::MenuRunner::CONTEXT_MENU);
+    gfx::Point screen_point = point;
+    ConvertPointToScreen(this, &screen_point);
+    context_menu_runner_->RunMenuAt(
+        GetWidget(), nullptr, gfx::Rect(screen_point, gfx::Size()),
+        views::MenuAnchorPosition::kTopLeft,
+        ui::mojom::MenuSourceType::kMouse);
+  }
+
+  static constexpr int kRenameCommand = 1;
+  static constexpr int kDeleteCommand = 2;
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  const std::string id_;
+  bool active_;
+  raw_ptr<views::View> dot_ = nullptr;
+  raw_ptr<views::Label> label_ = nullptr;
+  std::unique_ptr<ui::SimpleMenuModel> context_menu_model_;
+  std::unique_ptr<views::MenuRunner> context_menu_runner_;
+};
+
+HeliumWorkspaceSwitcherView::HeliumWorkspaceSwitcherView(
+    BrowserWindowInterface* browser,
+    tabs::VerticalTabStripStateController* state_controller)
+    : browser_(browser) {
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 2));
+  HeliumWorkspaceController* controller =
+      HeliumWorkspaceController::From(browser);
+  if (controller) {
+    controller_subscription_ = controller->AddObserver(base::BindRepeating(
+        &HeliumWorkspaceSwitcherView::OnControllerChanged,
+        base::Unretained(this)));
+  }
+  if (state_controller) {
+    collapse_subscription_ =
+        state_controller->RegisterOnCollapseChanged(base::BindRepeating(
+            &HeliumWorkspaceSwitcherView::OnCollapseStateChanged,
+            base::Unretained(this)));
+    OnCollapseStateChanged(state_controller->GetCollapseState());
+  }
+  Refresh();
+}
+
+HeliumWorkspaceSwitcherView::~HeliumWorkspaceSwitcherView() = default;
+
+void HeliumWorkspaceSwitcherView::Refresh() {
+  RemoveAllChildViews();
+  items_.clear();
+  HeliumWorkspaceController* controller =
+      HeliumWorkspaceController::From(browser_);
+  const bool available = controller && controller->IsAvailable();
+  SetVisible(available);
+  if (!available) {
+    return;
+  }
+  for (const auto& entry : controller->GetWorkspaces()) {
+    auto item = std::make_unique<WorkspaceItemView>(
+        browser_, entry.id, entry.name, entry.active, entry.tab_count);
+    item->SetCollapsed(collapsed_);
+    items_.push_back(item.get());
+    AddChildView(std::move(item));
+  }
+  // "New workspace" affordance. An ImageButton keeps hover feedback without
+  // any opaque fill, so the translucent sidebar material shows through.
+  auto add_button = std::make_unique<views::ImageButton>(
+      base::BindRepeating(
+          [](BrowserWindowInterface* browser) {
+            if (HeliumWorkspaceController* c =
+                    HeliumWorkspaceController::From(browser)) {
+              c->CreateWorkspace();
+            }
+          },
+          browser_));
+  add_button->SetImageModel(
+      views::Button::STATE_NORMAL,
+      ui::ImageModel::FromVectorIcon(kAddIcon, ui::kColorMenuIcon,
+                                     kDotHitSize - 8));
+  add_button->SetTooltipText(
+      l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_NEW));
+  add_button->SetPreferredSize(gfx::Size(kDotHitSize, kDotHitSize));
+  AddChildView(std::move(add_button));
+  InvalidateLayout();
+  SchedulePaint();
+}
+
+void HeliumWorkspaceSwitcherView::OnControllerChanged() {
+  Refresh();
+}
+
+void HeliumWorkspaceSwitcherView::OnCollapseStateChanged(
+    tabs::VerticalTabStripCollapseState state) {
+  const bool collapsed =
+      state != tabs::VerticalTabStripCollapseState::kExpanded;
+  if (collapsed == collapsed_) {
+    UpdateLayoutForCollapse(collapsed_);
+    return;
+  }
+  collapsed_ = collapsed;
+  UpdateLayoutForCollapse(collapsed_);
+}
+
+void HeliumWorkspaceSwitcherView::UpdateLayoutForCollapse(bool collapsed) {
+  // Items always stack vertically above the new-tab button: expanded strips
+  // are narrow (160 px), so a horizontal row of named workspaces would
+  // overflow. Only the name labels collapse away.
+  for (WorkspaceItemView* item : items_) {
+    item->SetCollapsed(collapsed);
+  }
+  InvalidateLayout();
+}
