+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/helium_workspace_service.h"
+
+#include <string>
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/json/values_util.h"
+#include "base/logging.h"
+#include "base/task/bind_post_task.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+#include "components/sessions/core/command_storage_backend.h"
+#include "components/sessions/core/command_storage_manager.h"
+#include "components/sessions/core/command_storage_read_status.h"
+
+namespace {
+
+constexpr char kWorkspaceNameKey[] = "name";
+constexpr char kWorkspaceModifiedAtKey[] = "modified_at";
+constexpr char kWorkspaceTabCountKey[] = "tabs";
+
+void WriteWorkspaceToDisk(
+    std::vector<std::unique_ptr<sessions::SessionCommand>> commands,
+    const base::FilePath& workspace_path,
+    scoped_refptr<sessions::CommandStorageBackend> backend) {
+  if (!base::CreateDirectory(workspace_path)) {
+    LOG(WARNING) << "Workspaces: cannot create directory " << workspace_path;
+    return;
+  }
+  // AppendCommands with truncate performs the whole write on the backend's
+  // owning task runner path; the error callback runs on the UI thread.
+  backend->AppendCommands(std::move(commands), /*truncate=*/true,
+                          base::BindOnce([] {
+                            LOG(WARNING)
+                                << "Workspaces: failed to write workspace file";
+                          }));
+}
+
+sessions::CommandStorageBackend::ReadCommandsResult ReadWorkspaceFromDisk(
+    scoped_refptr<sessions::CommandStorageBackend> backend) {
+  return backend->ReadLastSessionCommands();
+}
+
+void OnWorkspaceRead(
+    HeliumWorkspaceService::LoadCallback callback,
+    sessions::CommandStorageBackend::ReadCommandsResult result) {
+  if (sessions::IsCommandStorageReadError(result.status)) {
+    std::move(callback).Run({});
+    return;
+  }
+  std::move(callback).Run(std::move(result.commands));
+}
+
+void DeleteWorkspaceDir(const base::FilePath& path) {
+  if (!base::DeletePathRecursively(path)) {
+    LOG(WARNING) << "Workspaces: cannot delete directory " << path;
+  }
+}
+
+}  // namespace
+
+HeliumWorkspaceService::HeliumWorkspaceService(Profile* profile)
+    : profile_(profile),
+      workspaces_path_(profile->GetPath().AppendASCII("helium_workspaces")),
+      io_task_runner_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+           base::TaskShutdownBehavior::BLOCK_SHUTDOWN})) {}
+
+HeliumWorkspaceService::~HeliumWorkspaceService() = default;
+
+std::vector<HeliumWorkspaceService::WorkspaceInfo>
+HeliumWorkspaceService::ListWorkspaces() const {
+  std::vector<WorkspaceInfo> result;
+  PrefService* prefs = profile_->GetPrefs();
+  const base::DictValue& metadata =
+      prefs->GetDict(prefs::kHeliumWorkspacesMetadata);
+  const base::ListValue& order =
+      prefs->GetList(prefs::kHeliumWorkspacesOrder);
+  for (const base::Value& entry : order) {
+    const std::string* id = entry.GetIfString();
+    if (!id || id->empty()) {
+      continue;
+    }
+    const base::DictValue* info = metadata.FindDict(*id);
+    if (!info) {
+      continue;
+    }
+    const std::string* name = info->FindString(kWorkspaceNameKey);
+    if (!name || name->empty()) {
+      continue;
+    }
+    WorkspaceInfo workspace;
+    workspace.id = *id;
+    workspace.name = *name;
+    workspace.modified_at =
+        base::ValueToTime(info->Find(kWorkspaceModifiedAtKey))
+            .value_or(base::Time());
+    workspace.tab_count = info->FindInt(kWorkspaceTabCountKey).value_or(-1);
+    result.push_back(std::move(workspace));
+  }
+  return result;
+}
+
+bool HeliumWorkspaceService::HasWorkspace(const std::string& id) const {
+  if (id.empty()) {
+    return false;
+  }
+  return profile_->GetPrefs()
+      ->GetDict(prefs::kHeliumWorkspacesMetadata)
+      .contains(id);
+}
+
+std::string HeliumWorkspaceService::GetWorkspaceName(
+    const std::string& id) const {
+  const base::DictValue* info = profile_->GetPrefs()
+                                       ->GetDict(prefs::kHeliumWorkspacesMetadata)
+                                       .FindDict(id);
+  if (!info) {
+    return std::string();
+  }
+  const std::string* name = info->FindString(kWorkspaceNameKey);
+  return name ? *name : std::string();
+}
+
+void HeliumWorkspaceService::SaveWorkspace(
+    const std::string& id,
+    const std::string& name,
+    std::vector<std::unique_ptr<sessions::SessionCommand>> commands,
+    int tab_count) {
+  if (id.empty() || name.empty()) {
+    return;
+  }
+  PrefService* prefs = profile_->GetPrefs();
+  {
+    ScopedDictPrefUpdate metadata_update(prefs,
+                                         prefs::kHeliumWorkspacesMetadata);
+    base::DictValue entry;
+    entry.Set(kWorkspaceNameKey, name);
+    entry.Set(kWorkspaceModifiedAtKey,
+              base::TimeToValue(base::Time::Now()));
+    entry.Set(kWorkspaceTabCountKey, tab_count);
+    metadata_update->Set(id, std::move(entry));
+  }
+  {
+    ScopedListPrefUpdate order_update(prefs, prefs::kHeliumWorkspacesOrder);
+    bool found = false;
+    for (const base::Value& entry : *order_update) {
+      if (entry.GetString() == id) {
+        found = true;
+        break;
+      }
+    }
+    if (!found) {
+      order_update->Append(base::Value(id));
+    }
+  }
+  scoped_refptr<sessions::CommandStorageBackend> backend = GetBackend(id);
+  const base::FilePath path = GetWorkspacePath(id);
+  io_task_runner_->PostTask(
+      FROM_HERE, base::BindOnce(&WriteWorkspaceToDisk, std::move(commands),
+                                std::move(path), std::move(backend)));
+}
+
+bool HeliumWorkspaceService::RenameWorkspace(const std::string& id,
+                                            const std::string& name) {
+  if (id.empty() || name.empty()) {
+    return false;
+  }
+  PrefService* prefs = profile_->GetPrefs();
+  const base::DictValue& metadata =
+      prefs->GetDict(prefs::kHeliumWorkspacesMetadata);
+  if (!metadata.contains(id)) {
+    return false;
+  }
+  for (const auto [key, value] : metadata) {
+    if (key == id) {
+      continue;
+    }
+    const std::string* other = value.GetDict().FindString(kWorkspaceNameKey);
+    if (other && *other == name) {
+      return false;
+    }
+  }
+  ScopedDictPrefUpdate update(prefs, prefs::kHeliumWorkspacesMetadata);
+  base::DictValue* entry = update->FindDict(id);
+  if (!entry) {
+    return false;
+  }
+  entry->Set(kWorkspaceNameKey, name);
+  entry->Set(kWorkspaceModifiedAtKey, base::TimeToValue(base::Time::Now()));
+  return true;
+}
+
+void HeliumWorkspaceService::LoadWorkspace(const std::string& id,
+                                           LoadCallback callback) {
+  scoped_refptr<sessions::CommandStorageBackend> backend = GetBackend(id);
+  io_task_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE, base::BindOnce(&ReadWorkspaceFromDisk, std::move(backend)),
+      base::BindOnce(&OnWorkspaceRead, std::move(callback)));
+}
+
+void HeliumWorkspaceService::DeleteWorkspace(const std::string& id) {
+  if (id.empty()) {
+    return;
+  }
+  PrefService* prefs = profile_->GetPrefs();
+  {
+    ScopedDictPrefUpdate metadata_update(prefs,
+                                         prefs::kHeliumWorkspacesMetadata);
+    metadata_update->Remove(id);
+  }
+  {
+    ScopedListPrefUpdate order_update(prefs, prefs::kHeliumWorkspacesOrder);
+    order_update->EraseValue(base::Value(id));
+  }
+  if (GetActiveWorkspaceId() == id) {
+    prefs->SetString(prefs::kHeliumWorkspacesActive, std::string());
+  }
+  backends_.erase(id);
+  io_task_runner_->PostTask(
+      FROM_HERE, base::BindOnce(&DeleteWorkspaceDir, GetWorkspacePath(id)));
+}
+
+std::string HeliumWorkspaceService::GetActiveWorkspaceId() const {
+  return profile_->GetPrefs()->GetString(prefs::kHeliumWorkspacesActive);
+}
+
+void HeliumWorkspaceService::SetActiveWorkspaceId(const std::string& id) {
+  profile_->GetPrefs()->SetString(prefs::kHeliumWorkspacesActive, id);
+}
+
+base::WeakPtr<HeliumWorkspaceService> HeliumWorkspaceService::GetWeakPtr() {
+  return weak_factory_.GetWeakPtr();
+}
+
+void HeliumWorkspaceService::Shutdown() {
+  weak_factory_.InvalidateWeakPtrs();
+  backends_.clear();
+}
+
+base::FilePath HeliumWorkspaceService::GetWorkspacePath(
+    const std::string& id) const {
+  return workspaces_path_.AppendASCII(id);
+}
+
+scoped_refptr<sessions::CommandStorageBackend>
+HeliumWorkspaceService::GetBackend(const std::string& id) {
+  const auto it = backends_.find(id);
+  if (it != backends_.end()) {
+    return it->second;
+  }
+  // Must be constructed on the UI thread: the backend captures the current
+  // task runner for its callbacks.
+  auto backend = base::MakeRefCounted<sessions::CommandStorageBackend>(
+      io_task_runner_, GetWorkspacePath(id),
+      sessions::CommandStorageManager::SessionType::kSessionRestore,
+      /*encryptor=*/nullptr);
+  backends_[id] = backend;
+  return backend;
+}

