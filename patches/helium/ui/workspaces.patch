+class HeliumWorkspaceService;
+class Profile;
+
+namespace sessions {
+class CommandStorageBackend;
+}  // namespace sessions
+
+// Owns one HeliumWorkspaceService per regular (non-incognito) profile.
+// The service is created lazily on first use and performs no disk I/O until
+// a workspace is actually saved or loaded.
+class HeliumWorkspaceServiceFactory : public ProfileKeyedServiceFactory {
+ public:
+  static HeliumWorkspaceService* GetForProfile(Profile* profile);
+  static HeliumWorkspaceService* GetForProfileIfExisting(Profile* profile);
+
+  static HeliumWorkspaceServiceFactory* GetInstance();
+
+  HeliumWorkspaceServiceFactory(const HeliumWorkspaceServiceFactory&) = delete;
+  HeliumWorkspaceServiceFactory& operator=(
+      const HeliumWorkspaceServiceFactory&) = delete;
+
+ private:
+  friend class base::NoDestructor<HeliumWorkspaceServiceFactory>;
+
+  HeliumWorkspaceServiceFactory();
+  ~HeliumWorkspaceServiceFactory() override;
+
+  // ProfileKeyedServiceFactory:
+  std::unique_ptr<KeyedService> BuildServiceInstanceForBrowserContext(
+      content::BrowserContext* context) const override;
+  bool ServiceIsNULLWhileTesting() const override;
+};
+
+#endif  // CHROME_BROWSER_UI_HELIUM_HELIUM_WORKSPACE_SERVICE_FACTORY_H_

