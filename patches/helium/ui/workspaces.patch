+void HeliumWorkspaceController::FlushSave() {
+  autosave_timer_.Stop();
+  SaveActiveWorkspace();
+}
+
+void HeliumWorkspaceController::ScheduleAutosave() {
+  if (!IsAvailable() || active_id_.empty()) {
+    return;
+  }
+  autosave_timer_.Start(
+      FROM_HERE, base::Seconds(1),
+      base::BindOnce(&HeliumWorkspaceController::SaveActiveWorkspace,
+                     base::Unretained(this)));
+}
+
+void HeliumWorkspaceController::OnTabStripModelChanged(
+    TabStripModel* model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  // Selection changes do not alter the saved tab set. Everything else
+  // (open/close/move/pin/group) does, and is coalesced by the timer.
+  if (change.type() == TabStripModelChange::kSelectionOnly) {
+    return;
+  }
+  ScheduleAutosave();
+}
+
+void HeliumWorkspaceController::OnTabStripModelDestroyed(TabStripModel* model) {
+  autosave_timer_.Stop();
+}
+
+void HeliumWorkspaceController::OnBrowserCreated(
+    BrowserWindowInterface* browser) {
+  OnWindowSetChanged();
+}
+
+void HeliumWorkspaceController::OnBrowserClosed(BrowserWindowInterface* browser) {
+  OnWindowSetChanged();
+}
+
+void HeliumWorkspaceController::OnWindowSetChanged() {
+  if (!IsAvailable()) {
+    return;
+  }
+  if (!ever_available_) {
+    // Workspaces just became available here because the previous owner
+    // closed. Keep this window's current tabs in their own workspace so the
+    // closed window's saved tabs are not overwritten.
+    ever_available_ = true;
+    EnsureWorkspaces();
+    AdoptVisibleTabsAsNewWorkspace();
+    NotifyChanged();
+    return;
+  }
+  EnsureWorkspaces();
+  NotifyChanged();
+}
+
+void HeliumWorkspaceController::AdoptVisibleTabsAsNewWorkspace() {
+  HeliumWorkspaceService* service = GetService();
+  TabStripModel* tab_strip = GetTabStripModel();
+  if (!service || !tab_strip || tab_strip->count() == 0) {
+    return;
+  }
+  const std::string id = base::UnguessableToken::Create().ToString();
+  std::string name = "Workspace";
+  int suffix = static_cast<int>(service->ListWorkspaces().size()) + 1;
+  auto name_taken = [&](const std::string& candidate) {
+    for (const auto& info : service->ListWorkspaces()) {
+      if (info.name == candidate) {
+        return true;
+      }
+    }
+    return false;
+  };
+  while (name_taken(name)) {
+    name = "Workspace " + base::NumberToString(suffix++);
+  }
+  service->SaveWorkspace(id, name, {}, tab_strip->count());
+  active_id_ = id;
+  service->SetActiveWorkspaceId(id);
+  SaveActiveWorkspace();
+}
+
+HeliumWorkspaceService* HeliumWorkspaceController::GetService() const {
+  Profile* profile = browser_ ? browser_->GetProfile() : nullptr;
+  if (!profile) {
+    return nullptr;
+  }
+  return HeliumWorkspaceServiceFactory::GetForProfile(profile);
+}
+
+TabStripModel* HeliumWorkspaceController::GetTabStripModel() const {
+  return browser_ ? browser_->GetTabStripModel() : nullptr;
+}
+
+void HeliumWorkspaceController::EnsureWorkspaces() {
+  HeliumWorkspaceService* service = GetService();
+  if (!service) {
+    return;
+  }
+  if (service->ListWorkspaces().empty()) {
+    service->SaveWorkspace(kDefaultWorkspaceId, kDefaultWorkspaceName, {},
+                           GetTabStripModel() ? GetTabStripModel()->count()
+                                              : 0);
+  }
+  std::string active = service->GetActiveWorkspaceId();
+  if (active.empty() || !service->HasWorkspace(active)) {
+    active = service->HasWorkspace(kDefaultWorkspaceId)
+                 ? kDefaultWorkspaceId
+                 : service->ListWorkspaces().front().id;
+    service->SetActiveWorkspaceId(active);
+  }
+  active_id_ = active;
+}
+
+void HeliumWorkspaceController::OnEnabledPrefChanged() {
+  if (IsAvailable()) {
+    ever_available_ = true;
+    EnsureWorkspaces();
+    NotifyChanged();
+    return;
+  }
+  // The feature was just turned off (or the window stopped qualifying):
+  // fold every detached tab back into the strip so nothing stays hidden.
+  if (TabStripModel* tab_strip = GetTabStripModel()) {
+    for (auto& [id, snapshot] : snapshots_) {
+      if (snapshot.TabCount() > 0) {
+        InsertSnapshot(std::move(snapshot));
+      }
+    }
+    (void)tab_strip;
+  }
+  snapshots_.clear();
+  pending_moves_.clear();
+  parked_at_.clear();
+  NotifyChanged();
+}
+
+void HeliumWorkspaceController::SaveActiveWorkspace() {
+  HeliumWorkspaceService* service = GetService();
+  TabStripModel* tab_strip = GetTabStripModel();
+  if (!service || !tab_strip || active_id_.empty()) {
+    return;
+  }
+  HeliumSerializedWorkspace serialized =
+      SerializeLiveTabStrip(tab_strip, /*include_pinned=*/false);
+  const int tab_count = static_cast<int>(serialized.tabs.size());
+  service->SaveWorkspace(active_id_, service->GetWorkspaceName(active_id_),
+                         BuildWorkspaceCommands(serialized), tab_count);
+}
+
+void HeliumWorkspaceController::SaveSnapshot(const std::string& id) {
+  HeliumWorkspaceService* service = GetService();
+  if (!service || id.empty()) {
+    return;
+  }
+  auto snapshot_it = snapshots_.find(id);
+  if (snapshot_it == snapshots_.end()) {
+    return;
+  }
+  const Snapshot& snapshot = snapshot_it->second;
+  HeliumSerializedWorkspace serialized;
+  serialized.groups.reserve(snapshot.group_visuals.size());
+  for (const auto& visuals : snapshot.group_visuals) {
+    HeliumSerializedWorkspace::Group group;
+    group.visual_data = visuals;
+    serialized.groups.push_back(std::move(group));
+  }
+  serialized.splits.reserve(snapshot.split_visuals.size());
+  for (const auto& visuals : snapshot.split_visuals) {
+    HeliumSerializedWorkspace::Split split;
+    split.visual_data = visuals;
+    serialized.splits.push_back(std::move(split));
+  }
+  serialized.active_index =
+      std::clamp(snapshot.active_index, 0,
+                 std::max(0, snapshot.TabCount() - 1));
+  auto push_tab = [&](content::WebContents* contents, bool pinned,
+                      std::optional<int> slot,
+                      std::optional<int> split_slot) {
+    HeliumSerializedWorkspace::Tab out;
+    out.pinned = pinned;
+    if (slot.has_value() && slot.value() >= 0 &&
+        static_cast<size_t>(slot.value()) < serialized.groups.size()) {
+      out.group_slot = slot;
+    }
+    if (split_slot.has_value() && split_slot.value() >= 0 &&
+        static_cast<size_t>(split_slot.value()) < serialized.splits.size()) {
+      out.split_slot = split_slot;
+    }
+    if (contents) {
+      auto& controller = contents->GetController();
+      for (int i = 0; i < controller.GetEntryCount(); ++i) {
+        content::NavigationEntry* entry = controller.GetEntryAtIndex(i);
+        if (!entry) {
+          continue;
+        }
+        out.navigations.push_back(
+            sessions::ContentSerializedNavigationBuilder::
+                FromNavigationEntry(i, entry));
+      }
+      out.selected_navigation =
+          out.navigations.empty()
+              ? 0
+              : std::clamp(controller.GetCurrentEntryIndex(), 0,
+                           static_cast<int>(out.navigations.size()) - 1);
+    }
+    serialized.tabs.push_back(std::move(out));
+  };
+  std::map<const tabs::TabCollection*, int> live_split_slots;
+  auto split_slot_for = [&](const DetachedTabCollection& collection)
+      -> std::optional<int> {
+    if (collection.collection_.index() != 1) {
+      return std::nullopt;
+    }
+    const auto& split =
+        std::get<std::unique_ptr<tabs::SplitTabCollection>>(
+            collection.collection_);
+    auto inserted =
+        live_split_slots.try_emplace(split.get(), -1);
+    if (inserted.second) {
+      inserted.first->second = static_cast<int>(serialized.splits.size());
+      HeliumSerializedWorkspace::Split serialized_split;
+      if (split->data() && split->data()->visual_data()) {
+        serialized_split.visual_data = *split->data()->visual_data();
+      }
+      serialized.splits.push_back(std::move(serialized_split));
+    }
+    return inserted.first->second;
+  };
+  for (const auto& item : snapshot.live_items) {
+    if (std::holds_alternative<std::unique_ptr<DetachedTab>>(item)) {
+      const auto& detached =
+          std::get<std::unique_ptr<DetachedTab>>(item);
+      tabs::TabInterface* tab = detached->tab.get();
+      std::optional<int> slot;
+      if (auto group = tab->GetGroup(); group.has_value()) {
+        if (auto slot_it = snapshot.group_slots.find(group.value());
+            slot_it != snapshot.group_slots.end()) {
+          slot = slot_it->second;
+        }
+      }
+      push_tab(tab->GetContents(), /*pinned=*/false, slot, std::nullopt);
+      continue;
+    }
+    const auto& collection =
+        std::get<std::unique_ptr<DetachedTabCollection>>(item);
+    const std::optional<int> split_slot = split_slot_for(*collection);
+    ForEachDetachedTab(*collection, [&](tabs::TabInterface* tab) {
+      std::optional<int> slot;
+      if (auto group = tab->GetGroup(); group.has_value()) {
+        if (auto slot_it = snapshot.group_slots.find(group.value());
+            slot_it != snapshot.group_slots.end()) {
+          slot = slot_it->second;
+        }
+      }
+      push_tab(tab->GetContents(), /*pinned=*/false, slot, split_slot);
+    });
+  }
+  for (const auto& flat : snapshot.flat_tabs) {
+    std::optional<int> slot = flat.group_slot;
+    if (slot.has_value() &&
+        (slot.value() < 0 ||
+         static_cast<size_t>(slot.value()) >= serialized.groups.size())) {
+      slot = std::nullopt;
+    }
+    std::optional<int> split_slot = flat.split_slot;
+    if (split_slot.has_value() &&
+        (split_slot.value() < 0 ||
+         static_cast<size_t>(split_slot.value()) >=
+             serialized.splits.size())) {
+      split_slot = std::nullopt;
+    }
+    push_tab(flat.model ? flat.model->GetContents() : nullptr,
+             /*pinned=*/false, slot, split_slot);
+  }
+  const int tab_count = static_cast<int>(serialized.tabs.size());
+  service->SaveWorkspace(id, service->GetWorkspaceName(id),
+                         BuildWorkspaceCommands(serialized), tab_count);
+}
+
+HeliumWorkspaceController::Snapshot
+HeliumWorkspaceController::DetachVisibleTabs(
+    const std::vector<tabs::TabInterface*>& tabs_to_detach) {
+  Snapshot snapshot;
+  TabStripModel* tab_strip = GetTabStripModel();
+  if (!tab_strip || tabs_to_detach.empty()) {
+    return snapshot;
+  }
+  // Resolve current indices by identity: inserting the replacement tabs may
+  // have shifted positions (pinned tabs clamp into the pinned region).
+  std::vector<int> indices;
+  for (tabs::TabInterface* tab : tabs_to_detach) {
+    const int index = tab_strip->GetIndexOfTab(tab);
+    if (index != TabStripModel::kNoTab && !tab_strip->IsTabPinned(index)) {
+      indices.push_back(index);
+    }
+  }
+  if (indices.empty()) {
+    return snapshot;
+  }
+  std::sort(indices.begin(), indices.end());
+  // Record the active tab when it is part of the detached set.
+  const int active_index = tab_strip->active_index();
+  snapshot.active_index = 0;
+  for (size_t i = 0; i < indices.size(); ++i) {
+    if (indices[i] == active_index) {
+      snapshot.active_index = static_cast<int>(i);
+      break;
+    }
+  }
+  // Capture group visuals before detaching destroys the groups.
+  if (tab_strip->group_model()) {
+    for (const tab_groups::TabGroupId& group_id :
+         tab_strip->group_model()->ListTabGroups()) {
+      snapshot.group_slots[group_id] =
+          static_cast<int>(snapshot.group_visuals.size());
+      const TabGroup* group =
+          tab_strip->group_model()->GetTabGroup(group_id);
+      if (group && group->visual_data()) {
+        snapshot.group_visuals.push_back(*group->visual_data());
+      } else {
+        snapshot.group_visuals.emplace_back();
+      }
+    }
+  }
+  std::sort(indices.begin(), indices.end());
+  snapshot.live_items =
+      tab_strip->DetachTabsAndCollectionsForInsertion(indices);
+  return snapshot;
+}
+
+void HeliumWorkspaceController::ParkSnapshot(const std::string& id,
+                                             Snapshot snapshot) {
+  if (pending_delete_id_.has_value() && pending_delete_id_.value() == id) {
+    // The workspace was deleted while its tabs were still visible; let the
+    // snapshot (and the tabs it owns) be destroyed instead of parking them.
+    pending_delete_id_.reset();
+    return;
+  }
+  if (snapshot.TabCount() == 0) {
+    parked_at_.erase(id);
+  } else {
+    parked_at_[id] = base::TimeTicks::Now();
+  }
+  snapshots_[id] = std::move(snapshot);
+}
+
+void HeliumWorkspaceController::MaybeDiscardInactiveWorkspaces(
+    const std::string& target_id) {
+  // Keep recently used workspaces resident; older ones are reloaded from
+  // disk the next time they are opened. 30 minutes keeps the common
+  // back-and-forth case fast without letting memory grow forever.
+  constexpr base::TimeDelta kIdleTimeout = base::Minutes(30);
+  const base::TimeTicks cutoff = base::TimeTicks::Now() - kIdleTimeout;
+  for (auto it = snapshots_.begin(); it != snapshots_.end();) {
+    const std::string& id = it->first;
+    if (id == active_id_ || id == target_id) {
+      ++it;
+      continue;
+    }
+    auto parked = parked_at_.find(id);
+    if (parked == parked_at_.end() || parked->second > cutoff) {
+      ++it;
+      continue;
+    }
+    bool discardable = true;
+    auto check_tab = [&](tabs::TabInterface* tab) {
+      content::WebContents* contents = tab ? tab->GetContents() : nullptr;
+      if (!contents || contents->IsCurrentlyAudible() ||
+          contents->IsBeingCaptured() ||
+          contents->NeedToFireBeforeUnloadOrUnloadEvents()) {
+        discardable = false;
+      }
+    };
+    for (const auto& item : it->second.live_items) {
+      if (std::holds_alternative<std::unique_ptr<DetachedTab>>(item)) {
+        check_tab(std::get<std::unique_ptr<DetachedTab>>(item)->tab.get());
+      } else {
+        ForEachDetachedTab(
+            *std::get<std::unique_ptr<DetachedTabCollection>>(item),
+            [&](tabs::TabInterface* tab) { check_tab(tab); });
+      }
+    }
+    for (const auto& flat : it->second.flat_tabs) {
+      check_tab(flat.model.get());
+    }
+    if (!discardable) {
+      ++it;
+      continue;
+    }
+    // Persist the current state, then drop the live WebContents. The next
+    // switch materializes them from disk (tabs reload, like a discarded tab).
+    SaveSnapshot(id);
+    parked_at_.erase(parked);
+    it = snapshots_.erase(it);
+  }
+}
+
+void HeliumWorkspaceController::InsertSnapshot(Snapshot snapshot) {
+  TabStripModel* tab_strip = GetTabStripModel();
+  if (!tab_strip || tab_strip->count() == 0 ||
+      snapshot.TabCount() == 0) {
+    return;
+  }
+  int insert_position = tab_strip->count();
+  int original_position = 0;
+  int new_active_index = -1;
+  // Live-detached items first: groups and splits are reinserted whole, which
+  // preserves splits that a disk round-trip would flatten.
+  for (auto& item : snapshot.live_items) {
+    if (std::holds_alternative<std::unique_ptr<DetachedTab>>(item)) {
+      auto& detached = std::get<std::unique_ptr<DetachedTab>>(item);
+      // Pinned tabs are universal: legacy snapshots that still contain them
+      // come back as regular tabs so the visible pinned set never duplicates.
+      const int inserted = tab_strip->InsertDetachedTabAt(
+          insert_position, std::move(detached->tab), ADD_NONE,
+          /*group=*/std::nullopt);
+      if (original_position == snapshot.active_index) {
+        new_active_index = inserted;
+      }
+      ++original_position;
+      insert_position = inserted + 1;
+      continue;
+    }
+    auto& collection = std::get<std::unique_ptr<DetachedTabCollection>>(item);
+    const int collection_count = CountDetachedCollection(*collection);
+    std::optional<tab_groups::TabGroupId> group;
+    ForEachDetachedTab(*collection, [&](tabs::TabInterface* tab) {
+      if (!group.has_value()) {
+        group = tab->GetGroup();
+      }
+    });
+    gfx::Range inserted_range = collection->collection_.index() == 0
+                                    ? tab_strip->InsertDetachedTabGroupAt(
+                                          std::move(collection),
+                                          insert_position)
+                                    : tab_strip->InsertDetachedSplitTabAt(
+                                          std::move(collection),
+                                          insert_position, /*pinned=*/false,
+                                          group);
+    if (snapshot.active_index >= original_position &&
+        snapshot.active_index < original_position + collection_count) {
+      new_active_index =
+          inserted_range.start() + (snapshot.active_index - original_position);
+    }
+    original_position += collection_count;
+    insert_position = inserted_range.end();
+  }
+  // Then flat (disk-materialized or moved) tabs, regrouped by slot.
+  std::map<int, std::vector<int>> slot_indices;
+  std::map<int, std::vector<tabs::TabInterface*>> split_tabs;
+  for (auto& flat : snapshot.flat_tabs) {
+    const int inserted = tab_strip->InsertDetachedTabAt(
+        insert_position, std::move(flat.model), ADD_NONE,
+        /*group=*/std::nullopt);
+    if (flat.group_slot.has_value() && flat.group_slot.value() >= 0 &&
+        static_cast<size_t>(flat.group_slot.value()) <
+            snapshot.group_visuals.size()) {
+      slot_indices[flat.group_slot.value()].push_back(inserted);
+    }
+    if (flat.split_slot.has_value() && flat.split_slot.value() >= 0 &&
+        static_cast<size_t>(flat.split_slot.value()) <
+            snapshot.split_visuals.size()) {
+      if (tabs::TabInterface* tab = tab_strip->GetTabAtIndex(inserted)) {
+        split_tabs[flat.split_slot.value()].push_back(tab);
+      }
+    }
+    if (original_position == snapshot.active_index) {
+      new_active_index = inserted;
+    }
+    ++original_position;
+    insert_position = inserted + 1;
+  }
+  for (const auto& [slot, indices] : slot_indices) {
+    if (indices.empty()) {
+      continue;
+    }
+    const tab_groups::TabGroupId new_group =
+        tab_strip->AddToNewGroup(indices);
+    tab_strip->ChangeTabGroupVisuals(new_group,
+                                     snapshot.group_visuals[slot]);
+  }
+  // Restore split views last, once grouping has settled the final indices.
+  for (auto& [slot, members] : split_tabs) {
+    if (members.size() != 2) {
+      continue;
+    }
+    std::vector<int> indices;
+    for (tabs::TabInterface* tab : members) {
+      const int index = tab_strip->GetIndexOfTab(tab);
+      if (index >= 0) {
+        indices.push_back(index);
+      }
+    }
+    if (indices.size() != 2) {
+      continue;
+    }
+    std::sort(indices.begin(), indices.end());
+    tab_strip->RestoreSplit(split_tabs::SplitTabId::GenerateNew(), indices,
+                            snapshot.split_visuals[slot]);
+  }
+  if (new_active_index >= 0 && new_active_index < tab_strip->count()) {
+    tab_strip->ActivateTabAt(new_active_index);
+  }
+}
+
+HeliumWorkspaceController::Snapshot
+HeliumWorkspaceController::SnapshotFromSerialized(
+    std::unique_ptr<HeliumSerializedWorkspace> parsed) {
+  Snapshot snapshot;
+  Profile* profile = browser_ ? browser_->GetProfile() : nullptr;
+  TabStripModel* tab_strip = GetTabStripModel();
+  if (!parsed || !profile || !tab_strip) {
+    return snapshot;
+  }
+  snapshot.group_visuals.reserve(parsed->groups.size());
+  for (const auto& group : parsed->groups) {
+    snapshot.group_visuals.push_back(group.visual_data);
+  }
+  snapshot.split_visuals.reserve(parsed->splits.size());
+  for (const auto& split : parsed->splits) {
+    snapshot.split_visuals.push_back(split.visual_data);
+  }
+  snapshot.active_index = parsed->active_index;
+  for (const auto& tab : parsed->tabs) {
+    if (tab.navigations.empty()) {
+      continue;
+    }
+    content::WebContents::CreateParams create_params(profile);
+    create_params.initially_hidden = true;
+    create_params.desired_renderer_state =
+        content::WebContents::CreateParams::kNoRendererProcess;
+    std::unique_ptr<content::WebContents> contents =
+        content::WebContents::Create(create_params);
+    if (!contents) {
+      continue;
+    }
+    std::vector<std::unique_ptr<content::NavigationEntry>> entries =
+        sessions::ContentSerializedNavigationBuilder::ToNavigationEntries(
+            tab.navigations, profile);
+    contents->GetController().Restore(tab.selected_navigation,
+                                      content::RestoreType::kRestored,
+                                      &entries);
+    auto model = std::make_unique<tabs::TabModel>(std::move(contents),
+                                                 tab_strip);
+    // Pinned tabs are universal and live in the strip; older builds saved
+    // them per workspace, so restore those as regular tabs instead.
+    std::optional<int> split_slot;
+    if (tab.split_slot.has_value() && tab.split_slot.value() >= 0 &&
+        static_cast<size_t>(tab.split_slot.value()) <
+            snapshot.split_visuals.size()) {
+      split_slot = tab.split_slot;
+    }
+    snapshot.flat_tabs.push_back(FlatTab{std::move(model), /*pinned=*/false,
+                                         tab.group_slot, split_slot});
+  }
+  return snapshot;
+}
+
+void HeliumWorkspaceController::OnWorkspaceLoaded(
+    const std::string& id,
+    int switch_sequence,
+    std::vector<std::unique_ptr<sessions::SessionCommand>> commands) {
+  load_in_flight_ = false;
+  if (switch_sequence != switch_sequence_ || !IsAvailable()) {
+    // A newer load superseded this one, or the feature went away; the newer
+    // load (or the disable path) owns the pending state now.
+    pending_switch_.reset();
+    return;
+  }
+  HeliumWorkspaceService* service = GetService();
+  TabStripModel* tab_strip = GetTabStripModel();
+  if (!service || !tab_strip || tab_strip->count() == 0) {
+    pending_moves_.erase(id);
+    pending_switch_.reset();
+    return;
+  }
+  const bool is_switch =
+      pending_switch_.has_value() && pending_switch_.value() == id;
+  pending_switch_.reset();
+
+  Snapshot snapshot =
+      SnapshotFromSerialized(ParseWorkspaceCommands(commands));
+  // Fold in tabs that were moved here while the load was in flight.
+  if (auto pending_it = pending_moves_.find(id);
+      pending_it != pending_moves_.end()) {
+    PendingMove pending = std::move(pending_it->second);
+    pending_moves_.erase(pending_it);
+    const int slot_offset =
+        static_cast<int>(snapshot.group_visuals.size());
+    for (const auto& visuals : pending.visuals) {
+      snapshot.group_visuals.push_back(visuals);
+    }
+    const int split_slot_offset =
+        static_cast<int>(snapshot.split_visuals.size());
+    for (const auto& visuals : pending.split_visuals) {
+      snapshot.split_visuals.push_back(visuals);
+    }
+    for (auto& flat : pending.tabs) {
+      if (flat.group_slot.has_value()) {
+        flat.group_slot = flat.group_slot.value() + slot_offset;
+      }
+      if (flat.split_slot.has_value()) {
+        flat.split_slot = flat.split_slot.value() + split_slot_offset;
+      }
+      snapshot.flat_tabs.push_back(std::move(flat));
+    }
+  }
+  if (snapshot.TabCount() == 0) {
+    if (!is_switch) {
+      // Keep an empty in-memory entry so later moves have a target.
+      snapshots_[id] = Snapshot();
+      NotifyChanged();
+      return;
+    }
+    // A workspace can legitimately have no unpinned tabs (everything was
+    // moved away); the shared pinned tabs keep the strip alive. Only a strip
+    // with no pinned tabs needs a replacement tab before switching.
+    std::vector<tabs::TabInterface*> source_tabs;
+    bool has_pinned_tabs = false;
+    for (int i = 0; i < tab_strip->count(); ++i) {
+      if (tab_strip->IsTabPinned(i)) {
+        has_pinned_tabs = true;
+      } else {
+        source_tabs.push_back(tab_strip->GetTabAtIndex(i));
+      }
+    }
+    if (!has_pinned_tabs) {
+      chrome::NewTab(browser_, NewTabTypes::kNewTabCommand);
+    }
+    ParkSnapshot(active_id_, DetachVisibleTabs(source_tabs));
+    active_id_ = id;
+    service->SetActiveWorkspaceId(id);
+    NotifyChanged();
+    return;
+  }
+  snapshots_[id] = std::move(snapshot);
+  SaveSnapshot(id);
+  if (!is_switch) {
+    NotifyChanged();
+    return;
+  }
+  Snapshot to_insert = std::move(snapshots_[id]);
+  snapshots_.erase(id);
+  std::vector<tabs::TabInterface*> source_tabs;
+  for (int i = 0; i < tab_strip->count(); ++i) {
+    if (!tab_strip->IsTabPinned(i)) {
+      source_tabs.push_back(tab_strip->GetTabAtIndex(i));
+    }
+  }
+  InsertSnapshot(std::move(to_insert));
+  ParkSnapshot(active_id_, DetachVisibleTabs(source_tabs));
+  active_id_ = id;
+  service->SetActiveWorkspaceId(id);
+  NotifyChanged();
+}
+
+void HeliumWorkspaceController::NotifyChanged() {
+  observers_.Notify();
+}

