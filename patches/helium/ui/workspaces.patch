+
+// Submenu for the tab context menu listing the inactive workspaces as move
+// targets, plus a "new workspace" entry. Command ids start at
+// kMinCommandId and must not overlap the ranges reserved in tab_menu_model.h
+// for the other dynamic tab menu submenus.
+class HeliumWorkspaceMenuModel : public ui::SimpleMenuModel,
+                                 public ui::SimpleMenuModel::Delegate {
+ public:
+  static constexpr int kMinCommandId = 2001;
+  // One past the last usable command id (200 slots, like the other submenus).
+  static constexpr int kMaxCommandId = 2201;
+  static constexpr int kNewWorkspaceCommandId = 2201;
+
+  HeliumWorkspaceMenuModel(BrowserWindowInterface* browser,
+                           TabStripModel* tab_strip,
+                           int context_index);
+  HeliumWorkspaceMenuModel(const HeliumWorkspaceMenuModel&) = delete;
+  HeliumWorkspaceMenuModel& operator=(const HeliumWorkspaceMenuModel&) =
+      delete;
+  ~HeliumWorkspaceMenuModel() override;
+
+  // ui::SimpleMenuModel::Delegate:
+  bool IsCommandIdChecked(int command_id) const override;
+  bool IsCommandIdEnabled(int command_id) const override;
+  bool GetAcceleratorForCommandId(
+      int command_id,
+      ui::Accelerator* accelerator) const override;
+  void ExecuteCommand(int command_id, int event_flags) override;
+
+ private:
+  void Build();
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<TabStripModel> tab_strip_;
+  const int context_index_;
+  // Workspace ids in menu order, parallel to the first N commands.
+  std::vector<std::string> workspace_ids_;
+};
+
+#endif  // CHROME_BROWSER_UI_HELIUM_HELIUM_WORKSPACE_MENU_MODEL_H_

