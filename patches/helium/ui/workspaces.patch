+namespace {
+
+constexpr char kDefaultWorkspaceId[] = "default";
+constexpr char kDefaultWorkspaceName[] = "Default";
+constexpr size_t kMaxWorkspaceNameLength = 100;
+
+bool IsValidWorkspaceName(const std::string& name) {
+  if (name.empty() || name.size() > kMaxWorkspaceNameLength) {
+    return false;
+  }
+  return !base::TrimWhitespaceASCII(name, base::TRIM_ALL).empty();
+}
+
+// Iterates the tabs held by a detached collection.
+template <typename Fn>
+void ForEachDetachedTab(const DetachedTabCollection& collection, Fn fn) {
+  const tabs::TabCollection* inner =
+      collection.collection_.index() == 0
+          ? static_cast<const tabs::TabCollection*>(
+                std::get<std::unique_ptr<tabs::TabGroupTabCollection>>(
+                    collection.collection_)
+                    .get())
+          : static_cast<const tabs::TabCollection*>(
+                std::get<std::unique_ptr<tabs::SplitTabCollection>>(
+                    collection.collection_)
+                    .get());
+  for (tabs::TabInterface* tab : *inner) {
+    fn(tab);
+  }
+}
+
+int CountDetachedCollection(const DetachedTabCollection& collection) {
+  int count = 0;
+  ForEachDetachedTab(collection, [&](tabs::TabInterface*) { ++count; });
+  return count;
+}
+
+}  // namespace
+
+DEFINE_USER_DATA(HeliumWorkspaceController);
+
+// static
+HeliumWorkspaceController* HeliumWorkspaceController::From(
+    BrowserWindowInterface* browser) {
+  if (!browser) {
+    return nullptr;
+  }
+  return HeliumWorkspaceController::Get(browser->GetUnownedUserDataHost());
+}
+
+HeliumWorkspaceController::HeliumWorkspaceController(
+    BrowserWindowInterface* browser,
+    PrefService* pref_service)
+    : browser_(browser), pref_service_(pref_service) {
+  pref_registrar_.Init(pref_service_);
+  pref_registrar_.Add(
+      prefs::kHeliumWorkspacesEnabled,
+      base::BindRepeating(&HeliumWorkspaceController::OnEnabledPrefChanged,
+                          base::Unretained(this)));
+  if (IsAvailable()) {
+    EnsureWorkspaces();
+  }
+}
+
+HeliumWorkspaceController::~HeliumWorkspaceController() = default;
+
+int HeliumWorkspaceController::Snapshot::TabCount() const {
+  int count = static_cast<int>(flat_tabs.size());
+  for (const auto& item : live_items) {
+    if (std::holds_alternative<std::unique_ptr<DetachedTab>>(item)) {
+      count += 1;
+    } else {
+      count += CountDetachedCollection(
+          *std::get<std::unique_ptr<DetachedTabCollection>>(item));
+    }
+  }
+  return count;
+}
+
+bool HeliumWorkspaceController::IsAvailable() const {
+  if (!browser_ || !pref_service_) {
+    return false;
+  }
+  if (browser_->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL) {
+    return false;
+  }
+  Profile* profile = browser_->GetProfile();
+  if (!profile || profile->IsOffTheRecord() || profile->IsGuestSession()) {
+    return false;
+  }
+  return pref_service_->GetBoolean(prefs::kHeliumWorkspacesEnabled);
+}
+
+std::vector<HeliumWorkspaceController::WorkspaceEntry>
+HeliumWorkspaceController::GetWorkspaces() const {
+  std::vector<WorkspaceEntry> entries;
+  if (!IsAvailable()) {
+    return entries;
+  }
+  HeliumWorkspaceService* service = GetService();
+  if (!service) {
+    return entries;
+  }
+  TabStripModel* tab_strip = GetTabStripModel();
+  const int live_count = tab_strip ? tab_strip->count() : 0;
+  for (const auto& info : service->ListWorkspaces()) {
+    WorkspaceEntry entry;
+    entry.id = info.id;
+    entry.name = info.name;
+    entry.active = info.id == active_id_;
+    if (entry.active) {
+      entry.tab_count = live_count;
+    } else if (auto it = snapshots_.find(info.id); it != snapshots_.end()) {
+      entry.tab_count = it->second.TabCount();
+    } else {
+      entry.tab_count = info.tab_count;
+    }
+    entries.push_back(std::move(entry));
+  }
+  return entries;
+}
+
+bool HeliumWorkspaceController::SwitchToWorkspace(const std::string& id) {
+  if (!IsAvailable() || id.empty() || id == active_id_ || load_in_flight_) {
+    return false;
+  }
+  HeliumWorkspaceService* service = GetService();
+  TabStripModel* tab_strip = GetTabStripModel();
+  if (!service || !tab_strip || tab_strip->count() == 0 ||
+      !service->HasWorkspace(id)) {
+    return false;
+  }
+
+  // Persist what is visible now before hiding it.
+  SaveActiveWorkspace();
+
+  if (auto it = snapshots_.find(id); it != snapshots_.end()) {
+    Snapshot snapshot = std::move(it->second);
+    snapshots_.erase(it);
+    // Capture the source tabs by identity: inserting the replacement below
+    // may shift their positions.
+    std::vector<tabs::TabInterface*> source_tabs;
+    for (int i = 0; i < tab_strip->count(); ++i) {
+      source_tabs.push_back(tab_strip->GetTabAtIndex(i));
+    }
+    InsertSnapshot(std::move(snapshot));
+    snapshots_[active_id_] = DetachVisibleTabs(source_tabs);
+    active_id_ = id;
+    service->SetActiveWorkspaceId(id);
+    NotifyChanged();
+    return true;
+  }
+
+  // Materialize from disk asynchronously. The visible tabs stay put until the
+  // replacement is ready so the strip never empties (which would close the
+  // window).
+  load_in_flight_ = true;
+  pending_switch_ = id;
+  const int sequence = ++switch_sequence_;
+  service->LoadWorkspace(
+      id, base::BindOnce(&HeliumWorkspaceController::OnWorkspaceLoaded,
+                         weak_factory_.GetWeakPtr(), id, sequence));
+  return true;
+}
+
+std::string HeliumWorkspaceController::CreateWorkspace() {
+  if (!IsAvailable()) {
+    return std::string();
+  }
+  TabStripModel* tab_strip = GetTabStripModel();
+  HeliumWorkspaceService* service = GetService();
+  if (!tab_strip || !service || tab_strip->count() == 0) {
+    return std::string();
+  }
+  EnsureWorkspaces();
+  const std::string id = base::UnguessableToken::Create().ToString();
+  std::string name = "Workspace";
+  int suffix = static_cast<int>(service->ListWorkspaces().size()) + 1;
+  auto name_taken = [&](const std::string& candidate) {
+    for (const auto& info : service->ListWorkspaces()) {
+      if (info.name == candidate) {
+        return true;
+      }
+    }
+    return false;
+  };
+  while (name_taken(name)) {
+    name = "Workspace " + base::NumberToString(suffix++);
+  }
+  // Open the new workspace's first tab first so detaching never empties the
+  // strip (which would close the window). The new tab stays visible; the
+  // previous tabs (everything before it) are parked under the old workspace.
+  std::vector<tabs::TabInterface*> source_tabs;
+  for (int i = 0; i < tab_strip->count(); ++i) {
+    source_tabs.push_back(tab_strip->GetTabAtIndex(i));
+  }
+  const int old_active_index = tab_strip->active_index();
+  SaveActiveWorkspace();
+  chrome::NewTab(browser_, NewTabTypes::kNewTabCommand);
+  Snapshot parked = DetachVisibleTabs(source_tabs);
+  parked.active_index =
+      std::clamp(old_active_index, 0,
+                 std::max(0, parked.TabCount() - 1));
+  snapshots_[active_id_] = std::move(parked);
+  service->SaveWorkspace(id, name, {}, /*tab_count=*/1);
+  active_id_ = id;
+  service->SetActiveWorkspaceId(id);
+  NotifyChanged();
+  return id;
+}
+
+bool HeliumWorkspaceController::RenameWorkspace(const std::string& id,
+                                               const std::string& name) {
+  if (!IsAvailable() || id.empty()) {
+    return false;
+  }
+  HeliumWorkspaceService* service = GetService();
+  if (!service) {
+    return false;
+  }
+  const std::string trimmed(
+      base::TrimWhitespaceASCII(name, base::TRIM_ALL));
+  if (!IsValidWorkspaceName(trimmed)) {
+    return false;
+  }
+  if (!service->RenameWorkspace(id, trimmed)) {
+    return false;
+  }
+  NotifyChanged();
+  return true;
+}
+
+bool HeliumWorkspaceController::DeleteWorkspace(const std::string& id) {
+  if (!IsAvailable() || id.empty()) {
+    return false;
+  }
+  HeliumWorkspaceService* service = GetService();
+  TabStripModel* tab_strip = GetTabStripModel();
+  if (!service || !tab_strip) {
+    return false;
+  }
+  if (service->ListWorkspaces().size() <= 1) {
+    // Never strand the window without a workspace.
+    return false;
+  }
+  if (id == active_id_) {
+    // Switch away first so the deleted workspace's tabs are parked safely.
+    std::string fallback;
+    for (const auto& info : service->ListWorkspaces()) {
+      if (info.id != id) {
+        fallback = info.id;
+        break;
+      }
+    }
+    if (fallback.empty() || !SwitchToWorkspace(fallback)) {
+      return false;
+    }
+  }
+  snapshots_.erase(id);
+  pending_moves_.erase(id);
+  service->DeleteWorkspace(id);
+  NotifyChanged();
+  return true;
+}
+
+bool HeliumWorkspaceController::MoveTabsToWorkspace(const std::string& id,
+                                                   int index) {
+  if (!IsAvailable() || id.empty() || id == active_id_ || load_in_flight_) {
+    return false;
+  }
+  HeliumWorkspaceService* service = GetService();
+  TabStripModel* tab_strip = GetTabStripModel();
+  if (!service || !tab_strip || !service->HasWorkspace(id)) {
+    return false;
+  }
+  if (index < 0 || index >= tab_strip->count()) {
+    return false;
+  }
+  std::vector<int> indices;
+  if (tab_strip->IsTabSelected(index)) {
+    for (int selected : tab_strip->selection_model().GetListSelectionModel().selected_indices()) {
+      indices.push_back(selected);
+    }
+  } else {
+    indices.push_back(index);
+  }
+  std::optional<DetachedSelection> detached = DetachIndices(indices);
+  if (!detached || detached->tabs.empty()) {
+    return false;
+  }
+  auto snapshot_it = snapshots_.find(id);
+  if (snapshot_it == snapshots_.end()) {
+    // No in-memory state for the target: merge the moved tabs with the disk
+    // state when it loads instead of clobbering it.
+    PendingMove pending;
+    pending.visuals = std::move(detached->visuals);
+    pending.tabs = std::move(detached->tabs);
+    pending_moves_[id] = std::move(pending);
+    load_in_flight_ = true;
+    const int sequence = ++switch_sequence_;
+    service->LoadWorkspace(
+        id, base::BindOnce(&HeliumWorkspaceController::OnWorkspaceLoaded,
+                           weak_factory_.GetWeakPtr(), id, sequence));
+    NotifyChanged();
+    return true;
+  }
+  Snapshot& target = snapshot_it->second;
+  const int slot_offset = static_cast<int>(target.group_visuals.size());
+  for (const auto& visuals : detached->visuals) {
+    target.group_visuals.push_back(visuals);
+  }
+  for (auto& tab : detached->tabs) {
+    if (tab.group_slot.has_value()) {
+      tab.group_slot = tab.group_slot.value() + slot_offset;
+    }
+    target.flat_tabs.push_back(std::move(tab));
+  }
+  SaveSnapshot(id);
+  NotifyChanged();
+  return true;
+}
+
+std::string HeliumWorkspaceController::MoveTabsToNewWorkspace(int index) {
+  if (!IsAvailable() || load_in_flight_) {
+    return std::string();
+  }
+  HeliumWorkspaceService* service = GetService();
+  TabStripModel* tab_strip = GetTabStripModel();
+  if (!service || !tab_strip) {
+    return std::string();
+  }
+  if (index < 0 || index >= tab_strip->count()) {
+    return std::string();
+  }
+  std::vector<int> indices;
+  if (tab_strip->IsTabSelected(index)) {
+    for (int selected : tab_strip->selection_model().GetListSelectionModel().selected_indices()) {
+      indices.push_back(selected);
+    }
+  } else {
+    indices.push_back(index);
+  }
+  std::optional<DetachedSelection> detached = DetachIndices(indices);
+  if (!detached || detached->tabs.empty()) {
+    return std::string();
+  }
+  EnsureWorkspaces();
+  const std::string id = base::UnguessableToken::Create().ToString();
+  std::string name = "Workspace";
+  int suffix = static_cast<int>(service->ListWorkspaces().size()) + 1;
+  auto name_taken = [&](const std::string& candidate) {
+    for (const auto& info : service->ListWorkspaces()) {
+      if (info.name == candidate) {
+        return true;
+      }
+    }
+    return false;
+  };
+  while (name_taken(name)) {
+    name = "Workspace " + base::NumberToString(suffix++);
+  }
+  // Register the name first so SaveSnapshot finds it.
+  service->SaveWorkspace(id, name, {}, /*tab_count=*/0);
+  Snapshot& target = snapshots_[id];
+  target.group_visuals = std::move(detached->visuals);
+  target.flat_tabs = std::move(detached->tabs);
+  SaveSnapshot(id);
+  NotifyChanged();
+  return id;
+}
+
+std::optional<HeliumWorkspaceController::DetachedSelection>
+HeliumWorkspaceController::DetachIndices(std::vector<int> indices) {
+  TabStripModel* tab_strip = GetTabStripModel();
+  if (!tab_strip || indices.empty()) {
+    return std::nullopt;
+  }
+  indices.erase(
+      std::remove_if(indices.begin(), indices.end(),
+                     [&](int i) { return i < 0 || i >= tab_strip->count(); }),
+      indices.end());
+  if (indices.empty()) {
+    return std::nullopt;
+  }
+  // Never detach the strip's last tabs without a replacement: open a fresh
+  // tab first when the whole strip is moving (which would close the window).
+  if (static_cast<int>(indices.size()) >= tab_strip->count()) {
+    chrome::NewTab(browser_, NewTabTypes::kNewTabCommand);
+    indices.clear();
+    for (int i = 0; i < tab_strip->count() - 1; ++i) {
+      indices.push_back(i);
+    }
+  }
+  // Detach one tab at a time so ownership is a plain list of models. Tabs
+  // taken out of a group this way regroup when the target workspace is shown
+  // (whole moved groups keep their visuals; partial moves become ungrouped).
+  DetachedSelection out;
+  std::map<tab_groups::TabGroupId, int> slots;
+  std::sort(indices.begin(), indices.end(), std::greater<int>());
+  for (int tab_index : indices) {
+    const bool pinned = tab_strip->IsTabPinned(tab_index);
+    std::optional<int> slot;
+    if (std::optional<tab_groups::TabGroupId> group =
+            tab_strip->GetTabGroupForTab(tab_index);
+        group.has_value()) {
+      auto inserted = slots.try_emplace(group.value(), -1);
+      if (inserted.second) {
+        inserted.first->second =
+            static_cast<int>(out.visuals.size());
+        const TabGroup* live_group =
+            tab_strip->group_model()
+                ? tab_strip->group_model()->GetTabGroup(group.value())
+                : nullptr;
+        if (live_group && live_group->visual_data()) {
+          out.visuals.push_back(*live_group->visual_data());
+        } else {
+          out.visuals.emplace_back();
+        }
+      }
+      slot = inserted.first->second;
+    }
+    out.tabs.push_back(FlatTab{
+        tab_strip->DetachTabAtForInsertion(tab_index), pinned, slot});
+  }
+  std::reverse(out.tabs.begin(), out.tabs.end());
+  return out;
+}
