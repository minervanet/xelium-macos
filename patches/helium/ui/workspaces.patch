+int HeliumWorkspaceController::Snapshot::TabCount() const {
+  int count = static_cast<int>(flat_tabs.size());
+  for (const auto& item : live_items) {
+    if (std::holds_alternative<std::unique_ptr<DetachedTab>>(item)) {
+      count += 1;
+    } else {
+      count += CountDetachedCollection(
+          *std::get<std::unique_ptr<DetachedTabCollection>>(item));
+    }
+  }
+  return count;
+}
+
+bool HeliumWorkspaceController::IsAvailable() const {
+  if (!browser_ || !pref_service_) {
+    return false;
+  }
+  if (browser_->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL) {
+    return false;
+  }
+  Profile* profile = browser_->GetProfile();
+  if (!profile || profile->IsOffTheRecord() || profile->IsGuestSession()) {
+    return false;
+  }
+  if (!pref_service_->GetBoolean(prefs::kHeliumWorkspacesEnabled)) {
+    return false;
+  }
+  return IsWorkspaceOwner();
+}
+
+bool HeliumWorkspaceController::IsWorkspaceOwner() const {
+  if (!browser_) {
+    return false;
+  }
+  GlobalBrowserCollection* collection =
+      GlobalBrowserCollection::GetInstance();
+  if (!collection) {
+    return true;
+  }
+  Profile* profile = browser_->GetProfile();
+  bool is_owner = true;
+  collection->ForEach(
+      [&](BrowserWindowInterface* candidate) {
+        if (candidate == browser_) {
+          return false;
+        }
+        if (!candidate || candidate->GetProfile() != profile) {
+          return true;
+        }
+        if (candidate->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL) {
+          return true;
+        }
+        Profile* candidate_profile = candidate->GetProfile();
+        if (!candidate_profile || candidate_profile->IsOffTheRecord() ||
+            candidate_profile->IsGuestSession()) {
+          return true;
+        }
+        // An earlier normal window for this profile owns the workspaces.
+        is_owner = false;
+        return false;
+      },
+      BrowserCollection::Order::kCreation);
+  return is_owner;
+}
